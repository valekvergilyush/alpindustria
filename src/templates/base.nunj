{% from "./_head-scripts.nunj" import headScripts %}
{% from "../includes/components/popups/popups.nunj" import popups %}
{% from "../includes/components/modals/modals.nunj" import modals %}
{% from "../includes/components/button-up/button-up.nunj" import buttonUp %}

<!DOCTYPE html>
<html lang="{{ siteLang }}" class="page _loading{% if htmlClassMods %} {{ htmlClassMods }}{% endif %}">
	<head>
		<meta charset="utf-8" />
		<title>{% block title %}{{ siteName }}{% endblock %}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

		{{ headScripts() }}

		<link rel="preload" href="/assets/fonts/SuisseIntl-Book.woff2" as="font" type="font/woff2" crossorigin>

		{% block stylesheets %}
			<link rel="stylesheet" href="/assets/css/styles.css?hash" />
		{% endblock %}
	</head>
	<body class="page__body">

		<div class="page__wrapper wrapper">
			{% block content %}
			{% endblock %}

		</div>

		{{ popups({ list: popupsList }) }}
		{{ modals({ list: modalsList }) }}
		{% if not noButtonUp %}
			{{ buttonUp({ className: 'page__button-up' }) }}
		{% endif %}

		{% include "../includes/notification/notification.nunj" %}
		{% block scripts %}
			<script src="/assets/js/bundle.js?hash"></script>
		{% endblock %}
	</body>
</html>
