<div class="modal">
	<div class="modal__wrap">
		<div class="modal__header">
			<h2 class="modal__title">{% block modalTitle %}{% endblock modalTitle %}</h2>
			<button class="modal__close" type="button" aria-label="Закрыть">
				{% block modalContent %}
				{% endblock %}
			</button>
		</div>
	</div>
	<div class="modal__overlay"></div>
</div>
