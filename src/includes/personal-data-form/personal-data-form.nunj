{% from "../components/input/input.nunj" import input %}
{% from "../components/checkbox/checkbox.nunj" import checkbox %}
{% from "../components/button/button.nunj" import button %}

<form class="personal-data-form">
	{{ input({
		className: 'personal-data-form__input _gray',
		type: 'text',
		id: 'personal-data-country',
		value: 'Россия',
		name: 'Страна'
	}) }}
	{{ input({
		className: 'personal-data-form__input _gray',
		type: 'text',
		id: 'personal-data-city',
		value: 'Санкт-Петербург',
		inputAttr: 'required',
		name: 'Город*'
	}) }}
	{{ input({
		className: 'personal-data-form__input _gray',
		type: 'text',
		id: 'personal-data-street',
		name: 'улица'
	}) }}
	{{ input({
		className: 'personal-data-form__input _gray',
		type: 'number',
		id: 'personal-data-index',
		name: 'индекс'
	}) }}
	<div class="personal-data-form__inputs">
		{{ input({
			type: 'number',
			id: 'personal-data-house',
			name: 'дом'
		}) }}
		{{ input({
			type: 'number',
			id: 'personal-data-structure',
			name: 'строение'
		}) }}
		{{ input({
			type: 'number',
			id: 'personal-data-flat',
			name: 'квартира'
		}) }}
	</div>
	{{ checkbox({
		className: 'personal-data-form__checkbox',
		id: 'personal-data-main-address',
		name: 'main-address',
		text: 'Сделать основным адресом'
	}) }}
	<div class="personal-data-form__btns">
		{{ button({
			type: 'button',
			text: 'удалить',
			className: 'personal-data-form__btn _del h7 ttu',
			attr: 'data-data-form-close="address"'
		}) }}
		{{ button({
			type: 'submit',
			text: 'Добавить',
			icon: 'promo-arrow',
			iconData: 'width="18" height="18" viewBox="0 0 72 72"',
			className: 'personal-data-form__btn _add h7 ttu _arrow-s'
		}) }}
	</div>
</form>
