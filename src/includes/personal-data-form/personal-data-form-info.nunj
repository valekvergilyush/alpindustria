{% from "../components/input/input.nunj" import input %}
{% from "../components/checkbox/checkbox.nunj" import checkbox %}
{% from "../components/button/button.nunj" import button %}
{% from "../components/input-date/input-date.nunj" import inputDate %}

<form class="personal-data-form">
	{{ input({
		type: 'tel',
		id: 'personal-data-phone',
		value: '+7 (999) 000 00 00',
		name: 'Телефон',
		className: '_gray',
		attr: 'data-validate-type="phone"'
	}) }}
	{{ input({
		type: 'email',
		id: 'personal-data-email',
		value: 'hello.aplindustria@gmail.com',
		name: 'Почта',
		className: '_gray'
	}) }}
	{{ input({
		type: 'text',
		id: 'personal-data-name',
		name: 'Полное имя',
		value: 'Иван Федорович Крузенштерн',
		className: '_gray'
	}) }}
	{{ inputDate({
		name: 'Дата',
		label: 'Дата рождения',
		id: 'personal-data-birthday',
		value: '19/10/22',
		className: '_gray',
		inputAttr: 'readonly data-datepicker'
	}) }}
	<div class="personal-data-form__btns">
		{{ button({
			type: 'button',
			text: 'удалить',
			className: 'personal-data-form__btn _del h7 ttu',
			attr: 'data-data-form-close="info"'
		}) }}
		{{ button({
			type: 'submit',
			text: 'Добавить',
			icon: 'promo-arrow',
			iconData: 'width="18" height="18" viewBox="0 0 72 72"',
			className: 'personal-data-form__btn _add h7 ttu _arrow-s',
			attr: 'data-data-form-close="info"'
		}) }}
	</div>
</form>
