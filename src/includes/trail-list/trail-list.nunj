		text: 'Регистрация открыта',
		linkText: 'VK',
		linkURL: '#',
		img: '/assets/images/community/trails/trail-2'
	},
	{
		title: 'Spas-Kamenka Alpindustria Trail&nbsp;2022',
		dates: '29.09.2022 – 05.10.2022',
		text: 'Регистрация открыта',
		linkText: 'VK',
		linkURL: '#',
		img: '/assets/images/community/trails/trail-3'
	},
	{
