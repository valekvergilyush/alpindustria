<section class="trail-list">
	<h2 class="trail-list__title h4 ttu c-green-dark container">Наши трейлы</h2>
	<ul class="trail-list__list">
		{% for trail in trailsList %}
			<li class="trail-list__item">
				{{ trailCard(trail) }}
			</li>
		{% endfor %}
	</ul>
</section>
