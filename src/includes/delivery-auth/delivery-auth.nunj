{% from "../components/input/input.nunj" import input %}
{% from "../components/button/button.nunj" import button %}
{% from "../components/checkbox/checkbox.nunj" import checkbox %}

{% set authLinks = [
	{ text: 'VK', href: '#', className: ' _vk ttu p1' },
	{ text: 'Yandex', href: '#', className: ' _yandex ttu p1' },
	{ text: 'Google', href: '#', className: ' _google ttu p1' }
] %}

<form class="delivery-auth" data-form-stage="default">
	{# <div class="delivery-auth__user-block">
		<table class="delivery-auth__user-info p3">
			<tr>
				<td>ФИО</td>
				<td class="c-gray-dark">Константин Константинопольский</td>
			</tr>
			<tr>
				<td>Почта</td>
				<td class="c-gray-dark">konstantin@gmail.com</td>
			</tr>
			<tr>
				<td>Телефон</td>
				<td class="c-gray-dark">+7 (902) 222 01 02</td>
			</tr>
		</table>
		<div class="delivery-auth__user-controls">
			{{ button({
				text: 'Изменить свои данные',
				icon: 'pencil',
				iconData: 'width="24" height="24"',
				className: 'delivery-auth__user-edit p3',
				href: '/profile.html'
			}) }}
			{{ button({
				text: 'Авторизоваться под другим именем',
				icon: 'promo-arrow-filled',
				iconData: 'width="16" height="16"',
				className: 'delivery-auth__user-change p3'
			}) }}
		</div>
		{{ checkbox({
			className: 'delivery-auth__checkbox',
			id: 'auth-legal-entity-checkbox',
			name: 'legal-entity',
			text: 'Я являюсь юридическим лицом',
			inputAttr: 'data-legal-checkbox'
		}) }}
	</div> #}
	<div class="delivery-auth__form">
		<div class="delivery-auth__fields _tel">
			{{ input({
				type: 'tel',
				id: 'delivery-auth-tel',
				className: 'delivery-auth__input _tel _gray',
				name: 'Телефон',
				attr: 'required data-validate-type="phone"'
			}) }}
			{{ button({
				type: 'submit',
				text: 'Авторизоваться',
				icon: 'promo-arrow',
				iconData: 'width="16" height="16"',
				className: 'delivery-auth__submit-btn _arrow-s _auth ttu p2 _tel',
				attr: 'data-submit-auth'
			}) }}
		</div>
		<div class="delivery-auth__fields _sms">
			{{ input({
				type: 'text',
				id: 'delivery-auth-sms',
				className: 'delivery-auth__input _sms _gray',
				name: 'Код из СМС',
				inputAttr: 'autocomplete="off"'
			}) }}
			{{ button({
				type: 'submit',
				text: 'Подтвердить',
				icon: 'promo-arrow',
				iconData: 'width="16" height="16"',
				className: 'delivery-auth__check-code _arrow-s _auth ttu p2',
				attr: 'aria-label="Подтвердить" data-submit-sms-auth'
			}) }}
			{{ button({
				type: 'button',
				text: 'Выслать код повторно',
				icon: 'promo-arrow-filled',
				iconData: 'width="8" height="8"',
				className: 'delivery-auth__send-repeat'
			}) }}
		</div>
		<div class="delivery-auth__fields _socials">
			{% for authLink in authLinks %}
				<a class="delivery-auth__link{{ authLink.className }}" href="{{ authLink.href }}">{{ authLink.text }}</a>
			{% endfor %}
			<button class="delivery-auth__change-auth" type="button" data-delivery-auth-change>
				<span>Войти через почту</span>
				{{ icon({
					iconName: 'promo-arrow-filled',
					className: 'delivery-auth__change-auth-icon',
					attr: 'width="16" height="16"'
				}) }}
			</button>
		</div>
	</div>
	<div class="delivery-auth__form _email">
		<div class="delivery-auth__fields _tel">
			{{ input({
				type: 'email',
				id: 'delivery-auth-email',
				className: 'delivery-auth__input _email _gray',
				name: 'Почта',
				attr: 'required data-validate-type="email"'
			}) }}
			{{ button({
				type: 'submit',
				text: 'Авторизоваться',
				icon: 'promo-arrow',
				iconData: 'width="16" height="16"',
				className: 'delivery-auth__submit-btn _arrow-s _auth ttu p2 _email',
				attr: 'data-submit-auth'
			}) }}
		</div>
		<div class="delivery-auth__fields _socials">
			{% for authLink in authLinks %}
				<a class="delivery-auth__link{{ authLink.className }}" href="{{ authLink.href }}">{{ authLink.text }}</a>
			{% endfor %}
			<button class="delivery-auth__change-auth" type="button" data-delivery-auth-change>
				<span>Войти по номеру</span>
				{{ icon({
					iconName: 'promo-arrow-filled',
					className: 'delivery-auth__change-auth-icon',
					attr: 'width="16" height="16"'
				}) }}
			</button>
		</div>
	</div>
</form>
