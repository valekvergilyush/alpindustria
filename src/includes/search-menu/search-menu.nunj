<div class="page__search-menu search-menu _no-results" data-search-menu>
	<form class="search-menu__form">
		<input
			class="search-menu__input"
			type="text"
			name="Поиск"
			placeholder="Поиск по магазину"
			aria-label="Поиск"
			autocomplete="off"
			data-search-menu-input
		>
		{{ button({
			type: 'submit',
			className: 'search-menu__submit-btn',
			text: '0 товаров',
			icon: 'arrow-right',
			iconData: 'width="24" height="24"',
			attr: 'data-search-menu-submit'
		}) }}
	</form>
	<div class="search-menu__tabs">
		{{ radioButton({
			id: 'search-menu-shop-radio',
			className: 'search-menu__radio',
			name: 'search-menu-tab',
			value: 'shop',
			text: 'Магазин',
			checked: true,
			attr: 'data-search-menu-tab data-search-input-placeholder="Поиск по магазину"'
		}) }}
		{{ radioButton({
			id: 'search-menu-community-radio',
			className: 'search-menu__radio',
			name: 'search-menu-tab',
			value: 'community',
			text: 'Сообщество',
			attr: 'data-search-menu-tab data-search-input-placeholder="Поиск по сообществу"'
		}) }}
		{{ radioButton({
			id: 'search-menu-news-radio',
			className: 'search-menu__radio',
			name: 'search-menu-tab',
			value: 'news',
			text: 'Новости',
			attr: 'data-search-menu-tab data-search-input-placeholder="Поиск по новостям"'
		}) }}
		{{ radioButton({
			id: 'search-menu-brands-radio',
			className: 'search-menu__radio',
			name: 'search-menu-tab',
			value: 'brands',
			text: 'Бренды',
			attr: 'data-search-menu-tab data-search-input-placeholder="Поиск по брендам"'
		}) }}
		{{ radioButton({
			id: 'search-menu-rent-radio',
			className: 'search-menu__radio',
			name: 'search-menu-tab',
			value: 'rent',
			text: 'Прокат',
			attr: 'data-search-menu-tab data-search-input-placeholder="Поиск по прокату"'
		}) }}
	</div>
	<div class="search-menu__results">
		<div class="search-menu__results-col _left">
			<div class="search-menu__list-wrapper _results">
				<ul class="search-menu__list _shop p2">
					<li><a class="search-menu__results-link" href="/catalog/product-page.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/catalog/product-page.html">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
					<li><a class="search-menu__results-link" href="/catalog/product-page.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/catalog/product-page.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/catalog/product-page.html">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
				</ul>
				<ul class="search-menu__list _community p2">
					<li><a class="search-menu__results-link" href="/community/class.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/community/class.html">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
					<li><a class="search-menu__results-link" href="/community/class.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/community/class.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/community/class.html">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
				</ul>
				<ul class="search-menu__list _news p2">
					<li><a class="search-menu__results-link" href="/news-article.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/news-article.html">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
					<li><a class="search-menu__results-link" href="/news-article.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/news-article.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/news-article.html">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
				</ul>
				<ul class="search-menu__list _brands p2">
					<li><a class="search-menu__results-link" href="/brand.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/brand.html">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
					<li><a class="search-menu__results-link" href="/brand.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/brand.html">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" href="/brand.html">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
				</ul>
				<ul class="search-menu__list _rent p2">
					<li><a class="search-menu__results-link" data-popup-opener="wishlist-services">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" data-popup-opener="wishlist-services">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
					<li><a class="search-menu__results-link" data-popup-opener="wishlist-services">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" data-popup-opener="wishlist-services">Куртка The North Face</a></li>
					<li><a class="search-menu__results-link" data-popup-opener="wishlist-services">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
				</ul>
				{{ button({
					className: 'search-menu__show-more-btn _show-more _no-bd',
					text: 'Показать еще',
					icon: 'plus-circle',
					iconData: 'width="32" height="32"'
				}) }}
			</div>
			<div class="search-menu__history c-gray-dark">
				<p class="search-menu__history-title h7 ttu">История поиска</p>
				<ul class="search-menu__list _history p2">
					<li><a href="#" class="search-menu__history-link">Куртка The North Face</a></li>
					<li><a href="#" class="search-menu__history-link">Куртка The North Face M Dryzzle All Weather Jkt</a></li>
				</ul>
				{{ button({
					className: 'search-menu__clear-history-btn',
					text: 'Очистить историю',
					icon: 'close-search',
					iconData: 'width="32" height="32"'
				}) }}
			</div>
		</div>
		<div class="search-menu__results-col _right">
			<ul class="search-menu__results-list _shop">
				{% for product in productList %}
					<li class="search-menu__results-item">{{ productCard(product) }}</li>
				{% endfor %}
			</ul>
			<ul class="search-menu__results-list _community">
				{% for item in classesList %}
					<li class="search-menu__results-item">
						{{ classItem(item) }}
					</li>
				{% endfor %}
			</ul>
			{{ newsList({
				list: newsListData,
				className: 'search-menu__results-list _news _search'
			}) }}
			<ul class="search-menu__results-list _brands">
				{% for item in brandList %}
					<li class="search-menu__results-item">
						<a class="search-menu__brand-link" href="/brand.html">
							<img class="search-menu__brand-img" src="{{ item.src }}"{% if item.srcset %} srcset="{{ item.srcset }}"{% endif %} width="200" alt="{{ item.name }}">
						</a>
					</li>
				{% endfor %}
			</ul>
			<ul class="search-menu__results-list _rent">
				{% for product in rentList %}
					<li class="search-menu__results-item">{{ productCard(product) }}</li>
				{% endfor %}
			</ul>
		</div>
	</div>
</div>
