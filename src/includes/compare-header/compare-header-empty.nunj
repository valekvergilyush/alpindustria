{% from "../components/button/button.nunj" import button %}
{% from "../components/icon/icon.nunj" import icon %}

{% set productList = [
	{ url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', price: '33&nbsp;150&nbsp;₽', photo: '/assets/images/catalog/item-1' },
	{ url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', price: '33&nbsp;150&nbsp;₽', photo: '/assets/images/catalog/item-2', inWishlist: true },
	{ url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', price: '33&nbsp;150&nbsp;₽', photo: '/assets/images/catalog/item-3', new: true, featureImg: '/assets/images/catalog/product-feature', featureImgAlt: 'Core-Tex products Guaranteed to keep you dry' }
] %}

<div class="compare-header _empty" data-compare-header>
	<div class="compare-header__container container">
		<p class="compare-header__qty p2">0&nbsp;товаров</p>

		<div class="compare-header__products-wrapper">
			<ul class="compare-header__products">
				{% for item in productList %}
					<li class="compare-header__product _new">
						<a class="compare-header__add" href="/catalog">
							{{ icon({
								iconName: 'plus',
								className: 'compare-header__add-icon',
								attr: 'width="36" height="36"'
							}) }}
							<span class="compare-header__add-text">Добавить товар</span>
						</a>
					</li>
				{% endfor %}
			</ul>
		</div>
		<div class="compare-header__nav">
			{{ button({
				className: 'compare__nav-button _prev',
				icon: 'arrow-left',
				iconData: 'width="16" height="16"',
				attr: 'disabled'
			})}}
			{{ button({
				className: 'compare__nav-button _next',
				icon: 'arrow-right',
				iconData: 'width="16" height="16"'
			})}}
		</div>
	</div>
</div>
