{% set years = ['1988', '1989', 1990, '1992', '1994', '2000', '2002'] %}

<div class="page__timeline timeline" data-timeline>
	<div class="timeline__container container">
			<div class="timeline__progress" style="width: 0%" data-timeline-progress></div>
			<ul class="timeline__list p3">
				{% for year in years %}
					<li class="timeline__item">
							<a class="timeline__link" href="#year-{{ year }}" data-timeline-link>{{ year }}</a>
					</li>
				{% endfor %}
			</ul>
	</div>
</div>
