{% from "../components/icon/icon.nunj" import icon %}

{% set links = [
	{
		text: 'Прокат',
		url: '#',
		tags: ['Снаряжение', 'Сноуборды', 'Лыжи', 'Одежда'],
		className: '_violet'
	},
	{
		text: 'Сервисы',
		url: '#',
		tags: ['Бутфитинг', 'Ски-сервисы', 'Ремонт', 'Заправка балонов'],
		className: '_green'
	}
] %}

<ul class="services-index" data-services>
	{% for link in links %}
		<li class="services-index__item{% if link.className %} {{ link.className }}{% endif %}" data-services-item>
			<a class="services-index__link h2 ttu" href="{{ link.url }}">
				<span class="services-index__link-text">{{ link.text }}</span>
				{{ icon({
					iconName: 'promo-arrow-filled',
					className: 'services-index__link-icon',
					attr: 'width="64" height="64"'
				}) }}
			</a>
			{% if link.tags %}
				<ul class="services-index__tags">
					{% for tag in link.tags %}
						<li class="services-index__tags-item button _quick-filter">{{ tag }}</li>
					{% endfor %}
				</ul>
			{% endif %}
		</li>
	{% endfor %}
</ul>
