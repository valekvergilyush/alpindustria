<div class="cart__delivery-content cart-delivery">
	{% include "../delivery-auth/delivery-auth.nunj" %}
	{% include "../delivery-register/delivery-register.nunj" %}
	{% include "../delivery-address/delivery-address.nunj" %}
	<button class="popups__close-button" type="button" data-popup-closer>
		{{ icon({
			iconName: "close-popup",
			className: "popups__close-icon",
			attr: 'width="32" height="32" viewBox="0 0 32 32"'
		}) }}
	</button>
</div>
