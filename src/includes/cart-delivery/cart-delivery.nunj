<div class="cart__delivery-content cart-delivery _shop">
	<div class="cart__block _profile" data-auth-block id="cart-contacts">
		<div class="cart__title-wrap">
			<p class="cart__block-title ttu h6">01. контактные данные</p>
			<button class="cart__title-btn p3 _edit" type="button" data-auth-btn>
				<span>У меня есть аккаунт</span>
				{{ icon({
					iconName: 'user',
					className: 'cart__title-btn-icon',
					attr: 'width="24" height="24" viewBox="0 0 32 33"'
				}) }}
			</button>
			<button class="cart__title-btn _auth" type="button" data-edit-profile-data>
				<span>У меня нет аккаунта</span>
				{{ icon({
					iconName: 'user',
					className: 'cart__title-btn-icon',
					attr: 'width="24" height="24" viewBox="0 0 32 33"'
				}) }}
			</button>
		</div>
		{% include "../order-auth-data/order-auth-data.nunj" %}
		<div data-validate>{% include "../delivery-auth/delivery-auth.nunj" %}</div>
		<div data-validate>{% include "../delivery-register/delivery-register.nunj" %}</div>
	</div>
	{% include "../delivery-address/delivery-address.nunj" %}
	{% include "../cart-discount/cart-discount.nunj" %}
	{% include "../order-information/order-information.nunj" %}
	<button class="popups__close-button _order" type="button" data-popup-closer>
		{{ icon({
			iconName: "close-popup",
			className: "popups__close-icon",
			attr: 'width="32" height="32" viewBox="0 0 32 32"'
		}) }}
	</button>
</div>
