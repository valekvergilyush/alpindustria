{% from "../components/cart-item/cart-item.nunj" import cartItem %}

{% set cartList = [
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽'
	},
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽'
	},
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽'
	}
] %}

<div class="cart__list cart-list">
	<p class="cart-list__number">
		Всего:<br>
		<span class="cart-list__number-value">3 товара</span>
	</p>
	<ul class="cart-list__list">
		{% for item in cartList %}
			<li class="cart-list__item">{{ cartItem(item) }}</li>
		{% endfor %}
	</ul>
</div>
