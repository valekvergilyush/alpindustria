{% from "../components/select/select.nunj" import select %}
{% from "../components/input/input.nunj" import input %}
{% from "../components/radio/radio.nunj" import radio %}
{% from "../components/input-date/input-date.nunj" import inputDate %}
{% from "../components/input-time/input-time.nunj" import inputTime %}
{% from "../components/icon/icon.nunj" import icon %}

{% set addressTabs = [
	{ id: 'delivery', name: 'Доставка', isSelected: true, tabindex: '0' },
	{ id: 'shops', name: 'Магазины', tabindex: '-1' }
]
%}

{# {% set cityList = [
	{ name: 'Москва', value: 'Москва' },
	{ name: 'Санкт-Петербург', value: 'Санкт-Петербург' },
	{ name: 'Новосибирск', value: 'Новосибирск' },
	{ name: 'Екатеринбург', value: 'Екатеринбург' }
] %}
{% set shopList = [
	{ name: 'г. Санкт-Петербург, наб. Черной речки, д. 6 (ст.м. Черная Речка)', value: 'г. Санкт-Петербург, наб. Черной речки, д. 6 (ст.м. Черная Речка)' }
] %} #}

<div class="cart__block cart__delivery-address delivery-address tabs" data-tabs id="cart-delivery">
	<div class="cart__title-wrap">
		<p class="cart__block-title ttu h6">02. Информация о доставке</p>
	</div>
	<ul class="tabs__tab-list delivery-address__tabs-list" role="tablist">
		{% for item in addressTabs %}
			<li class="tabs__tab-item">
				<button class="tabs__trigger{% if item.isSelected %} _selected{% endif %}" id="{{ item.id }}" role="tab" type="button" data-tab-trigger aria-selected="true" tabindex="{{ item.tabindex }}">
					{{ item.name }}
				</button>
			</li>
		{% endfor %}
	</ul>
	<section class="delivery-address__section _courier tabs__panel" aria-labelledby="delivery" role="tabpanel" data-tab-panel aria-hidden="false" tabindex="0">
		{# {{ select({
			id: 'city-select-courier',
			options: cityList,
			className: 'delivery-address__select _delivery',
			label: 'Город',
			search: true
		}) }} #}
		<button class="delivery-address__change-city s2" type="button" data-popup-opener="city-form" data-popup-opener>
			<span>г. Санкт-Петербург</span>
			{{ icon({
				iconName: 'pencil',
				className: 'delivery-address__change-city-icon',
				attr: 'width="24" height="24"'
			}) }}
		</button>
		<p class="delivery-address__text ttu">Выберите способ доставки:</p>
		<div class="delivery-address__radios">
			{{ radio({
				id: 'delivery-address-radio-1',
				className: 'delivery-address__radio _v-center',
				name: 'delivery-address-radio',
				value: 'courier',
				attr: 'data-value="courier"',
				label: 'Курьерская',
				text: 'Завтра и позже, бесплатная доставка от 10 000 ₽',
				checked: true
			}) }}
			{{ radio({
				id: 'delivery-address-radio-2',
				className: 'delivery-address__radio _v-center',
				name: 'delivery-address-radio',
				value: 'sdek',
				attr: 'data-value="sdek"',
				label: 'Доставка по пунктам выдачи СДЭК',
				text: '3-5 дней, бесплатная доставка от 10 000 ₽'
			}) }}
		</div>
		<div class="delivery-address__date-time">
			<div class="delivery-address__change-address-wrap">
				<button class="delivery-address__edit-address" type="button" data-edit-address>
					<span>Редактировать адрес</span>
					{{ icon({
						iconName: 'pencil',
						className: 'delivery-address__edit-address-icon',
						attr: 'width="24" height="24"'
					}) }}
				</button>
				<div class="delivery-address__change-address">
					<p class="delivery-address__change-address-text">Россия, Санкт-Петербург, Шпалерная 51 к1,  4 парадная, 32кв<br>
					644505</p>
					<button class="delivery-address__change-address-btn ttu" data-popup-opener="delivery-addresses">
						<span>выбрать другой адрес</span>
						{{ icon({
							iconName: 'pencil',
							className: 'delivery-address__change-city-icon',
							attr: 'width="24" height="24"'
						}) }}
					</button>
				</div>
			</div>
			<div class="delivery-address__address-inputs">
				{{ input({
					type: 'text',
					id: 'delivery-address-street',
					className: 'delivery-address__input _gray',
					name: 'Улица',
					label: 'Улица*',
					inputAttr: 'required',
					attr: 'data-validate-type="text"'
				}) }}
				<div class="delivery-address__fields _cols-4">
					{{ input({
						type: 'text',
						id: 'delivery-address-house',
						className: 'delivery-address__input _gray',
						name: 'Дом',
						label: 'Дом*',
						inputAttr: 'required',
						attr: 'data-validate-type="text"'
					}) }}
					{{ input({
						type: 'text',
						id: 'delivery-address-housing',
						className: 'delivery-address__input _gray',
						name: 'Корпус'
					}) }}
					{{ input({
						type: 'text',
						id: 'delivery-address-apartment',
						className: 'delivery-address__input _gray',
						name: 'Квартира'
					}) }}
					{{ input({
						type: 'text',
						id: 'delivery-address-index',
						className: 'delivery-address__input _gray',
						name: 'Индекс'
					}) }}
				</div>
			</div>
			<p class="delivery-address__title h7 ttu">Выберите время, когда вы хотите получить заказ:</p>
			<div class="delivery-address__fields _datetime">
				{{ inputDate({
					name: 'Дата',
					label: 'Дата',
					id: 'delivery-date-input',
					className: 'delivery-address__date',
					inputAttr: 'data-min-date="today"'
				}) }}
				{{ inputTime({
					name: 'Время',
					label: 'Время',
					id: 'delivery-time-input',
					value: '19:00',
					className: 'delivery-address__time'
				}) }}
			</div>
		</div>
		<div class="delivery-address__delivery-wrapper _sdek">
			<button class="delivery-address__pick-up-button ttu" type="button" data-popup-opener="cdek-addresses">
				<span>Выбрать пункт</span>
				{{ icon({
					iconName: 'pencil',
					className: 'delivery-address__pick-up-icon',
					attr: 'width="24" height="24"'
				}) }}
			</button>
			<div class="delivery-address__change-address _cdek">
				<p class="delivery-address__change-address-text">Россия, Санкт-Петербург, Шпалерная 51 к1,  4 парадная, 32кв<br>
				644505</p>
				<button class="delivery-address__change-address-btn ttu"  data-popup-opener="cdek-addresses">
					<span>изменить адрес</span>
					{{ icon({
						iconName: 'pencil',
						className: 'delivery-address__change-city-icon',
						attr: 'width="24" height="24"'
					}) }}
				</button>
			</div>
			{% include "../delivery-data/delivery-data-2.nunj" %}
		</div>
		<p class="delivery-address__price">
			Стоимость доставки:<br>
			<span class="delivery-address__price-value">Бесплатно</span>
		</p>
	</section>
	<section class="delivery-address__section tabs__panel" aria-labelledby="shops" role="tabpanel" data-tab-panel aria-hidden="false" tabindex="-1">
		<button class="delivery-address__change-city s2" type="button" data-popup-opener="city-form" data-popup-opener>
			<span>г. Санкт-Петербург</span>
			{{ icon({
				iconName: 'pencil',
				className: 'delivery-address__change-city-icon',
				attr: 'width="24" height="24"'
			}) }}
		</button>
		<p class="delivery-address__text ttu">выберите магазин:</p>
		<div class="delivery-address__radios">
			{{ radio({
				id: 'delivery-address-shop-radio-1',
				className: 'delivery-address__radio _v-center',
				name: 'delivery-address-shop-radio',
				value: 'shop-1',
				attr: 'data-value="shop-1"',
				label: 'Заневский',
				text: 'Заневский пр-т, 30, м.Новочеркасская',
				checked: true
			}) }}
			{{ radio({
				id: 'delivery-address-shop-radio-2',
				className: 'delivery-address__radio _v-center',
				name: 'delivery-address-shop-radio',
				value: 'shop-2',
				attr: 'data-value="shop-2"',
				label: 'Черная речка',
				text: 'наб. Черной речки, 6'
			}) }}
		</div>
		{% include "../delivery-data/delivery-data.nunj" %}
		<p class="delivery-address__price">
			Стоимость доставки:<br>
			<span class="delivery-address__price-value">Бесплатно</span>
		</p>
		{# <div class="delivery-address__map-wrapper">
			<div class="delivery-address__map map" data-map="cart"></div>
		</div>
		{% include "../store-info/store-info.nunj" %} #}
	</section>
</div>
