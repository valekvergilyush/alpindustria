{% from "../components/button/button.nunj" import button %}

{% set categories = [
	'Одежда',
	'Лыжный туризм',
	'Туристическое снаряжение',
	'Книги',
	'Обувь',
	'Альпинистское снаряжение',
	'Сноуборды',
	'Горные лыжи'
] %}

<ul class="hero__quick-filter quick-filter">
	{% for caterogyName in categories %}
		<li class="quick-filter__item">
			{{ button({
				className: 'quick-filter__button _quick-filter',
				text: caterogyName,
				icon: 'close-button',
				iconData: 'width="24" height="24"'
			}) }}
		</li>
	{% endfor %}
</ul>
