{% from "../components/button/button.nunj" import button %}

{#
  Params:
  - rootMods: string (optional, space-separated modifier classes)
  - seasons: array|null (optional)
  - locations: array (required)
#}

{% set rootClass = "quick-filter-main" + (" " + rootMods if rootMods else "") %}

<div class="{{ rootClass }}" data-quick-filter>
	{% if seasons and seasons.length %}
		<ul class="quick-filter-main__seasons">
			{% for season in seasons %}
				<li class="quick-filter-main__season-item">
					{{ button({
						className: 'button _quick-filter' + (' _active' if season.active else ''),
						text: season.name,
						attr: 'data-season="' + season.value + '"'
					}) }}
				</li>
			{% endfor %}
		</ul>
	{% endif %}
	<div class="quick-filter-main__locations-wrapper _grab" data-drag-scroll data-catalog-menu>
	<ul class="quick-filter-main__locations" data-catalog-opened>
		{% for location in locations %}
			<li class="quick-filter-main__location-item">
				{{ button({
					className: 'button _quick-filter' + (' _white-bg' if location.white else '') + (' _active' if location.active else ''),
					text: location.name,
					attr: 'data-location="' + location.value + '"'
				}) }}
			</li>
		{% endfor %}
	</ul>
	</div>
</div>
