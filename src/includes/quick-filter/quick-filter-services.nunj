{% from "../components/button/button.nunj" import button %}

{% set subcategories2 = [
	{
		name: 'Тест-центр часов',
		categoryName: 'Тест-центр часов'
	},
	{
		name: 'Прокат снаряжения',
		categoryName: 'Прокат снаряжения'
	},
	{
		name: 'Снаряжение',
		modifier: 'inner',
		subcategories: [
			{
				name: 'все снаряжение',
				categoryName: 'снаряжение'
			},
			{
				name: 'Лавинное',
				categoryName: 'Лавинное снаряжение'
			},
			{
				name: 'Ледовое',
				categoryName: 'Ледовое снаряжение'
			},
			{
				name: 'Одежда',
				categoryName: 'Одежда'
			},
			{
				name: 'Обувь',
				categoryName: 'Обувь'
			}
		]
	}
] %}

{% set subcategories = [
		{ name: 'На Первомайской',
			modifier: 'outdoor',
			subcategories: subcategories2
		},
		{ name: 'Авиапарк',
			modifier: 'outdoor',
			subcategories: subcategories2
		},
		{ name: 'Спортхит',
			modifier: 'outdoor',
			subcategories: subcategories2
		},
		{ name: 'Экстрим',
			modifier: 'outdoor',
			subcategories: subcategories2
		},
		{ name: 'Фирменный магазин The North Face',
			modifier: 'outdoor',
			subcategories: subcategories2
		}
	]
%}

{% set categories = [
	{ name: 'Санкт-петербург',
		modifier: 'inner',
		cityAttr: 'saint-petersburg',
		subcategories: subcategories,
		active: true
	},
	{ name: 'Москва',
		cityAttr: 'moscow',
		modifier: 'inner',
		subcategories: subcategories
	},
	{ name: 'Новосибирск',
		cityAttr: 'novosibirsk',
		modifier: 'inner',
		subcategories: subcategories
	}
] %}

<ul class="hero-catalog__quick-filter quick-filter _opened" data-quick-filter data-subcategory-rent>
	{% for category1 in categories %}
		{% if category1.subcategories %}
			{% set mod = ' data-subcategory-mod="_' + category1.modifier + '"' %}
		{% else %}
			{% set mod = '' %}
		{% endif %}
		<li class="quick-filter__item {% if category1.active %}_opened{% endif %}"{% if category1.subcategories %}data-drag-scroll data-subcategory-item{% endif %}>
			{{ button({
				className: 'quick-filter__button _quick-filter',
				text: category1.name,
				attr: 'data-subcategory-opener' + mod + ' data-wishlist-city-btn ="' + category1.cityAttr + '"'
			}) }}
			{% if category1.subcategories %}
				<div class="quick-filter__subcategories-wrapper">
					{{ button({
						className: 'quick-filter__button _back',
						attr: 'aria-label="Назад" data-subcategory-back data-wishlist-city-back',
						icon: 'arrow-left',
						iconData: 'width="24" height="24"'
					}) }}
					<ul class="quick-filter__subcategories" data-subcategory-rent>
						{% for category2 in category1.subcategories %}
							<li class="quick-filter__item" data-subcategory-item>
								{{ button({
									className: 'quick-filter__button _quick-filter _button',
									text: category2.name,
									attr: 'data-subcategory-opener'
								}) }}
								{% if category2.subcategories %}
									<div class="quick-filter__subcategories-wrapper">
										{{ button({
											className: 'quick-filter__button _back',
											attr: 'aria-label="Назад" data-subcategory-back',
											icon: 'arrow-left',
											iconData: 'width="24" height="24"'
										}) }}
										<ul class="quick-filter__subcategories" data-subcategory-rent>
											{% for category3 in category2.subcategories %}
												<li class="quick-filter__item" data-subcategory-item>
													{% set btnAttr = '' %}
													{% if category3.subcategories %}
														{% set btnAttr = 'data-subcategory-opener' %}
													{% endif %}
													{% if category3.categoryName %}
														{% set categoryNameAttr = ' data-category-rent="' + category3.categoryName + '"' %}
													{% else %}
														{% set categoryNameAttr = '' %}
													{% endif %}
													{% if category3.active %}
														{% set mod3 = '_active' %}
													{% else %}
														{% set mod3 = '' %}
													{% endif %}
													{{ button({
														className: 'quick-filter__button _quick-filter _button ' + mod3,
														text: category3.name,
														attr: btnAttr + ' ' + categoryNameAttr
													}) }}
													{% if category3.subcategories %}
														<div class="quick-filter__subcategories-wrapper">
															{{ button({
																className: 'quick-filter__button _back',
																attr: 'aria-label="Назад" data-subcategory-back',
																icon: 'arrow-left',
																iconData: 'width="24" height="24"'
															}) }}
															<ul class="quick-filter__subcategories">
																{% for category4 in category3.subcategories %}
																	{% if category4.categoryName %}
																		{% set categoryNameAttr = ' data-category-rent="' + category4.categoryName + '"' %}
																	{% else %}
																		{% set categoryNameAttr = '' %}
																	{% endif %}
																	<li>
																		{% if category4.active %}
																			{% set mod4 = '_active' %}
																		{% else %}
																			{% set mod4 = '' %}
																		{% endif %}
																		{{ button({
																			className: 'quick-filter__button _quick-filter _button' + mod4,
																			text: category4.name,
																			attr: categoryNameAttr
																		}) }}
																	</li>
																{% endfor %}
															</ul>
														</div>
													{% endif %}
												</li>
											{% endfor %}
										</ul>
									</div>
								{% endif %}
							</li>
						{% endfor %}
					</ul>
				</div>
			{% endif %}
		</li>
	{% endfor %}
</ul>
