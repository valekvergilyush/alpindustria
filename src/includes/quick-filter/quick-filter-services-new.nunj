{% from "../components/button/button.nunj" import button %}


{% set locations = [
	{ name: 'Москва. Пролетарская', value: 'moscow-proletarskaya', active: true },
	{ name: 'Москва.Измайловская', value: 'moscow-izmaylovskaya' },
	{ name: 'Красная поляна', value: 'krasnaya-polyana' },
	{ name: 'Приэльбрусье', value: 'prielbrusye' },
	{ name: 'Архыз', value: 'arhyz' },
	{ name: 'Пермь', value: 'perm' },
	{ name: 'Краснодар', value: 'krasnodar' },
	{ name: 'Красноярск', value: 'krasnoyarsk' },
	{ name: 'Екатеринбург', value: 'ekaterinburg' },
	{ name: 'Новосибирск', value: 'novosibirsk' },
	{ name: 'Нижний Новгород', value: 'nizhniy-novgorod' }
] %}

<div class="quick-filter-services" data-quick-filter>
	<div class="quick-filter-rent__locations-wrapper _grab" data-drag-scroll data-catalog-menu>
	<ul class="quick-filter-rent__locations" data-catalog-opened>
		{% for location in locations %}
			<li class="quick-filter-rent__location-item">
				{{ button({
					className: 'button _quick-filter' + (' _white-bg' if location.white else '') + (' _active' if location.active else ''),
					text: location.name,
					attr: 'data-location="' + location.value + '"'
				}) }}
			</li>
		{% endfor %}
	</ul>
	</div>
</div>

