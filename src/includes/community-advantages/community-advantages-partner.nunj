{% set list = [
	'Вы&nbsp;готовы вести бизнес на&nbsp;месте',
	'Вы&nbsp;хорошо знаете регион и&nbsp;его особенности',
	'Вы&nbsp;влюблены в&nbsp;горы и&nbsp;хотите популяризировать активный отдых'
] %}

<section class="community-advantages _partner" data-community-advantages>
	<div class="community-advantages__container container">
		<div class="community-advantages__title-wrapper">
			<h2 class="community-advantages__title h4 ttu" data-animation="words">
				Мы&nbsp;точно сработаемся, если:
			</h2>
		</div>
		<div class="community-advantages__wrapper">
			<ul class="community-advantages__list s2">
				{% for item in list %}
					<li class="community-advantages__item">
						<p class="community-advantages__item-text" data-animation="fade-right">{{ item }}</p>
					</li>
				{% endfor %}
				<p class="community-advantages__text p2 _tablet" data-animation="fade-right">
					<span class="community-advantages__asterisk h5 ttu">***</span><br>
					Остальное мы&nbsp;берем на&nbsp;себя!
				</p>
			</ul>
			<p class="community-advantages__text p2" data-animation="fade-right">
				<span class="community-advantages__asterisk h5 ttu">***</span><br>
				Остальное мы&nbsp;берем на&nbsp;себя!
			</p>
			<a class="community-advantages__link ttu" href="#" data-animation="fade-right">
				Подать заявку
			</a>
		</div>
	</div>
</section>
