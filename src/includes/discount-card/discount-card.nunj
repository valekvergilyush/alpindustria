{% from "../components/picture/picture.nunj" import picture %}

<section class="discount-card" data-discount-section>
	<div class="container">
		<h2 class="discount-card__title ttu h4">Ваша карта</h2>
		<p class="discount-card__text s2">На&nbsp;данный момент Ваш аккаунт не&nbsp;имеет привязанных накопительных карт.<br> Вы&nbsp;можете привязать уже существующую карту или заполнить анкету и&nbsp;оформить карту впервые:</p>

		<div class="discount-card__tabs tabs" data-tabs>
			<ul class="tabs__tab-list" role="tablist">
				<li class="tabs__tab-item">
					<button class="tabs__trigger _selected" id="create" role="tab" type="button" data-tab-trigger aria-selected="true" tabindex="0">Создать карту</button>
				</li>
				<li class="tabs__tab-item">
					<button class="tabs__trigger _selected" id="add" role="tab" type="button" data-tab-trigger aria-selected="false" tabindex="-1">Добавить карту</button>
				</li>
			</ul>
			<section class="discount-card__section _create tabs__panel" data-validate aria-labelledby="create" role="tabpanel" data-tab-panel aria-hidden="false" tabindex="0">
				{% include "../discount-create-form/discount-create-form.nunj" %}
			</section>
			<section class="discount-card__section _add tabs__panel" aria-labelledby="add" role="tabpanel" data-tab-panel aria-hidden="false" tabindex="-1">
				{% include "../discount-add-form/discount-add-form.nunj" %}
			</section>
		</div>
	</div>
	{% include "../discount-card-info/discount-card-info.nunj" %}
</section>
