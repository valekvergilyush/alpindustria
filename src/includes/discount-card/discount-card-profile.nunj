<section class="discount-card _profile">
	<div class="discount-card__tabs tabs" data-tabs>
		<ul class="tabs__tab-list" role="tablist">
			<li class="tabs__tab-item">
				<button class="tabs__trigger _selected" id="create" role="tab" type="button" data-tab-trigger aria-selected="true" tabindex="0">Создать карту</button>
			</li>
			<li class="tabs__tab-item">
				<button class="tabs__trigger _selected" id="add" role="tab" type="button" data-tab-trigger aria-selected="false" tabindex="-1">Добавить карту</button>
			</li>
		</ul>
		<section class="discount-card__section _create tabs__panel" aria-labelledby="create" role="tabpanel" data-tab-panel aria-hidden="false" tabindex="0">
			{% include "../discount-create-form/discount-create-form.nunj" %}
		</section>
		<section class="discount-card__section _add tabs__panel" aria-labelledby="add" role="tabpanel" data-tab-panel aria-hidden="false" tabindex="-1">
			{% include "../discount-add-form/discount-add-form.nunj" %}
		</section>
	</div>
</section>
