{% from "../components/icon/icon.nunj" import icon %}

{% set tabsList = [
	{ id: 'delivery', text: 'Доставка', active: true },
	{ id: 'payment', text: 'Оплата' },
	{ id: 'returns', text: 'Возврат товара' },
	{ id: 'contacts', text: 'Контакты' }
] %}

<section class="delivery-payment" data-community-tab>
	<ul class="delivery-payment__tabs">
		{% for tab in tabsList %}
			<li class="delivery-payment__tabs-item">
				<button class="delivery-payment__tabs-btn{% if tab.active %} _active{% endif %} h6 ttu" id="{{ tab.id }}" type="button" data-tab-btn>
					{{ tab.text }}
					{{ icon({
						iconName: 'double-arrow-right',
						attr: 'width="48" height="48"'
					}) }}
				</button>
			</li>
		{% endfor %}
	</ul>

	<div class="delivery-payment__sections">
		<section class="delivery-payment__section" aria-labelledby="delivery" data-tab-section="delivery">
			{% include "../delivery-tab/delivery-tab.nunj" %}
		</section>
		<section class="delivery-payment__section" aria-labelledby="payment" data-tab-section="payment">
			{% include "../delivery-payment-tab/delivery-payment-tab.nunj" %}
		</section>
		<section class="delivery-payment__section" aria-labelledby="returns" data-tab-section="returns">
			{% include "../delivery-return/delivery-return.nunj" %}
		</section>
		<section class="delivery-payment__section _active" aria-labelledby="contacts" data-tab-section="contacts">
			{% include "../delivery-contacts/delivery-contacts.nunj" %}
		</section>
	</div>
</section>
