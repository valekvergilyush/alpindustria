{% from "../components/icon/icon.nunj" import icon %}

{% set navList = [
	{
		name: 'доставка',
		active: true
	},
	{
		name: 'оплата'
	},
	{
		name: 'возврат товара'
	},
	{
		name: 'контакты'
	}
] %}

<section class="delivery-payment">
	<ul class="delivery-payment__nav">
		{% for item in navList %}
			<li class="delivery-payment__nav-item {% if item.active %}active{% endif %}">
				<button class="delivery-payment__tab-btn h6 ttu" type="button">{{ item.name }}</button>
				{{ icon({
					iconName: 'double-arrow-left',
					className: 'delivery-payment__tab-icon',
					attr: props.iconData
				}) }}
			</li>
		{% endfor %}
	</ul>
	<div class="delivery-payment__content">
		content
	</div>
</section>
