{% from "../components/icon/icon.nunj" import icon %}

{% set tabsList = [
	{ id: 'delivery', text: 'Доставка', active: true },
	{ id: 'payment', text: 'Оплата' },
	{ id: 'returns', text: 'Возврат товара' },
	{ id: 'contacts', text: 'Контакты' }
] %}


<section class="community-tabs _delivery">
	<ul class="community-tabs__tabs">
		{% for tab in tabsList %}
			<li class="community-tabs__tabs-item">
				<button class="community-tabs__tabs-btn{% if tab.active %} _active{% endif %} h5 ttu" id="{{ tab.id }}" type="button" data-tab-btn>
					{{ tab.text }}
					{{ icon({
						iconName: 'double-arrow-right',
						attr: 'width="48" height="48"'
					}) }}
				</button>
			</li>
		{% endfor %}
	</ul>

	<div class="community-tabs__sections">
		<section class="community-tabs__section _application-form _active" aria-labelledby="application-form" data-tab-section="application-form">
			{% include "../application-form/application-form.nunj" %}
		</section>
		<section class="community-tabs__section _contacts" aria-labelledby="contacts" data-tab-section="contacts">
			{% include "../community-contacts/community-contacts.nunj" %}
		</section>
		<section class="community-tabs__section _requisites" aria-labelledby="requisites" data-tab-section="requisites">
			{% include "../community-requisites/community-requisites.nunj" %}
		</section>
	</div>
</section>
