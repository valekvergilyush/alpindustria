{% from "../components/profile-order/profile-order.nunj" import profileOrder %}
{% from "../components/profile-review/profile-review.nunj" import profileReview %}
{% from "../components/button/button.nunj" import button %}

{% set productList = [
	{
		order: 'Бронирование № 175025947',
		date: '09.05.2021',
		status: 'Проверяется'
	},
	{
		order: 'Заказ № 175025947',
		date: '09.05.2021',
		status: 'Подтвержден',
		statusClass: '_confirmed'
	},
	{
		order: 'Заказ № 175025947',
		date: '09.05.2021',
		status: 'Ожидает оплаты',
		statusClass: '_awaiting'
	},
	{
		order: 'Заказ № 175025947',
		date: '09.05.2021',
		status: 'Отменен',
		statusClass: '_canceled'
	}
] %}
{% set reviewList = [
	{
		img: '/assets/images/cart/item-2',
		date: '09.05.2021',
		rating: '5',
		author: 'Наталья',
		title: 'Отличный продукт'
	},
	{
		img: '/assets/images/cart/item-2',
		date: '09.05.2021',
		rating: '5',
		author: 'Наталья',
		title: 'Отличный продукт'
	},
	{
		img: '/assets/images/cart/item-2',
		date: '09.05.2021',
		rating: '5',
		author: 'Наталья',
		title: 'Отличный продукт'
	}
] %}

<div class="profile-purchases">
	<div>
		<p class="profile-title profile-purchases__title h7 ttu">Cтатистика</p>
		{% include "../profile-stat/profile-stat.nunj" %}
	</div>
	<div>
		<p class="profile-title profile-purchases__title h7 ttu">История покупок</p>
		<ul class="profile-purchases__list">
			{% for product in productList %}
				<li class="profile-purchases__product">
					{{ profileOrder(product) }}
				</li>
			{% endfor %}
		</ul>
		{{ button({
			className: 'profile-purchases__more _show-more',
			text: 'Показать еще',
			icon: 'plus-circle',
			iconData: 'width="32" height="32"'
		}) }}
	</div>
	<div>
		<p class="profile-title profile-purchases__title h7 ttu">История отзывов</p>
			<ul class="profile-purchases__reviews">
				{% for review in reviewList %}
					<li>
						{{ profileReview(review) }}
					</li>
				{% endfor %}
			</ul>
	</div>
</div>
