{% from "../components/input/input.nunj" import input %}
{% from "../components/textarea/textarea.nunj" import textarea %}
{% from "../components/button/button.nunj" import button %}

<div class="cart-popup" data-validate>
	<form class="cart-popup__form">
		<div class="cart-popup__wrap">
			<p class="cart-popup__title h5 ttu">Задать вопрос</p>
			<div class="cart-popup__block _3">
				<div class="cart-popup__block _4 _col-2">
					{{ input({
						type: 'text',
						id: 'question-form-name',
						className: '',
						name: 'Имя'
					}) }}
					{{ input({
						type: 'text',
						id: 'question-form-surname',
						className: '',
						name: 'Фамилия'
					}) }}
				</div>
				{{ input({
					type: 'email',
					id: 'question-form-email',
					className: '',
					name: 'Почта'
				}) }}
				{{ input({
					type: 'tel',
					id: 'question-form-phone',
					name: 'Телефон',
					attr: 'data-validate-type="phone"'
				}) }}
				{{ textarea({
					id: 'question-form-text',
					className: '',
					label: 'Ваше сообщение',
					wordCounter: '500'
				}) }}
			</div>
		</div>
		<div class="cart-popup__bottom">
			{{ button({
				text: 'Задать вопрос',
				type: 'submit',
				icon: 'promo-arrow',
				iconData: 'width="16" height="16" viewBox="0 0 72 72"',
				className: 'product-popup__bottom-btn _arrow h7 ttu',
				attr: 'data-popup-opener="data-editing"'
			}) }}
		</div>
	</form>
</div>
