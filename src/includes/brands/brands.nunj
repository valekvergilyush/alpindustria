{% from "../components/icon/icon.nunj" import icon %}
{% set brands = [
	{
		name: 'PackTowl',
		logo: 'brand-logo-1'
	},
	{
		name: 'MSR',
		logo: 'brand-logo-2'
	},
	{
		name: 'The Noth Face',
		logo: 'brand-logo-3'
	},
	{
		name: 'MSR',
		logo: 'brand-logo-2'
	},
	{
		name: 'The Noth Face',
		logo: 'brand-logo-3'
	},
	{
		name: 'PackTowl',
		logo: 'brand-logo-1'
	},
	{
		name: 'Salomon',
		logo: 'brand-logo-4'
	},
	{
		name: 'PackTowl',
		logo: 'brand-logo-1'
	},
	{
		name: 'Salomon',
		logo: 'brand-logo-4'
	},
	{
		name: 'PackTowl',
		logo: 'brand-logo-1'
	},
	{
		name: 'MSR',
		logo: 'brand-logo-2'
	}
] %}
{% set letters = ['A','B','C','D','E','F'] %}
{% set activeLetter = 2 %}

<ul class="brands _logo" data-brand-block>
	{% for letter in letters %}
		<li class="brands__brand {% if loop.index === activeLetter %}_active{% endif %}" data-brand-item>
			<div class="brands__brand-wrap container">
				<p class="brands__letter h1">{{ letter }}</p>
				<ul class="brands__list">
					{% for brand in brands %}
						<li class="brands__item">
							<a href="brand.html" class="brands__link">
								<span class="brands__name h7">{{ brand.name }}</span>
								{{ icon({
									iconName: brand.logo,
									className: 'brands__img',
									attr: 'width="293" height="293" viewBox="0 0 321 321"'
								}) }}
							</a>
						</li>
					{% endfor %}
				</ul>
			</div>
			<button data-brand-btn class="brands__btn" type="button" aria-label="Показать бренды"></button>
		</li>
	{% endfor %}
</ul>
