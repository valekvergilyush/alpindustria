
{% from "../components/input/input.nunj" import input %}
{% from "../components/checkbox/checkbox.nunj" import checkbox %}

<div class="class-form">
	<div class="class-form__inputs">
		{{ input({
			type: 'text',
			id: 'class-form-name',
			name: 'Имя',
			className: 'class-form__input',
			attr: 'data-validate-type="text"'
		}) }}
		{{ input({
			type: 'text',
			id: 'class-form-surname',
			name: 'Фамилия',
			className: 'class-form__input',
			attr: 'data-validate-type="text"'
		}) }}
		{{ input({
			type: 'tel',
			id: 'class-form-phone',
			name: 'Телефон',
			className: 'class-form__input',
			attr: 'data-validate-type="phone"'
		}) }}
		{{ input({
			type: 'email',
			id: 'class-form-email',
			name: 'Почта',
			className: 'class-form__input',
			attr: 'data-validate-type="email"'
		}) }}
		{{ input({
			type: 'text',
			id: 'class-form-review',
			name: 'Уже проходили занятия в нашем Горном клубе? Напишите об этом',
			className: 'class-form__input _review',
			attr: 'data-validate-type="text"'
		}) }}
	</div>
	{{ checkbox({
		className: 'class-form__checkbox ttu',
		id: 'class-form-legal-entity',
		name: 'legal-entity',
		text: 'Я являюсь юридическим лицом'
	}) }}
</div>
