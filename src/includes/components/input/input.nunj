{% macro input(props) %}
	<div
		class="{% if props.className %}{{ props.className }} {% endif %}input{% if props.readonly %} _readonly{% endif %}"
		{% if props.attr %} {{ props.attr }}{% endif %}>
		<input
			class="input__input"
			id="{{ props.id }}"
			type="{{ props.type }}"
			name="{{ props.name }}"
			{% if props.value %}value="{{ props.value }}"{% endif %}
			placeholder=""
			{% if props.inputAttr %}{{ props.inputAttr }}{% endif %}
			{% if props.readonly %} readonly{% endif %}
		>
		<label class="input__label{% if props.labelClassName %} {{ props.labelClassName }}{% endif %}" for="{{ props.id }}">
			{% if props.label %}{{ props.label }}{% else %}{{ props.name }}{% endif %}
		</label>
		<span class="input__error-msg p4">Заполните поле</span>
		{% if props.wordCounter %}<p class="input__words-counter">до {{ props.wordCounter }} символов</p>{% endif %}
	</div>
{% endmacro %}
