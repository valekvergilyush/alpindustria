{% macro inputDate(props) %}
	<div class="input-date{% if props.className %} {{ props.className }}{% endif %}" {% if props.attr %} {{ props.attr }}{% endif %}>
		<label class="input-date__label" for="{{ props.id }}">{% if props.label %}{{ props.label }}{% endif %}</label>
		<input
			class="input-date__input"
			type="text"
			id="{{ props.id }}"
			name="{{ props.name }}"
			value="{{ props.value }}"
			readonly
			data-datepicker
			{% if props.inputAttr %} {{ props.inputAttr }}{% endif %}
		>
	</div>
{% endmacro %}
