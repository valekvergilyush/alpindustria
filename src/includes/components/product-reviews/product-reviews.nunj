{% from "../rating/rating.nunj" import rating %}
{% from "../icon/icon.nunj" import icon %}
{% from "../button/button.nunj" import button %}

{% macro productReviews(props) %}
	<div class="product-reviews {% if props.className %}{{ props.className }} {% endif %}">
		<div class="product-reviews__header">
			<p class="product-reviews__title ttu h6">Отзывы</p>
			<span class="product-reviews__count p3">34</span>
			<a href="#" class="product-reviews__add ttu">
				Добавить свой
				{{ icon({
					iconName: 'plus-circle-blue',
					className: 'product-reviews__add-icon',
					attr: 'width="32" height="32"'
				}) }}
			</a>
		</div>
		<ul class="product-reviews__list">
			<li class="product-reviews__review">
				{{ rating({
					className: 'product-reviews__raitng',
					rating: 5
				}) }}
				<p class="product-reviews__author p2">Наталья</p>
				<p class="product-reviews__review-title p1">Отличный продукт</p>
				<div class="product-reviews__text p3">
					<p>Всегда в этом магазине покупаю и обувь, и одежду, в этот раз купила треккинговые бахилы.</p>
					<p>Пришел нужный размер! По срокам, как и сказали))</p>
					<p>Спасибо Альпиндустрия! ВЫ лучшие!!Всегда в этом магазине покупаю и обувь, и одежду, в этот раз купила треккинговые бахилы. Пришел нужный размер! По срокам, как и сказали))</p>
					<p>Спасибо Альпиндустрия! ВЫ лучшие!!</p>
				</div>
				<p class="product-reviews__interests p3"><span class="blue">Увлечения:</span> Альпинизм, Горный туризм</p>
			</li>
			<li class="product-reviews__review">
				{{ rating({
					className: 'product-reviews__raitng',
					rating: 5
				}) }}
				<p class="product-reviews__author p2">Наталья</p>
				<p class="product-reviews__review-title p1">Отличный продукт</p>
				<div class="product-reviews__text p3">
					<p>Всегда в этом магазине покупаю и обувь, и одежду, в этот раз купила треккинговые бахилы.</p>
					<p>Пришел нужный размер! По срокам, как и сказали))</p>
					<p>Спасибо Альпиндустрия! ВЫ лучшие!!Всегда в этом магазине покупаю и обувь, и одежду, в этот раз купила треккинговые бахилы. Пришел нужный размер! По срокам, как и сказали))</p>
					<p>Спасибо Альпиндустрия! ВЫ лучшие!!</p>
				</div>
				<p class="product-reviews__interests p3"><span class="blue">Увлечения:</span> Альпинизм, Горный туризм</p>
				<div class="product-reviews__tooltip">
					{{ icon({
						iconName: 'logo-short',
						className: 'product-reviews__tooltip-icon',
						attr: 'width="40" height="32"'
					}) }}
					<span class="product-reviews__tooltip-text p4">Эксперт альпиндустрии</span>
				</div>
			</li>
		</ul>
		{{ button({
			className: 'product-reviews__more _show-more _no-bd',
			text: 'Показать еще',
			icon: 'plus-circle',
			iconData: 'width="32" height="32"'
		}) }}
	</div>
{% endmacro %}
