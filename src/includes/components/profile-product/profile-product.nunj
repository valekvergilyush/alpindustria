{% macro profileProduct(props) %}
	<div class="profile-product">
		<div class="profile-product__main">
			<a href="#" class="profile-product__img">
				<img src="{{ props.img }}.png" srcset="{{ props.img }}@2x.png 2x" width="126" height="160" alt="">
			</a>
			<div class="profile-product__main-inner">
				<a href="#" class="profile-product__name h7 ttu">{{ props.name }}</a>
				<p class="profile-product__price c-gray-dark">{{ props.price }}</p>
			</div>
		</div>
		<div class="profile-product__info">
			<div class="profile-product__color button _color _selected" aria-label="{{ props.colorName }}" style="background-color: {{ props.color }};"></div>
			<span class="profile-product__size">{{ props.size }}</span>
			<span class="profile-product__amount">{{ props.amount }}</span>
		</div>
	</div>
{% endmacro %}
