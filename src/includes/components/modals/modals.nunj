{% from "../icon/icon.nunj" import icon %}

{% macro modals(props) %}
	<div class="modals" data-modals>
			{% for modal in props.list %}
				<div class="modals__modal-wrapper" data-modal-wrapper="{{ modal.name }}"{% if modal.animation %} data-modal-animation="{{ modal.animation }}"{% endif %}>
					<div class="modals__modal" data-modal="{{ modal.name }}">
						{% include './modals-' + modal.name + '.nunj' %}
						<button class="modals__close-button" type="button" data-modal-closer>
							{{ icon({
								iconName: "close-popup",
								className: "modals__close-icon",
								attr: 'width="32" height="32" viewBox="0 0 32 32"'
							}) }}
						</button>
						<div class="modals__icon modals__inner-icon"></div>
					</div>
					<div class="modals__icon"></div>
				</div>
			{% endfor %}
	</div>
{% endmacro %}
