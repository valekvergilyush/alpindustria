{% macro inputTime(args) %}
	<div class="input-time{% if props.className %} {{ props.className }}{% endif %}">
		<label class="input-time__label" for="{{ props.id }}">{% if props.label %}{{ props.label }}{% endif %}</label>
		<input
			class="input-time__input"
			type="time"
			id="{{ props.id }}"
			name="{{ props.name }}"
			{% if props.value %}value="{{ props.value }}"{% endif %}
		>
	</div>
{% endmacro %}
