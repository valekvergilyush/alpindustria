{% macro checkboxButton(props) %}
	<div class="checkbox _button{% if props.className %} {{ props.className }}{% endif %}">
		<input
			class="checkbox__input visually-hidden"
			type="checkbox"
			id="{{ props.id }}"
			name="{{ props.label }}"
			{% if props.checked %}checked{% endif %}
		>
		<label class="checkbox__label button _quick-filter p3" for="{{ props.id }}">
			{{ props.label }}
		</label>
	</div>
{% endmacro %}
