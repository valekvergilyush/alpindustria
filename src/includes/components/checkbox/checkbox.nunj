{% macro checkbox(props) %}
	<div class="checkbox{% if props.className %} {{ props.className }}{% endif %}"{% if props.attr %} {{ props.attr }}{% endif %}>
		<input
			class="checkbox__input visually-hidden"
			type="checkbox"
			id="{{ props.id }}"
			name="{{ props.name }}"
			{% if props.checked %}checked{% endif %}
			{% if props.inputAttr %}{{ props.inputAttr }}{% endif %}
		>
		<label class="checkbox__label p3" for="{{ props.id }}">{{ props.text }}</label>
		<span class="checkbox__error-msg p4">Обязательное поле</span>
	</div>
{% endmacro %}
