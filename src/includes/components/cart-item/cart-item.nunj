{% from "../select/select-color.nunj" import selectColor %}
{% from "../select/select.nunj" import select %}
{% from "../counter/counter.nunj" import counter %}
{% from "../button/button.nunj" import button %}

{% macro cartItem(props) %}
	<div class="cart-item{% if props.readonly %} _readonly{% endif %}{% if props.className %} {{ props.className }}{% endif %}">
		<div class="cart-item__info">
			<p class="cart-item__title h7 ttu">{{ props.title }}</p>
			<p class="cart-item__price">{{ props.price }}</p>
			{% if props.readonly %}
				<div class="cart-item__props">
					<span
						class="cart-item__color button _color"
						style="background:#C9364C"
						aria-label="Красный">
					</span>
					<span class="cart-item__size">41</span>
					{{ counter({ number: 1, className: 'cart-item__counter _readonly' }) }}
				</div>
			{% endif %}

			{% if props.longDelivery %}
			<ul class="cart-item__badges">
				<li>{% include "../../product-badge/long-delivery.nunj" %}</li>
			</ul>
			{% endif %}
		</div>
		<div class="cart-item__img-wrapper">
			{% if props.srcImg %}
				<img class="cart-item__img" src="{{ props.srcImg }}" srcset="{{ props.srcsetImg }}" width="126" height="160" alt="" loading="lazy">
			{% endif %}
		</div>
		<div class="cart-item__controls">
			{% if not props.readonly %}
				<span
					class="cart-item__color button _color"
					style="background:#C9364C"
					aria-label="Красный">
				</span>
				<span class="cart-item__size button _rounded">
					41
				</span>
				{{ counter({ number: 1, className: 'cart-item__counter' }) }}
			{% endif %}
		</div>
		{% if props.btns %}
			<div class="cart-item__btns">
				{{ button({
					className: 'cart-item__btn',
					icon: 'cart',
					iconData: 'width="32" height="32" viewBox="0 0 36 36"',
					attr: 'aria-label="Добавить в корзину" data-notification-open="cart"'
				}) }}
				{{ button({
					className: 'cart-item__btn',
					icon: 'heart-full',
					iconData: 'width="32" height="32" viewBox="0 0 36 36"',
					attr: 'aria-label="Добавить в избранное"'
				}) }}
			</div>
		{% endif %}
	</div>
{% endmacro %}
