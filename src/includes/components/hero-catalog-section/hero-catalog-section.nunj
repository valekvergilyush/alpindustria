{% from "../picture/picture.nunj" import picture %}

{% macro heroCatalogSection(title, sectionMod, imagePath, categoryName, rootUrl, isSimpleImage) %}
<section class="page__hero hero-catalog {{ sectionMod }}" data-parallax>
	<div class="hero-catalog__bg-img-wrapper">
		{{ picture({
			className: 'hero-catalog__bg-img _hero',
			path: imagePath,
			ext: 'jpg',
			width: 1728,
			height: 720,
			attr: 'aria-hidden="true"',
			isSimple: isSimpleImage
		}) }}
	</div>
	<div class="hero-catalog__container container">
		{% if categoryName and rootUrl %}
		<h1 class="hero-catalog__title ttu tac" itemscope="" itemtype="https://schema.org/BreadcrumbList">
			<span class="hero-catalog__title-root h7">
				<span itemprop="itemListElement" itemscope="" itemtype="https://schema.org/ListItem">
					<a class="hero-catalog__title-link" href="{{ rootUrl }}" itemprop="item">
						<span itemprop="name">{{ title }}</span>
					</a>
					<meta itemprop="position" content="1"></span>
				<span class="hero-catalog__title-separator">/</span>
			</span>
			<span class="hero-catalog__title-category h4" itemprop="itemListElement" itemscope="" itemtype="https://schema.org/ListItem">
				<span itemprop="name">{{ categoryName }}</span>
				<meta itemprop="position" content="2">
			</span>
		</h1>
		{% else %}
		<h1 class="hero-catalog__title ttu tac">
			<span class="hero-catalog__title-category h4">{{ title }}</span>
		</h1>
		{% endif %}
		{{ caller() }}
	</div>
</section>
{% endmacro %}
