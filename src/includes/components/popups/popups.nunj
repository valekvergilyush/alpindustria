{% from "../icon/icon.nunj" import icon %}

{% macro popups(props) %}
	<div class="popups" data-popups>
			{% for i in props %}
				<div class="popups__popup" data-popup="{{ i.name }}">
					<h2 class="popups__title h5 ttu">{{ i.title }}</h2>
					<button class="popups__close-button" type="button" data-popup-closer>
						{{ icon({
							iconName: "close-popup",
							className: "popups__close-icon",
							attr: 'width="32" height="32" viewBox="0 0 32 32"'
						}) }}
					</button>
					{% include './popups-' + i.name + '.nunj' %}
				</div>
				<div class="popups__icon"></div>
				<div class="popups__overlay"></div>
			{% endfor %}
	</div>
{% endmacro %}
