{% from "../icon/icon.nunj" import icon %}

{% macro popups(names) %}
	<div class="popups" data-popups>
			{% for i in names %}
				<div class="popups__popup" data-popup="{{ i.name }}" data-popup-animation="{{ i.animation }}">
					{% include './popups-' + i.name + '.nunj' %}
					<button class="popups__close-button" type="button" data-popup-closer>
						{{ icon({
								iconName: "close",
								className: "popups__close-icon",
								attributes: "width=\"24\" height=\"24\" stroke=\"currentColor\""
						}) }}
					</button>
				</div>
			{% endfor %}
	</div>
{% endmacro %}
