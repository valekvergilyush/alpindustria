{% from "../icon/icon.nunj" import icon %}

{% macro popups(props) %}
	<div class="popups" data-popups>
			{% for popup in props.list %}
				<div class="popups__popup-wrapper" data-popup-wrapper="{{ popup.name }}"{% if popup.animation %} data-popup-animation="{{ popup.animation }}"{% endif %}>
					<div class="popups__popup" data-popup="{{ popup.name }}" body-scroll-lock-ignore>
						{% include './popups-' + popup.name + '.nunj' %}
						<button class="popups__close-button" type="button" data-popup-closer>
							{{ icon({
								iconName: "close-popup",
								className: "popups__close-icon",
								attr: 'width="32" height="32" viewBox="0 0 32 32"'
							}) }}
						</button>
					</div>
					<div class="popups__icon"></div>
				</div>
			{% endfor %}
	</div>
{% endmacro %}
