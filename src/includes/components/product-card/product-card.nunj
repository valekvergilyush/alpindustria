{% from "../button/button.nunj" import button %}
{% from "../icon/icon.nunj" import icon %}

{% set colorButtons = [
	{ name: 'Тёмно-зелёный', color: '#03836E' },
	{ name: 'Красный', color: '#C9364C' },
	{ name: 'Тёмно-фиолетовый', color: '#6F2876', disabled: true },
	{ name: 'Белый', color: '#FEFEFE' },
	{ name: 'Тёмно-синий', color: '#324481' },
	{ name: 'Тёмно-серый', color: '#342C25' }
] %}
{% set sizeButtons = [
	{ value: '37' },
	{ value: '38', disabled: true },
	{ value: '39' },
	{ value: '40' },
	{ value: '41' },
	{ value: '42' },
	{ value: '43' },
	{ value: '44' },
	{ value: '45' },
	{ value: '46' },
	{ value: '47' },
	{ value: '48' }
] %}
{% set daysButtons = [
	{ value: '8 - 15' },
	{ value: '16 - 23' },
	{ value: '24 - 31' },
	{ value: '8 - 15' },
	{ value: '16 - 23' },
	{ value: '24 - 31' }
] %}

{% macro productCard(props) %}
	{% set activeClassName = '' %}
	{% if props.inWishlist %}
		{% set activeClassName = ' _active' %}
	{% endif %}
	<article class="{% if props.className %}{{ props.className }} {% endif %}product-card" data-product-card>
		<a class="product-card__title ttu" href="{{ props.url }}" {% if props.linkAttr %}{{props.linkAttr}}{% endif %}>{{ props.title }}</a>
		<p class="product-card__brand p3">{{ props.brand }}</p>
		{% if not props.isRent %}
			<p class="product-card__price p3">
				{% if props.oldPrice %}
					<span class="product-card__old-price">{{ props.oldPrice }}</span>
				{% endif %}
				<span>{{ props.price }}</span>
			</p>
			{% if props.noAuth %}
				{{ button({
					className: 'product-card__button _wishlist' + activeClassName,
					attr: 'aria-label="Добавить в вишлист" data-popup-opener="auth"'
				}) }}
			{% else %}
				{{ button({
					className: 'product-card__button _wishlist' + activeClassName,
					attr: 'aria-label="Добавить в вишлист" data-popup-opener="wishlist-list"'
				}) }}
			{% endif %}
			{% if props.noAuth %}
				{{ button({
					className: 'product-card__button _wishlist' + activeClassName,
					attr: 'aria-label="Добавить в сравнение" data-popup-opener="auth"'
				}) }}
			{% else %}
				{{ button({
					className: 'product-card__button _compare' + activeClassName,
					icon: 'compare',
					iconData: 'width="32" height="32"',
					attr: 'aria-label="Добавить в сравнение" data-notification-open="compare-new"'
				}) }}
			{% endif %}
		{% endif %}
		<a class="product-card__link-photo" href="{{ props.url }}" {% if props.linkAttr %}{{props.linkAttr}}{% endif %}>
			<img class="product-card__photo" src="{{ props.photo }}.png" srcset="{{ props.photo }}@2x.png 2x" width="304" height="364" alt="">
			<img class="product-card__photo _zoom" src="{{ props.zoomPhoto }}.png" srcset="{{ props.zoomPhoto }}@2x.png 2x" width="432" height="540" alt="">
		</a>
		{% if props.isRent %}
			{{ button({
				text: 'Забронировать',
				className: 'product-card__button _product-card',
				attr: 'aria-label="Забронировать" data-popup-opener="wishlist-services"'
			}) }}
		{% else %}
			{{ button({
				text: 'В корзину',
				className: 'product-card__button _product-card',
				attr: 'aria-label="В корзину" data-product-card-props-opener'
			}) }}
		{% endif %}
		<div class="product-card__badges">
			{% if props.exclusive %}
				{% include "../../product-badge/exclusive-icon.nunj" %}
			{% endif %}
			{% if props.new %}
				{% include "../../product-badge/new.nunj" %}
			{% endif %}
			{% if props.longDelivery %}
				{% include "../../product-badge/long-delivery.nunj" %}
			{% endif %}
			{% if props.featureImg %}
				{% include "../../product-badge/dry-feature.nunj" %}
			{% endif %}
		</div>
		<form class="product-card__props" data-product-card-props>
			<div class="product-card__colors">
				<p class="h7 ttu">Цвет</p>
				<ul class="product-card__inputs-list _colors">
					{% for btn in colorButtons %}
						<li class="product-card__inputs-item">
							<label class="product-card__color">
								<input class="product-card__radio-input" type="radio" name="color" value="{{btn.name}}" data-value="{{ btn.color }}" {% if btn.selected %}checked{% endif %} {% if btn.disabled %}disabled{% endif %}>
								<span class="button _color _white product-card__input-span" style="background:{{ btn.color }}" aria-label="{{btn.name}}"></span>
							</label>
						</li>
					{% endfor %}
				</ul>
			</div>
			<div class="product-card__sizes">
				<p class="h7 ttu">Размер</p>
				<div class="product-card__inputs-wrap _sizes">
					<ul class="product-card__inputs-list _sizes" data-product-sizes  data-slider-group="3">
						{% for btn in sizeButtons %}
							<li class="product-card__inputs-item">
								<label class="product-card__size">
									<input class="product-card__radio-input" type="radio" name="size" value="{{ btn.value }}" {% if btn.selected %}checked{% endif %} {% if btn.disabled %}disabled{% endif %}>
									<span class="button _size _bd-white product-card__input-span" aria-label="Размер {{ btn.value }}">{{ btn.value }}</span>
								</label>
							</li>
						{% endfor %}
					</ul>
					<button type="button" aria-label="Далее" class="product-card__inputs-next" data-product-sizes-next>
						{{ icon({
							iconName: 'arrow-left',
							className: 'product-card__inputs-next-icon',
							attr: 'width="24" height="24"'
						}) }}
					</button>
				</div>
			</div>
			{% if props.days %}
				<div class="product-card__days">
					<p class="h7 ttu">Количество дней</p>
					<div class="product-card__inputs-wrap _days">
						<ul class="product-card__inputs-list _days" data-product-days  data-slider-group="3">
							{% for btn in daysButtons %}
								<li class="product-card__inputs-item">
									<label class="product-card__size">
										<input class="product-card__radio-input" type="radio" name="days" value="{{ btn.value }}" {% if btn.selected %}checked{% endif %} {% if btn.disabled %}disabled{% endif %}>
										<span class="button _size _days _bd-white product-card__input-span" aria-label="{{ btn.value }}">{{ btn.value }}</span>
									</label>
								</li>
							{% endfor %}
						</ul>
						<button type="button" aria-label="Далее" class="product-card__inputs-next" data-product-days-next>
							{{ icon({
								iconName: 'arrow-left',
								className: 'product-card__inputs-next-icon',
								attr: 'width="24" height="24"'
							}) }}
						</button>
					</div>
				</div>
			{% endif %}

			<div class="product-card__total">
				{{ button({
					icon: 'double-arrow-left',
					className: 'product-card__button _back-props',
					attr: 'aria-label="Назад" data-product-card-back'
				}) }}
				<span class="button _color _white product-card__input-span no-pe" data-product-card-color></span>
				<span class="button _size _bd-white product-card__input-span no-pe" data-product-card-size></span>
				{% if props.days %}
					<span class="button _size _days _bd-white product-card__input-span no-pe" data-product-card-days></span>
				{% endif %}
				{{ button({
					text: 'В корзину',
					className: 'product-card__button _add-cart h7 ttu',
					attr: 'aria-label="В корзину" data-product-card-add-cart data-notification-open="cart"'
				}) }}
			</div>

			{{ icon({
				iconName: 'double-arrow-down',
				className: 'product-card__arrow-icon',
				attr: 'width="32" height="32"'
			}) }}
		</form>
	</article>
{% endmacro %}
