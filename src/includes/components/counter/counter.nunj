{% macro counter(props) %}
	<div data-counter="block" class="counter {% if props.className %}{{ props.className }} {% endif %}">
		<button data-counter="minus" class="counter__btn" type="button" aria-label="Уменьшить"></button>
		<span class="counter__number">
			<span data-counter="number">{% if props.number %}{{ props.number }}{% else %}1{% endif %}</span>
			<span class="counter__units">шт.</span>
		</span>
		<button data-counter="plus" class="counter__btn _plus" type="button" aria-label="Увеличить"></button>
	</div>
{% endmacro %}
