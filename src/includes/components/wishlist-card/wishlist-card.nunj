{% from "../button/button.nunj" import button %}

{% macro wishlistCard(props) %}
	<div class="{% if props.className %}{{ props.className }} {% endif %}wishlist-card">
		<div class="wishlist-card__imgs">
			{% for img in props.imgs %}
				<div class="wishlist-card__img-wrap">
					<img class="wishlist-card__img" src="{{ img }}.png" srcset="{{ img }}@2x.png 2x" width="356" height="415" alt="">
				</div>
			{% endfor %}
		</div>
		<div class="wishlist-card__row _title">
			<a href="wishlist-page.html" class="wishlist-card__name h5 ttu">{{ props.name }}</a>
			<p class="wishlist-card__small">{{ props.year }}</p>
		</div>
		<div class="wishlist-card__row _bottom">
			<p class="wishlist-card__small">{{ props.number }}</p>
			{{ button({
				className: 'h7 ttu wishlist-card__add',
				text: 'Добавить все в корзину',
				icon: 'cart',
				iconData: 'width="36" height="36" viewBox="0 0 36 36"'
			}) }}
			{{ button({
				className: 'wishlist-card__add-mobile h7 ttu _plus',
				text: 'Добавить',
				icon: 'plus-circle-blue',
				iconData: 'width="24" height="24" viewBox="0 0 32 33"'
			}) }}
		</div>
	</div>
{% endmacro %}
