{% from "../icon/icon.nunj" import icon %}

{% macro newsItem(props) %}
	<a href="./news-article.html" class="{% if props.className %}{{ props.className }} {% endif %} news-item">
		<p class="news-item__category-date">
			<span class="p3">{{ props.category }}</span>
			<span class="news-item__date c-gray-dark">{{ props.date }}</span>
		</p>
		<p class="news-item__title h6 ttu">{{ props.title }}</p>
		<p class="news-item__author">
			<span class="p3 c-gray-dark">{{ props.author }}</span>
			{{ icon({
				iconName: 'promo-arrow',
				className: 'news-item__icon',
				attr: 'viewBox="0 0 72 72" width="24" height="24"'
			}) }}
		</p>
		<div class="news-item__img">
			<img src="{{ props.img }}.jpg" srcset="{{ props.img }}@2x.jpg 2x" alt="{{ props.title }}">
		</div>
	</a>
{% endmacro %}
