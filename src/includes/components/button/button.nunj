{% from "../icon/icon.nunj" import icon %}

{% macro button(props) %}
	<button class="{% if props.className %}{{ props.className }} {% endif %}button" type="{% if props.type %}{{ props.type }}{% else %}button{% endif %}"{% if props.attr %} {{ props.attr }}{% endif %}>
		{% if props.text %}
			<span class="button__text">{{ props.text }}</span>
		{% endif %}
		{% if props.icon %}
			{{ icon({
				iconName: props.icon,
				className: 'button__icon',
				attr: props.iconData
			}) }}
		{% endif %}
	</button>
{% endmacro %}
