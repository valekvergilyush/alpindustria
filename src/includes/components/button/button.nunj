{% from "../icon/icon.nunj" import icon %}

{% macro button(props) %}
	{% if props.href %}
		<a
		class="{% if props.className %}{{ props.className }} {% endif %}button"
		href="{{ props.href }}"
		{% if props.booknow %}data-booknow{% endif %}
		{% if props.attr %} {{ props.attr }}{% endif %}>
			{{ buttonInner(props) }}
		</a>
	{% else %}
		<button
		class="{% if props.className %}{{ props.className }} {% endif %}button"
		type="{% if props.type %}{{ props.type }}{% else %}button{% endif %}"
		{% if props.attr %} {{ props.attr }}{% endif %}>
			{{ buttonInner(props) }}
		</button>
	{% endif %}
{% endmacro %}

{% macro buttonInner(props) %}
	{% if props.color %}
		<span class="button__color" style="background-color: {{ props.color }}"></span>
	{% endif %}
	{% if props.text %}
		<span class="button__text">{{ props.text }}</span>
	{% endif %}
	{% if props.icon %}
		{{ icon({
			iconName: props.icon,
			className: 'button__icon',
			attr: props.iconData
		}) }}
	{% endif %}
{% endmacro %}
