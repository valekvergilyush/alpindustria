{% macro radio(props) %}
	<div class="radio{% if props.className %} {{ props.className }}{% endif %}">
		<input
			class="radio__input visually-hidden"
			type="radio"
			id="{{ props.id }}"
			name="{{ props.name }}"
			value="{% if props.value %}{{ props.value }}{% else %}{{ props.name }}{% endif %}"
			{% if props.checked %} checked{% endif %}
			{% if props.attr %} {{ props.attr }}{% endif %}
		>
		<label class="radio__label text" for="{{ props.id }}">
			<span class="radio__box"></span>
			{{ props.label }}
			{% if props.text %}
				<span class="radio__text">{{ props.text }}</span>
			{% endif %}
		</label>
	</div>
{% endmacro %}
