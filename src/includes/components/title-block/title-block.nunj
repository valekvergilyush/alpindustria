{% from "../button/button.nunj" import button %}

{% macro titleBlock(props) %}
	<div class="title-block"{% if props.attr %} {{ props.attr }}{% endif %}>
		<div class="title-block__wrap container">
			<h1 class="title-block__title h4 ttu">{{ props.title }}</h1>
			<div class="title-block__links">
				{{ button({
					className: 'title-block__link _social ttu _blue-border',
					text: 'VK',
					attr: 'target="_blank" rel="nofollow noopener"',
					href: '#'
				}) }}
				{{ button({
					className: 'title-block__link _social ttu _blue-border',
					text: 'TG',
					attr: 'target="_blank" rel="nofollow noopener"',
					href: '#'
				}) }}
				{{ button({
					className: 'title-block__link',
					icon: 'link',
					attr: 'aria-label="Поделиться" data-notification-open="link"',
					iconData: 'width="36" height="37" viewBox="0 0 36 37"'
				}) }}
				{{ button({
					className: 'title-block__link _download',
					href: '/docs/wishlist-1.pdf',
					icon: 'download',
					attr: 'aria-label="Загрузить" download',
					iconData: 'width="36" height="37" viewBox="0 0 36 37"'
				}) }}
				<div class="title-block__controls">
					{{ button({
						className: 'title-block__link _edit',
						href: '#',
						icon: 'pencil',
						attr: 'aria-label="Редактировать"',
						iconData: 'width="36" height="37" viewBox="0 0 36 37"'
					}) }}
					{{ button({
						className: 'title-block__link _delete',
						href: '#',
						icon: 'trash',
						attr: 'aria-label="Удалить" data-popup-opener="wishlist-delete"',
						iconData: 'width="36" height="37" viewBox="0 0 36 37"'
					}) }}
				</div>
			</div>
		</div>

		<div class="title-block__form-wrap container">
			{% include "../../new-wishlist-form/new-wishlist-form.nunj" %}
		</div>
	</div>
{% endmacro %}
