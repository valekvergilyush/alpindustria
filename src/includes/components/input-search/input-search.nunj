{% from "../icon/icon.nunj" import icon %}

{% macro inputSearch(props) %}
	<div class="{% if props.className %}{{ props.className }} {% endif %}input-search">
		<label class="input-search__label">
			<span class="input-search__label-text">{% if props.label %}{{ props.label }}{% else %}{{ props.name }}{% endif %}</span>
			<input
				class="input-search__input"
				id="{{ props.id }}"
				type="search"
				name="{{ props.name }}"
				{% if props.value %}value="{{ props.value }}"{% endif %}
				{% if props.inputAttr %}{{ props.inputAttr }}{% endif %}
			>
			{{ icon({
				iconName: 'search',
				className: 'input-search__icon no-pe',
				attr: 'width="24" height="24"'
			}) }}
		</label>
		{% if props.lang %}
			<span class="input-search__lang">A-Z</span>
		{% endif %}
	</div>
{% endmacro %}
