{% macro breadcrumbs(props) %}
	<div class="breadcrumbs{% if props.className %} {{ props.className }}{% endif %}">
		<ul class="breadcrumbs__list">
			{% for item in props.list %}
				<li class="breadcrumbs__item p3">
					<a href="{{ item.href }}" class="breadcrumbs__link">{{ item.text }}</a>
				</li>
			{% endfor %}
		</ul>
		<a href="{{ props.link.href }}" class="breadcrumbs__link _side p3{% if props.link.className %} {{ props.link.className }} {% endif %}">{{ props.link.text }}</a>
	</div>
{% endmacro %}
