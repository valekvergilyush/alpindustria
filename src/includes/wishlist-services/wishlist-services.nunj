{% from "../components/icon/icon.nunj" import icon %}
{% from "../components/select/select.nunj" import select %}
{% from "../components/counter/counter.nunj" import counter %}
{% from "../components/add-to-cart/add-to-cart.nunj" import addToCart %}

{% set colorButtons = [
	{ name: 'Тёмно-зелёный', color: '#03836E', selected: true },
	{ name: 'Красный', color: '#C9364C' },
	{ name: 'Тёмно-фиолетовый', color: '#6F2876', disabled: true },
	{ name: 'Тёмно-синий', color: '#324481' },
	{ name: 'Белый', color: '#FEFEFE' },
	{ name: 'Тёмно-серый', color: '#342C25' },
	{ name: 'Светло-зелёный', color: '#0B994B' }
] %}
{% set sizeButtons = [
	{ value: '37' },
	{ value: '38', disabled: true },
	{ value: '39', selected: true },
	{ value: '40' },
	{ value: '41' },
	{ value: '42' },
	{ value: '43' },
	{ value: '44' },
	{ value: '45' }
] %}
{% set cityList = [
	{ name: 'Москва', value: 'Москва' },
	{ name: 'Санкт-Петербург', value: 'Санкт-Петербург' },
	{ name: 'Новосибирск', value: 'Новосибирск' },
	{ name: 'Екатеринбург', value: 'Екатеринбург' }
] %}

<div class="wishlist-services">
	<div class="wishlist-services__header">
		<h2 class="wishlist-services__title h5 ttu">Палки<br>телескопические</h2>
		<a href="/brand.html" class="wishlist-services__arrow _brand p2">
			The North Face
			{{ icon({
				iconName: 'promo-arrow',
				className: 'wishlist-services__arrow-icon',
				attr: 'width="16" height="16" viewBox="0 0 72 72"'
			}) }}
		</a>
		<div class="wishlist-services__rating">
			<div class="wishlist-services__rating-star">
				{{ icon({
					className: 'filled',
					iconName: 'star',
					attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
				}) }}
				{{ icon({
					className: 'empty',
					iconName: 'star-empty',
					attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
				}) }}
			</div>
			<div class="wishlist-services__rating-star">
				{{ icon({
					className: 'filled',
					iconName: 'star',
					attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
				}) }}
				{{ icon({
					className: 'empty',
					iconName: 'star-empty',
					attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
				}) }}
			</div>
			<div class="wishlist-services__rating-star">
				{{ icon({
					className: 'filled',
					iconName: 'star',
					attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
				}) }}
				{{ icon({
					className: 'empty',
					iconName: 'star-empty',
					attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
				}) }}
			</div>
			<div class="wishlist-services__rating-star">
				{{ icon({
					className: 'filled',
					iconName: 'star',
					attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
				}) }}
				{{ icon({
					className: 'empty',
					iconName: 'star-empty',
					attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
				}) }}
			</div>
			<div class="wishlist-services__rating-star _empty">
				{{ icon({
					className: 'filled',
					iconName: 'star',
					attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
				}) }}
				{{ icon({
					className: 'empty',
					iconName: 'star-empty',
					attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
				}) }}
			</div>
			<div class="wishlist-services__rating-mobile">
				<div class="wishlist-services__rating-star _mobile">
					{{ icon({
						iconName: 'star',
						attr: 'width="26" height="26" viewBox="0 0 26.3 24.5"'
					}) }}
				</div>
				<span class="wishlist-services__rating-number p1">4.9</span>
			</div>
		</div>
	</div>
	<div class="wishlist-services__block">
		<p class="h7 ttu">Стоимость проката</p>
		{% include "../rent-table/rent-table.nunj" %}
		<div class="wishlist-services__pledge">
			<p class="wishlist-services__pledge-title p3">Залог</p>
			<div>
				<p class="h7">15 000 ₽</p>
				<p class="p4">или документ на выбор (паспорт, загранпаспорт, водительские права)</p>
			</div>
		</div>
	</div>
	<div class="wishlist-services__block">
		<div class="wishlist-services__params">
			<div class="wishlist-services__params-title">
				<p class="ttu">Цвет</p>
			</div>
			<div class="wishlist-services__params-wrap">
				<ul class="wishlist-services__params-list">
					{% for btn in colorButtons %}
						<li class="wishlist-services__param">
							<label class="wishlist-services__color">
								<input class="wishlist-services__radio-input" type="radio" name="color" value="{{btn.name}}" {% if btn.selected %}checked{% endif %} {% if btn.disabled %}disabled{% endif %}>
								<span class="button _color" style="background:{{ btn.color }}" aria-label="{{btn.name}}"></span>
							</label>
						</li>
					{% endfor %}
				</ul>
			</div>
		</div>
		<div class="wishlist-services__params">
			<div class="wishlist-services__params-title">
				<p class="ttu">Размер</p>
				<button type="button" class="wishlist-services__params-link p4" data-popup-opener="sizes">Таблица размеров</button>
			</div>
			<div class="wishlist-services__params-wrap">
				<ul class="wishlist-services__params-list" data-product-sizes data-slider-group="4">
					{% for btn in sizeButtons %}
						<li class="wishlist-services__param">
							<label class="wishlist-services__size">
								<input class="wishlist-services__radio-input" type="radio" name="size" value="{{ btn.value }}" {% if btn.selected %}checked{% endif %} {% if btn.disabled %}disabled{% endif %}>
								<span class="button _size" aria-label="Размер {{ btn.value }}">{{ btn.value }}</span>
							</label>
						</li>
					{% endfor %}
				</ul>
				<button type="button" aria-label="Следующие цвета" class="wishlist-services__inputs-next" data-product-sizes-next>
					{{ icon({
						iconName: 'arrow-left',
						className: 'product__inputs-next-icon',
						attr: 'width="24" height="24"'
					}) }}
				</button>
			</div>
		</div>
		<div class="wishlist-services__params">
			<div class="wishlist-services__params-title">
				<p class="ttu">Количество</p>
			</div>
			{{ counter({
				number: 1,
				className: 'wishlist-services__counter'
			}) }}
		</div>
	</div>
	<div class="wishlist-services__block">
		<p class="h7 ttu">Описание</p>
		<div class="wishlist-services__text p3 c-gray-dark">
			<p>Ботинки Zamberlan 8000 Everest Evo RR&nbsp;специально разработаны для экстремальных экспедиций на&nbsp;больших высотах. Съемный внутренний ботинок гарантирует оптимальную теплоизоляцию, новая подошва Vibram&reg; Penia имеет глубокие разнонаправленные шипы для лучшего сцепления и&nbsp;долговечности. Промежуточная подошва из&nbsp;двух слоев полиуретана&nbsp;&mdash; жесткого и&nbsp;более мягкого, для обеспечения поддержки, амортизирующих свойств и&nbsp;небольшого веса. Прочная застежка устойчива к&nbsp;механическим нагрузкам и&nbsp;повреждениям, высокое голенище с&nbsp;ветро и&nbsp;водонепроницаемой молнией YKK устойчивой к&nbsp;УФ.</p>
			<a href="#" class="wishlist-services__arrow _product h7 ttu c-blue-dark">
				<span>Cтраница товара</span>
				{{ icon({
					iconName: 'promo-arrow',
					className: 'wishlist-services__arrow-icon',
					attr: 'width="16" height="16" viewBox="0 0 72 72"'
				}) }}
			</a>
		</div>
	</div>
	<div class="wishlist-services__block">
		<p class="h7 ttu">Наличие</p>
		{% include "../availability/availability-services.nunj" %}
	</div>
	{{ addToCart({
		className: 'wishlist-services__add',
		list: [
			{
				text: 'Стоимость:',
				price: '9 000 ₽'
			}
		],
		link: {
			text: 'в корзину',
			url: '#'
		}
	}) }}
</div>
