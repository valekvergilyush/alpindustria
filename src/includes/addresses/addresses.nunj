{% from "../components/icon/icon.nunj" import icon %}

{% set citiesList = [
	'Москва',
	'Санкт-петербург',
	'Новосибирск',
	'Пермь',
	'Екатеринбург',
	'Пятигорск',
	'Воронеж',
	'Пермь',
	'Краснодар',
	'Приэльбрусье',
	'Красная поляна',
	'Безенги',
	'Нижний новгород',
	'Пятигорск',
	'Воронеж'
] %}

<section class="addresses" data-addresses>
	<div class="addresses__cities">
		{% for city in citiesList %}
			<button class="addresses__city h6 ttu {% if loop.index === 2 %}_active{% endif %}" data-city-btn={{ loop.index - 1 }}>
				<span class="addresses__city-text">{{ city }}</span>
				{{ icon({
					iconName: 'double-arrow-right',
					className: 'addresses__city-icon',
					attr: 'width="32" height="32" viewBox="0 0 48 49"'
				}) }}
			</button>
		{% endfor %}
	</div>
	<div class="addresses__content" data-addresses-content>
		<div class="addresses__map map" data-map="address"></div>
		<div class="addresses__tabs">
			{% for city in citiesList %}
				<div class="addresses__tab {% if loop.index === 2 %}_active{% endif %}" data-city-tab="{{ loop.index - 1 }}">
					<div class="addresses__shops">
						{% if (loop.index % 2 === 1) %}
							{% include "../addresses-shop/addresses-shop-2.nunj" %}
							{% include "../addresses-shop/addresses-shop.nunj" %}
						{% else %}
							{% include "../addresses-shop/addresses-shop.nunj" %}
							{% include "../addresses-shop/addresses-shop-2.nunj" %}
							{% include "../addresses-shop/addresses-shop.nunj" %}
							{% include "../addresses-shop/addresses-shop-2.nunj" %}
							{% include "../addresses-shop/addresses-shop.nunj" %}
							{% include "../addresses-shop/addresses-shop-2.nunj" %}
						{% endif %}
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
</section>
