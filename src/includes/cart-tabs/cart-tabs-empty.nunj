{% from "../components/button/button.nunj" import button %}

{% set cartTabs = [
	{ id: 'shop', name: 'Магазин', isSelected: true, tabindex: '0' },
	{ id: 'rental', name: 'Прокат', tabindex: '-1' }
]
%}

<div class="cart__tabs cart-tabs tabs" data-tabs>
	<ul class="tabs__tab-list" role="tablist">
		{% for item in cartTabs %}
			<li class="tabs__tab-item">
				<button class="tabs__trigger{% if item.isSelected %} _selected{% endif %}" id="{{ item.id }}" role="tab" type="button" data-tab-trigger aria-selected="true" tabindex="{{ item.tabindex }}">
					{{ item.name }}
				</button>
			</li>
		{% endfor %}
	</ul>
	<section class="cart-tabs__section _shop tabs__panel" aria-labelledby="shop" role="tabpanel" data-tab-panel aria-hidden="false" tabindex="0">
		{% include '../cart-list/cart-list-empty.nunj' %}
		<div class="cart-tabs__placeholder">
			<p class="cart-tabs__section-text h6 ttu c-gray-dark">Ваша корзина пуста</p>
			{{ button({
			icon: 'promo-arrow',
				iconData: 'width="16" height="16"',
				className: 'cart-tabs__section-link h7 ttu _arrow-m',
				text: 'В магазин',
				href: '/catalog/'
			}) }}
		</div>
	</section>
	<section class="cart-tabs__section _rental tabs__panel" aria-labelledby="rental" role="tabpanel" data-tab-panel aria-hidden="false" tabindex="-1">
		{% include '../cart-list/cart-list-empty.nunj' %}
		<div class="cart-tabs__placeholder">
			<p class="cart-tabs__section-text h6 ttu c-gray-dark">Ваша корзина пуста</p>
			{{ button({
				icon: 'promo-arrow',
				iconData: 'width="16" height="16"',
				className: 'cart-tabs__section-link h7 ttu _arrow-m',
				text: 'В прокат',
				href: '/rent.html'
			}) }}
		</div>
	</section>
	<div class="cart-bottom">
		<p class="cart-tabs__price p3">
			Итого без учета доставки:<br>
			<span class="cart-tabs__price-value h5 ttu">0 ₽</span>
		</p>
		{{ button({
			type: 'submit',
			text: 'Оформить',
			icon: 'promo-arrow',
			iconData: 'width="18" height="18"',
			className: 'cart-tabs__submit _arrow',
			attr: 'data-cart-delivery-opener'
		}) }}
	</div>
</div>
