{% from "../components/icon/icon.nunj" import icon %}
{% from "../components/shop-card/shop-card.nunj" import shopCard %}

{% set shopCardsList = [
	{
		address: 'ул. Первомайская, 18',
		metro: 'м.Первомайская',
		schedule: 'Ежедневно c 10:00 до 22:00',
		phone: '+7&nbsp;(812)&nbsp;242&#8209;11&#8209;95',
		email: 'info.spb@alpindustria.ru'
	},
	{
		address: 'Сколковское шоссе, 31, ТВЦ СпортХит, 3 этаж, пав. 14',
		metro: 'м.Первомайская',
		schedule: 'Ежедневно c 10:00 до 22:00',
		phone: '+7&nbsp;(812)&nbsp;242&#8209;11&#8209;95',
		email: 'info.spb@alpindustria.ru'
	},
	{
		address: 'ул. Смольная, 63Б, ТЦ Экстрим, 3 этаж, Л-18',
		metro: 'м.Первомайская',
		schedule: 'Ежедневно c 10:00 до 22:00',
		phone: '+7&nbsp;(812)&nbsp;242&#8209;11&#8209;95',
		email: 'info.spb@alpindustria.ru'
	},
	{
		address: 'ул. Смольная, 63Б, TЦ Экстрим, 2 этаж, Д-3',
		metro: 'м.Первомайская',
		schedule: 'Ежедневно c 10:00 до 22:00',
		phone: '+7&nbsp;(812)&nbsp;242&#8209;11&#8209;95',
		email: 'info.spb@alpindustria.ru'
	}
] %}

<div class="services-content container" data-accordion-content>
	<p class="services-content__text p1">В&nbsp;магазине АльпИндустрия на&nbsp;Первомайской можно заточить альпинистские кошки, ледорубы и&nbsp;ледовые инструменты. Мы&nbsp;принимаем в&nbsp;работу практически все модели кошек, ледорубов и&nbsp;ледовых инструментов. Главное, чтобы они были в&nbsp;чистом состоянии. По&nbsp;срокам работа выполняется до&nbsp;семи календарных дней.</p>
	<div class="services-content__block">
		<p class="h5 ttu">Стоимость услуг</p>
		<div class="services-content__block _1">
			{% include "../services-price/services-price.nunj" %}
			<p class="services-content__price-text p4 c-gray-dark">*Мастер оставляет за&nbsp;собой право увеличить стоимость в&nbsp;зависимости от&nbsp;состояния кошек.<br>Перед заточкой стоимость согласовывается с&nbsp;клиентом.</p>
		</div>
	</div>
	<div class="services-content__block">
		<p class="h5 ttu">Адреса</p>
		<div class="services-content__accordions">
			<div class="services-accordion">
				<button class="services-accordion__btn h6 ttu" type="button" data-accordion-toggle>
					Санкт-петербург
					{{ icon({
						iconName: 'accordion-arrow',
						className: 'services-accordion__btn-icon',
						attr: 'viewBox="0 0 16 16" width="16" height="16"'
					}) }}
				</button>
				<div class="services-accordion__content">
					<div class="services-content__cards">
						{% for card in shopCardsList %}
							{{shopCard(card)}}
						{% endfor %}
					</div>
				</div>
			</div>
			<div class="services-accordion _opened">
				<button class="services-accordion__btn h6 ttu" type="button" data-accordion-toggle>
					Москва
					{{ icon({
						iconName: 'accordion-arrow',
						className: 'services-accordion__btn-icon',
						attr: 'viewBox="0 0 16 16" width="16" height="16"'
					}) }}
				</button>
				<div class="services-accordion__content">
					<div class="services-content__cards">
						{% for card in shopCardsList %}
							{{shopCard(card)}}
						{% endfor %}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
