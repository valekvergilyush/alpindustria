{% from "../components/product-card/product-card.nunj" import productCard %}
{% from "../components/icon/icon.nunj" import icon %}

{% set productList = [
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-4', zoomPhoto: '/assets/images/catalog/item-4-zoom' }
] %}

{% set productList2 = [
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-1', zoomPhoto: '/assets/images/catalog/item-4-zoom' },
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-2', zoomPhoto: '/assets/images/catalog/item-4-zoom', inWishlist: true },
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-3', zoomPhoto: '/assets/images/catalog/item-4-zoom', new: true, featureImg: '/assets/images/catalog/product-feature', featureImgAlt: 'Core-Tex products Guaranteed to keep you dry' },
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-4', zoomPhoto: '/assets/images/catalog/item-4-zoom', featureImg: '/assets/images/catalog/product-feature', featureImgAlt: 'Core-Tex products Guaranteed to keep you dry' },
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-1', zoomPhoto: '/assets/images/catalog/item-4-zoom' },
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-2', zoomPhoto: '/assets/images/catalog/item-4-zoom', inWishlist: true },
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-3', zoomPhoto: '/assets/images/catalog/item-4-zoom', new: true, featureImg: '/assets/images/catalog/product-feature', featureImgAlt: 'Core-Tex products Guaranteed to keep you dry' },
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-4', zoomPhoto: '/assets/images/catalog/item-4-zoom', featureImg: '/assets/images/catalog/product-feature', featureImgAlt: 'Core-Tex products Guaranteed to keep you dry' }
] %}

{% set productList3 = [
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-4', zoomPhoto: '/assets/images/catalog/item-4-zoom' },
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-4', zoomPhoto: '/assets/images/catalog/item-4-zoom' }
] %}

{% set productList4 = [
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-4', zoomPhoto: '/assets/images/catalog/item-4-zoom' },
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-4', zoomPhoto: '/assets/images/catalog/item-4-zoom' },
	{ className: 'catalog__card', url: '/catalog/product-page.html', title: 'Куртка The North Face M Dryzzle All Weather Jkt', brand: 'The North Face', price: '33 150 ₽', photo: '/assets/images/catalog/item-4', zoomPhoto: '/assets/images/catalog/item-4-zoom' }
] %}

<article class="article p2">
	{% include "../article-main/article-main.nunj" %}
	<div class="container">
		<div class="article__content">
			{% include "../article-content/article-content.nunj" %}
		</div>
	</div>

	<div class="swiper" data-article-slider>
		<ul class="article-slider swiper-wrapper">
			{% for product in productList %}
				<li class="article-slider__product swiper-slide">
					{{ productCard(product) }}
				</li>
			{% endfor %}
		</ul>

		<div class="swiper-pagination"></div>

		<button class="activities__button swiper-button-prev" type="button" aria-label="Previous">
			{{ icon({
				iconName: 'slider-arrow-left',
				attr: 'width="56" height="56"'
			}) }}
		</button>
		<button class="activities__button swiper-button-next" type="button" aria-label="Next">
			{{ icon({
				iconName: 'slider-arrow-right',
				attr: 'width="56" height="56"'
			}) }}
		</button>
	</div>

	<div class="container">
		<div class="article__content">
			{% include "../article-content/article-content-2.nunj" %}
		</div>
	</div>

	<div class="swiper" data-article-slider>
		<ul class="article-slider swiper-wrapper">
			{% for product in productList2 %}
				<li class="article-slider__product swiper-slide">
					{{ productCard(product) }}
				</li>
			{% endfor %}
		</ul>

		<div class="swiper-pagination"></div>

		<button class="activities__button swiper-button-prev" type="button" aria-label="Previous">
			{{ icon({
				iconName: 'slider-arrow-left',
				attr: 'width="56" height="56"'
			}) }}
		</button>
		<button class="activities__button swiper-button-next" type="button" aria-label="Next">
			{{ icon({
				iconName: 'slider-arrow-right',
				attr: 'width="56" height="56"'
			}) }}
		</button>
	</div>

	<div class="container">
		<div class="article__content">
			{% include "../article-content/article-content-3.nunj" %}
		</div>
	</div>

	<div class="swiper" data-article-slider>
		<ul class="article-slider swiper-wrapper">
			{% for product in productList3 %}
				<li class="article-slider__product swiper-slide">
					{{ productCard(product) }}
				</li>
			{% endfor %}
		</ul>

		<div class="swiper-pagination"></div>

		<button class="activities__button swiper-button-prev" type="button" aria-label="Previous">
			{{ icon({
				iconName: 'slider-arrow-left',
				attr: 'width="56" height="56"'
			}) }}
		</button>
		<button class="activities__button swiper-button-next" type="button" aria-label="Next">
			{{ icon({
				iconName: 'slider-arrow-right',
				attr: 'width="56" height="56"'
			}) }}
		</button>
	</div>

	<div class="container">
		<div class="article__content">
			{% include "../article-content/article-content-4.nunj" %}
		</div>
	</div>

	<div class="swiper" data-article-slider>
		<ul class="article-slider swiper-wrapper">
			<li class="article-slider__product _empty">
				<div class="catalog__promo-card catalog-promo _empty"></div>
			</li>
			{% for product in productList4 %}
				<li class="article-slider__product swiper-slide">
					{{ productCard(product) }}
				</li>
			{% endfor %}
		</ul>

		<div class="swiper-pagination"></div>

		<button class="activities__button swiper-button-prev" type="button" aria-label="Previous">
			{{ icon({
				iconName: 'slider-arrow-left',
				attr: 'width="56" height="56"'
			}) }}
		</button>
		<button class="activities__button swiper-button-next" type="button" aria-label="Next">
			{{ icon({
				iconName: 'slider-arrow-right',
				attr: 'width="56" height="56"'
			}) }}
		</button>
	</div>
</article>
