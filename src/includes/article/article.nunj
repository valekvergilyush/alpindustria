] %}

<article class="article p2">
	{% include "../article-main/article-main.nunj" %}
	<div class="container">
		<div class="article__content">
			{% include "../article-content/article-content.nunj" %}
		</div>
	</div>
	<ul class="article__products-list">
		{% for product in productList %}
			<li class="article__product">
				{{ productCard(product) }}
			</li>
		{% endfor %}
	</ul>
	<div class="container">
		<div class="article__content">
			{% include "../article-content/article-content-2.nunj" %}
		</div>
	</div>
	<ul class="article-slider" data-article-slider>
		{% for product in productList2 %}
			<li class="article-slider__product">
				{{ productCard(product) }}
			</li>
		{% endfor %}
	</ul>
	<div class="container">
		<div class="article__content">
			{% include "../article-content/article-content-3.nunj" %}
		</div>
	</div>
	<ul class="article__products-list">
		{% for product in productList %}
			<li class="article__product">
				{{ productCard(product) }}
			</li>
		{% endfor %}
	</ul>
	<div class="container">
		<div class="article__content">
			{% include "../article-content/article-content-4.nunj" %}
		</div>
	</div>
</article>
