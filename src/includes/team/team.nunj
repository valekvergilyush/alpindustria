<section class="team">
	<div class="container">
		<h2 class="team__title ttu h4">Команда</h2>
	</div>
	<ul class="team__list" data-team-list>
		{% for item in teamList %}
			<li class="team__item" data-team-item>
				<div class="team__item-details">
					<p class="team__item-name h5 ttu">{{ item.name }}</p>
					<p class="team__item-title p3">{{ item.title }}</p>
					<div class="team__item-info p3">{{ item.info }}</div>
				</div>
				<img
					class="team__item-photo"
					src="{{ item.photoSrc }}"
					srcset="{{ item.photoSrcset }}"
					width="432"
					height="432"
					alt=""
				>
			</li>
		{% endfor %}
	</ul>
	{{ button({
		className: 'team__show-more-btn _show-more',
		text: 'Показать еще',
		icon: 'plus-circle',
		iconData: 'width="32" height="32"'
	}) }}
</section>
