{% from "../components/icon/icon.nunj" import icon %}

{% set navLinks = [
	{
		text: 'Магазин',
		img: { src: '/assets/images/menu/menu-shop.jpg', srcset: '/assets/images/menu/menu-shop@2x.jpg 2x' },
		url: '#',
		list: [
			{ text: 'Все товары', url: '/catalog/' },
			{ text: 'Одежда', url: '#' },
			{ text: 'Лыжный туризм', url: '#' },
			{ text: 'Туристическое снаряжение', url: '#' },
			{ text: 'Книги', url: '#' },
			{ text: 'Обувь', url: '#' },
			{ text: 'Альпинистское снаряжение', url: '#' },
			{ text: 'Сноуборды', url: '#' },
			{ text: 'Горные лыжи', url: '#' }
		]
	},
	{ text: 'Адреса', url: '/addresses.html', img: { src: '/assets/images/menu/menu-address.jpg', srcset: '/assets/images/menu/menu-address@2x.jpg 2x' } },
	{
		text: 'Сообщество',
		img: { src: '/assets/images/menu/menu-community.jpg', srcset: '/assets/images/menu/menu-community@2x.jpg 2x' },
		url: '#',
		list: [
			{ text: 'Горный клуб', url: '/community/', img: { src: '/assets/images/menu/menu-club.jpg', srcset: '/assets/images/menu/menu-club@2x.jpg 2x' } },
			{ text: 'Занятия', url: '/community/classes.html' },
			{ text: 'Трейлы', url: '/community/trails.html' },
			{ text: 'Фрирайд', url: '/community/freerides.html' }
		]
	},
	{ text: 'Прокат', url: '#', img: { src: '/assets/images/menu/menu-rent.jpg', srcset: '/assets/images/menu/menu-rent@2x.jpg 2x' } },
	{ text: 'Сервисы', url: '#', img: { src: '/assets/images/menu/menu-service.jpg', srcset: '/assets/images/menu/menu-service@2x.jpg 2x' } },
	{ text: 'Новости', url: '/news.html', img: { src: '/assets/images/menu/menu-news.jpg', srcset: '/assets/images/menu/menu-news@2x.jpg 2x' } },
	{ text: 'О нас', url: '#', img: { src: '/assets/images/menu/menu-about.jpg', srcset: '/assets/images/menu/menu-about@2x.jpg 2x' } }
] %}

{% set menuLinks = [
	{ text: 'Бренды', url: '/brands.html', img: { src: '/assets/images/menu/menu-brand.jpg', srcset: '/assets/images/menu/menu-brand@2x.jpg 2x' } },
	{ text: 'Дисконтная<br> программа', url: '/discount.html', img: { src: '/assets/images/menu/menu-delivery.jpg', srcset: '/assets/images/menu/menu-delivery@2x.jpg 2x' } },
	{ text: 'Экология', url: '/ecology.html', img: { src: '/assets/images/menu/menu-eco.jpg', srcset: '/assets/images/menu/menu-eco@2x.jpg 2x' } }
] %}

<div class="page__menu menu" data-menu>
	<div class="menu__top">
		<a href="#" class="menu__user-link ttu">
			{{ icon({
				iconName: 'user',
				className: 'menu__user-icon',
				attr: 'width="24" height="24"'
			}) }}
			Личный кабинет
		</a>
		<button class="menu__location ttu" type="button" data-popup-opener="city-form">
			{{ icon({
				iconName: 'map-pin',
				className: 'menu__location-icon _map',
				attr: 'width="16" height="16"'
			}) }}
			Санкт - Петербург
			{{ icon({
				iconName: 'arrow-down',
				className: 'menu__location-icon _arrow',
				attr: 'width="16" height="16"'
			}) }}
		</button>
		<p class="menu__info p4">Звоните нам ежедневно с 9:00 до 21:00 или напишите нам:</p>
		<p class="menu__info-links h7">
			<a class="menu__tel" href="tel:88125283776">8 812 528 37 76</a>
			<a class="menu__tel" href="tel:88007751630">8 800 775 16 30</a>
			<a class="menu__mail" href="mailto:sale@alpindustria.ru">sale@alpindustria.ru</a>
		</p>
	</div>
	<nav class="menu__nav">
		<ul class="menu__nav-list">
			{% for link in navLinks %}
				<li class="menu__nav-item{% if link.list %} _dropdown{% endif %}">
					<a
						class="menu__nav-link ttu"
						href="{{ link.url }}"
						{% if link.list %} data-accordion-toggle{% if link.opened %}="opened"{% endif %}{% endif %}
						{% if link.img %} data-menu-img-src="{{ link.img.src }}" data-menu-img-srcset="{{ link.img.srcset }}"{% endif %}
					>
						{{ link.text }}
						{% if link.list %}
							{{ icon({
								iconName: 'accordion-arrow',
								className: 'menu__accordion-icon',
								attr: 'width="32" height="32"'
							}) }}
						{% endif %}
					</a>
					{% if link.list %}
						<ul class="menu__dropdown">
							{% for item in link.list %}
								<li class="menu__dropdown-item">
									<a
										class="menu__dropdown-link h7 ttu"
										href="{{ item.url }}"
										{% if item.img %} data-menu-img-src="{{ item.img.src }}" data-menu-img-srcset="{{ item.img.srcset }}"{% endif %}
									>{{ item.text }}</a>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
				</li>
			{% endfor %}
		</ul>
	</nav>
	<ul class="menu__links">
		{% for link in menuLinks %}
			<li class="menu__links-item">
				<a
					class="menu__link h6 ttu"
					href="{{ link.url }}"
					{% if link.img %} data-menu-img-src="{{ link.img.src }}" data-menu-img-srcset="{{ link.img.srcset }}"{% endif %}
				>{{ link.text }}</a>
			</li>
		{% endfor %}
	</ul>
	<div class="menu__bg-wrapper">
		<img class="menu__bg-img" src="#" srcset="#" width="1024" height="819" alt="" data-menu-img>
	</div>
</div>
