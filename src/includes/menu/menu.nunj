{% from "../components/icon/icon.nunj" import icon %}

{% set navLinks = [
	{
		text: 'Магазин',
		img: { src: '/assets/images/menu/menu-shop.webp', srcset: '/assets/images/menu/menu-shop@2x.webp 2x' },
		url: '#',
		list1: [
			{ text: 'Все товары', url: '/catalog/' },
			{ text: 'Одежда', url: '/catalog/' },
			{ text: 'Лыжный туризм', url: '/catalog/' },
			{ text: 'Туристическое снаряжение', url: '/catalog/' },
			{ text: 'Книги', url: '/catalog/' },
			{ text: 'Обувь', url: '/catalog/' },
			{ text: 'Альпинистское снаряжение', url: '/catalog/' },
			{ text: 'Сноуборды', url: '/catalog/' },
			{ text: 'Горные лыжи', url: '/catalog/' }
		],
		list2: [
			{ text: 'Горный туризм', url: '/catalog/' },
			{ text: 'Треккинг', url: '/catalog/' },
			{ text: 'Трейлраннинг', url: '/catalog/' },
			{ text: 'Кемпинг', url: '/catalog/' },
			{ text: 'Высотный альпинизм', url: '/catalog/' },
			{ text: 'Веревочные парки и Via Ferrata', url: '/catalog/' },
			{ text: 'Скалолазание', url: '/catalog/' },
			{ text: 'Технический альпинизм', url: '/catalog/' },
			{ text: 'Горные лыжи', url: '/catalog/' },
			{ text: 'Городской стиль', url: '/catalog/' },
			{ text: 'Промышленный альпинизм', url: '/catalog/' },
			{ text: 'Спелеология', url: '/catalog/' },
			{ text: 'Фрирайд', url: '/catalog/' },
			{ text: 'Экспедиционные лыжи', url: '/catalog/' },
			{ text: 'Ледолазание', url: '/catalog/' },
			{ text: 'Ски-тур', url: '/catalog/' }
		]
	},
	{ text: 'Адреса', url: '/addresses.html', img: { src: '/assets/images/menu/menu-address.webp', srcset: '/assets/images/menu/menu-address@2x.webp 2x' } },
	{
		text: 'Сообщество',
		img: { src: '/assets/images/menu/menu-community.webp', srcset: '/assets/images/menu/menu-community@2x.webp 2x' },
		url: '#',
		list: [
			{ text: 'Горный клуб', url: '/community/', img: { src: '/assets/images/menu/menu-club.webp', srcset: '/assets/images/menu/menu-club@2x.webp 2x' } },
			{ text: 'Занятия', url: '/community/classes.html' },
			{ text: 'Трейлы', url: '/community/trails.html' },
			{ text: 'Фрирайд', url: '/community/freerides.html' }
		]
	},
	{ text: 'Прокат', url: '/rent.html', img: { src: '/assets/images/menu/menu-rent.webp', srcset: '/assets/images/menu/menu-rent@2x.webp 2x' } },
	{ text: 'Сервисы', url: '/services.html', img: { src: '/assets/images/menu/menu-service.webp', srcset: '/assets/images/menu/menu-service@2x.webp 2x' } },
	{ text: 'Новости', url: '/news.html', img: { src: '/assets/images/menu/menu-news.webp', srcset: '/assets/images/menu/menu-news@2x.webp 2x' } },
	{ text: 'О нас', url: '/about.html', img: { src: '/assets/images/menu/menu-about.webp', srcset: '/assets/images/menu/menu-about@2x.webp 2x' } }
] %}

{% set menuLinks = [
	{ text: 'Бренды', url: '/brands.html', img: { src: '/assets/images/menu/menu-brand.webp', srcset: '/assets/images/menu/menu-brand@2x.webp 2x' } },
	{ text: 'Дисконтная<br> программа', url: '/discount.html', img: { src: '/assets/images/menu/menu-delivery.webp', srcset: '/assets/images/menu/menu-delivery@2x.webp 2x' } },
	{ text: 'Экология', url: '/ecology.html', img: { src: '/assets/images/menu/menu-eco.webp', srcset: '/assets/images/menu/menu-eco@2x.webp 2x' } }
] %}

<div class="page__menu menu" data-menu>
	<div class="menu__top">
		<a href="/profile.html" class="menu__user-link ttu">
			{{ icon({
				iconName: 'user',
				className: 'menu__user-icon',
				attr: 'width="24" height="24"'
			}) }}
			Личный кабинет
		</a>
		<a href="/compare.html" class="menu__compare-link ttu">
			{{ icon({
				iconName: 'compare',
				className: 'menu__user-icon',
				attr: 'width="24" height="24"'
			}) }}
			Сравнения товаров
		</a>
		<button class="menu__location ttu" type="button" data-popup-opener="city-form">
			{{ icon({
				iconName: 'map-pin',
				className: 'menu__location-icon _map',
				attr: 'width="16" height="16"'
			}) }}
			Санкт - Петербург
			{{ icon({
				iconName: 'arrow-down',
				className: 'menu__location-icon _arrow',
				attr: 'width="16" height="16"'
			}) }}
		</button>
		<p class="menu__info p4">Звоните нам ежедневно с 9:00 до 21:00 или напишите нам:</p>
		<p class="menu__info-links h7">
			<a class="menu__tel" href="tel:88125283776">8 812 528 37 76</a>
			<a class="menu__tel" href="tel:88007751630">8 800 775 16 30</a>
			<a class="menu__mail" href="mailto:sale@alpindustria.ru">sale@alpindustria.ru</a>
		</p>
	</div>
	<nav class="menu__nav">
		<ul class="menu__nav-list">
			{% for link in navLinks %}
				<li class="menu__nav-item{% if link.list or link.list1 or link.list2 %} _dropdown{% endif %}">
					<a
						class="menu__nav-link ttu"
						href="{{ link.url }}"
						{% if link.list or link.list1 or link.list2 %} data-menu-accordion-toggle{% if link.opened %}="opened"{% endif %}{% endif %}
						{% if link.img %} data-menu-img-src="{{ link.img.src }}" data-menu-img-srcset="{{ link.img.srcset }}"{% endif %}
					>
						{{ link.text }}
						{% if link.list or link.list1 or link.list2 %}
							{{ icon({
								iconName: 'accordion-arrow',
								className: 'menu__accordion-icon',
								attr: 'width="32" height="32"'
							}) }}
						{% endif %}
					</a>
					{% if link.list %}
						<div data-menu-accordion-content>
							<ul class="menu__dropdown">
								{% for item in link.list %}
									<li class="menu__dropdown-item">
										<a
											class="menu__dropdown-link h7 ttu"
											href="{{ item.url }}"
											{% if item.img %} data-menu-img-src="{{ item.img.src }}" data-menu-img-srcset="{{ item.img.srcset }}"{% endif %}
										>{{ item.text }}</a>
									</li>
								{% endfor %}
							</ul>
						</div>
					{% endif %}

					{% if link.list1 or link.list2 %}
					<div data-menu-accordion-content>
						{% if link.list1 %}
							<div class="menu__catalog-accordion">
								<button type="button" data-menu-accordion-inner-toggle>
									Товары
									<svg width="32" height="32">
										<use xlink:href="#icon-accordion-arrow"></use>
									</svg>
								</button>
								<ul class="menu__dropdown _catalog" aria-label="Товары">
									{% for item in link.list1 %}
										<li class="menu__dropdown-item">
											<a
												class="menu__dropdown-link h7 ttu"
												href="{{ item.url }}"
												{% if item.img %} data-menu-img-src="{{ item.img.src }}" data-menu-img-srcset="{{ item.img.srcset }}"{% endif %}
											>{{ item.text }}</a>
										</li>
									{% endfor %}
								</ul>
							</div>
						{% endif %}

						{% if link.list2 %}
							<div class="menu__catalog-accordion">
								<button type="button" data-menu-accordion-inner-toggle>
									Активности
									<svg width="32" height="32">
										<use xlink:href="#icon-accordion-arrow"></use>
									</svg>
								</button>
								<ul class="menu__dropdown _catalog _activities" aria-label="Активности">
									{% for item in link.list2 %}
										<li class="menu__dropdown-item">
											<a
												class="menu__dropdown-link h7 ttu"
												href="{{ item.url }}"
												{% if item.img %} data-menu-img-src="{{ item.img.src }}" data-menu-img-srcset="{{ item.img.srcset }}"{% endif %}
											>{{ item.text }}</a>
										</li>
									{% endfor %}
								</ul>
							</div>
						{% endif %}
					</div>
					{% endif %}
				</li>
			{% endfor %}
		</ul>
	</nav>
	<ul class="menu__links">
		{% for link in menuLinks %}
			<li class="menu__links-item">
				<a
					class="menu__link h6 ttu"
					href="{{ link.url }}"
					{% if link.img %} data-menu-img-src="{{ link.img.src }}" data-menu-img-srcset="{{ link.img.srcset }}"{% endif %}
				>{{ link.text }}</a>
			</li>
		{% endfor %}
	</ul>
	<div class="menu__bg-wrapper">
		<img class="menu__bg-img" src="#" srcset="#" width="1024" height="819" alt="" data-menu-img>
	</div>
</div>
