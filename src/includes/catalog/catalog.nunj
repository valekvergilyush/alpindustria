<section class="page__catalog catalog">
	<div class="catalog__wrapper">
		<div class="catalog__filters-wrapper">
			{% include "../filters-form/filters-form.nunj" %}
		</div>
		<ul class="page__catalog-list catalog__list">
			{% for product in productList %}
				<li class="catalog__item">
					{{ productCard(product) }}
				</li>
			{% endfor %}
			<li class="catalog__item _promo-1">
				{% include "../catalog-promo/promo-1.nunj" %}
			</li>
			<li class="catalog__item catalog-promo _promo-2">
				{% include "../catalog-promo/promo-2.nunj" %}
			</li>
			<li class="catalog__item catalog-promo _promo-3">
				{% include "../catalog-promo/promo-3.nunj" %}
			</li>
		</ul>
	</div>
	{{ button({
		className: 'catalog__show-more-btn _show-more',
		text: 'Показать еще',
		icon: 'plus-circle',
		iconData: 'width="32" height="32"'
	}) }}
</section>
