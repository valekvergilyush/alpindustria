{% from "../components/button/button.nunj" import button %}

<section class="page__catalog catalog _no-results">
	<div class="catalog__wrapper">
		<div class="catalog__filters-wrapper">
			{% include "../filters-form/filters-form.nunj" %}
		</div>
		<ul class="page__catalog-list catalog__list">
			<li class="catalog__item _no-results">
				<p class="catalog__item-title h4 ttu">Товаров не&nbsp;найдено</p>
				<p class="p1">Попробуйте изменить параметры фильтров и попробовать еще раз</p>
			</li>
			<li class="catalog__item _empty">
				{% include "../catalog-promo/empty-card.nunj" %}
			</li>
			<li class="catalog__item _empty">
				{% include "../catalog-promo/empty-card.nunj" %}
			</li>
		</ul>
	</div>
	{{ button({
		className: 'catalog__show-more-btn _show-more',
		text: 'Показать еще',
		icon: 'plus-circle',
		iconData: 'width="32" height="32"',
		attr: 'disabled'
	}) }}
</section>
