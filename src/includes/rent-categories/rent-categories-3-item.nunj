{% from "../components/rent-category-card/rent-category-card.nunj" import rentCategoryCard %}
{% from "../components/icon/icon.nunj" import icon %}


{% set categories = [
	{ name: 'Снаряжение для скитура', count: 16, url: '/rent-by-call/category.html', src: '/assets/images/test-rent/bg-skitour.webp', src2x: '/assets/images/test-rent/bg-skitour@2x.webp 2x' },
	{ name: 'Одежда', count: 16, url: '/rent-by-call/category.html', src: '/assets/images/test-rent/bg-mountain.webp', src2x: '/assets/images/test-rent/bg-mountain@2x.webp 2x' },
	{ name: 'Обувь', count: 16, url: '/rent-by-call/category.html', src: '/assets/images/test-rent/bg-skitour.webp', src2x: '/assets/images/test-rent/bg-skitour@2x.webp 2x' }
] %}

<section class="rent-categories">
	<div class="activities__slider swiper" data-rent-categories>
		<ul class="swiper-wrapper" data-activities-slider>
			{% for item in categories %}
				<li class="activities__slide swiper-slide">
					<a href="#"><span class="activities__slide-name">{{ item.name }}</span></a>
					<picture class="activities__slide-img">
						<img src="{{ item.src }}" srcset="{{ item.src2x }}" width="360" height="480" alt="">
					</picture>
				</li>
			{% endfor %}
		</ul>

		<div class="swiper-pagination"></div>


		<button class="activities__button swiper-button-prev" type="button" aria-label="Previous">
			{{ icon({
				iconName: 'slider-arrow-left',
				attr: 'width="56" height="56"'
			}) }}
		</button>
		<button class="activities__button swiper-button-next" type="button" aria-label="Next">
			{{ icon({
				iconName: 'slider-arrow-right',
				attr: 'width="56" height="56"'
			}) }}
		</button>
	</div>
</section>

