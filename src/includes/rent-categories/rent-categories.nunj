{% from "../components/rent-category-card/rent-category-card.nunj" import rentCategoryCard %}

{% set categoryImages = [
	{ src: '/assets/images/test-rent/item-1.webp', srcset: '/assets/images/test-rent/item-1@2x.webp 2x' },
	{ src: '/assets/images/test-rent/item-1.webp', srcset: '/assets/images/test-rent/item-1@2x.webp 2x' },
	{ src: '/assets/images/test-rent/item-1.webp', srcset: '/assets/images/test-rent/item-1@2x.webp 2x' },
	{ src: '/assets/images/test-rent/item-1.webp', srcset: '/assets/images/test-rent/item-1@2x.webp 2x' }
] %}

{% set categories = [
	{ name: 'Туристическое снаряжение', count: 16, url: '/rent-by-call/category.html', images: categoryImages },
	{ name: 'Альпинистское снаряжение', count: 16, url: '/rent-by-call/category.html', images: categoryImages },
	{ name: 'Одежда', count: 16, url: '/rent-by-call/category.html', images: categoryImages },
	{ name: 'Обувь', count: 16, url: '/rent-by-call/category.html', images: categoryImages }
] %}

<section class="rent-categories">
	<div class="rent-categories__grid">
		{% for category in categories %}
			{% if not rentCategoriesLimit or loop.index <= rentCategoriesLimit %}
				<div class="rent-categories__item">
					{{ rentCategoryCard(category) }}
				</div>
			{% endif %}
		{% endfor %}
	</div>
</section>

