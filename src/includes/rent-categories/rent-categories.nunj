{% from "../components/rent-category-card/rent-category-card.nunj" import rentCategoryCard %}

{% set categoryImages = [
	{ src: '/assets/images/catalog/item-3.png', srcset: '/assets/images/catalog/item-3@2x.png 2x' },
	{ src: '/assets/images/catalog/item-1.png', srcset: '/assets/images/catalog/item-1@2x.png 2x' },
	{ src: '/assets/images/catalog/item-2.png', srcset: '/assets/images/catalog/item-2@2x.png 2x' },
	{ src: '/assets/images/catalog/item-4.png', srcset: '/assets/images/catalog/item-4@2x.png 2x' }
] %}

{% set categories = [
	{ name: 'Туристическое снаряжение', count: 16, url: '#', images: categoryImages },
	{ name: 'Альпинистское снаряжение', count: 16, url: '#', images: categoryImages },
	{ name: 'Одежда', count: 16, url: '#', images: categoryImages },
	{ name: 'Обувь', count: 16, url: '#', images: categoryImages }
] %}

<section class="rent-categories">
	<div class="rent-categories__grid">
		{% for category in categories %}
			<div class="rent-categories__item">
				{{ rentCategoryCard(category) }}
			</div>
		{% endfor %}
	</div>
</section>

