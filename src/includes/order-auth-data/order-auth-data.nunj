{% from "../components/icon/icon.nunj" import icon %}

<div class="order-auth-data">
	<div class="order-auth-data__data">
		<div class="order-auth-data__row">
			<div class="order-auth-data__title">ФИО</div>
			<div class="order-auth-data__value">Константин Константинопольский</div>
		</div>
		<div class="order-auth-data__row">
			<div class="order-auth-data__title">Почта</div>
			<div class="order-auth-data__value">konstantin@gmail.com</div>
		</div>
		<div class="order-auth-data__row">
			<div class="order-auth-data__title">Телефон</div>
			<div class="order-auth-data__value">+7 (902) 222 01 02</div>
		</div>
	</div>
	<div class="order-auth-data__bottom">
		<button class="order-auth-data__btn p3" type="button" data-edit-profile-data>
			<span>Изменить свои данные</span>
			{{ icon({
				iconName: 'pencil',
				className: 'order-auth-data__btn-icon',
				attr: 'width="24" height="24"'
			}) }}
		</button>
		<button class="order-auth-data__btn p3" type="button" data-auth-btn>
			<span>Авторизоваться под другим именем</span>
			{{ icon({
				iconName: 'user',
				className: 'order-auth-data__btn-icon',
				attr: 'width="24" height="24"'
			}) }}
		</button>
	</div>
</div>
