{% from "../components/icon/icon.nunj" import icon %}

{% set notificationImgs = [
	'/assets/images/catalog/item-3'
] %}

<div class="notification__content notification-cart">
	<div class="notification-cart__imgs">
		{% for img in notificationImgs %}
			<div class="notification-cart__img-wrap">
				<img class="notification-cart__img" src="{{ img }}.png" srcset="{{ img }}@2x.png 2x" width="356" height="415" alt="">
			</div>
		{% endfor %}
	</div>
	<div class="notification-cart__content">
		<p class="notification-cart__text p3">Добавлен в корзину:</p>
		<a href="#" class="notification-cart__link h7 ttu">
			Куртка The North Face M Dryzzle All Weather Jkt
			{{ icon({
				iconName: "promo-arrow",
				className: "notification-cart__link-icon",
				attr: 'width="18" height="18" viewBox="0 0 72 72"'
			}) }}
		</a>
	</div>
</div>
