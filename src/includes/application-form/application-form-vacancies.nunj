
{% from "../components/input/input.nunj" import input %}
{% from "../components/checkbox/checkbox-button.nunj" import checkboxButton %}
{% from "../components/checkbox/checkbox.nunj" import checkbox %}
{% from "../components/button/button.nunj" import button %}
{% from "../components/input-file/input-file.nunj" import inputFile %}

{% set hobbyList = [
	'Альпинизм',
	'Скалолазание',
	'Трейлраннинг',
	'Горный туризм',
	'Скандинавская ходьба',
	'Треккинг',
	'Ледолазание',
	'Горные лыжи',
	'Боулдеринг',
	'Хели-ски',
	'Фрирайд',
	'Ски-тур',
	'Кайтсерфинг/Виндсерфинг',
	'Пеший туризм',
	'Бег',
	'Парашютный спорт',
	'Водные походы',
	'Ориентирование',
	'Парапланеризм',
	'Дайвинг',
	'Сноуборд',
	'Спелеология',
	'Каякинг',
	'Мультиспорт'
] %}


<div class="application-form">
	<form class="application-form__form">
		{% include "../vacancies-choose/vacancies-choose.nunj" %}
		<p class="application-form__title h5 ttu c-gray-dark">Заполните анкету</p>
		<div class="application-form__fields">
			{{ input({
				type: 'text',
				id: 'application-form-name',
				className: 'application-form__input',
				name: 'Имя'
			}) }}
			{{ input({
				type: 'text',
				id: 'application-form-surname',
				className: 'application-form__input',
				name: 'Фамилия'
			}) }}
		</div>
		<div class="application-form__fields">
			{{ input({
				type: 'text',
				id: 'application-form-city',
				className: 'application-form__input',
				name: 'Город'
			}) }}
			{{ input({
				type: 'text',
				id: 'application-form-birthday',
				className: 'application-form__input',
				name: 'Дата рождения'
			}) }}
		</div>
		<div class="application-form__fields">
			{{ input({
				type: 'tel',
				id: 'application-form-tel',
				className: 'application-form__input',
				name: 'Телефон'
			}) }}
			{{ input({
				type: 'email',
				id: 'application-form-email',
				className: 'application-form__input',
				name: 'Почта'
			}) }}
		</div>
		<div class="application-form__fields">
			{{ input({
				type: 'text',
				id: 'application-form-about',
				className: 'application-form__input',
				name: 'Расскажите о себе'
			}) }}
		</div>
		{{ inputFile({
			className: 'application-form__input _file',
			id: 'application-form-file',
			name:'Прикрепите резюме',
			label:'Прикрепите резюме',
			accept: 'image/*'
		}) }}
		<p class="application-form__title h5 ttu c-gray-dark" id="hobby-list-label">Выберите Ваши увлечения</p>
		<ul class="application-form__hobbies c-blue-dark" aria-labelledby="hobby-list-label">
			{% for hobby in hobbyList %}
				<li class="application-form__hobbies-item">
					{{ checkboxButton({
						className: 'application-form__checkbox-btn',
						id: 'application-form-hobby-' + loop.index,
						label: hobby
					}) }}
				</li>
			{% endfor %}
		</ul>
		{{ checkbox({
			className: '_vacancies',
			id: 'vacancies-form-new-vacancies',
			name: 'new-vacancies',
			text: 'Я хочу получать информационную рассылку о новых вакансиях',
			checked: true
		}) }}
		{{ button({
			className: 'application-form__show-more-btn _show-more',
			text: 'Показать еще',
			icon: 'plus-circle',
			iconData: 'width="24" height="24"'
		}) }}

		<div class="application-form__bottom">
			<p class="application-form__bottom-text p3">Нажимая "Подать заявку", вы&nbsp;соглашаетесь с&nbsp;<a href="#">условиями оферты</a></p>
			{{ button({
				type: 'submit',
				text: 'Подать заявку',
				icon: 'promo-arrow',
				iconData: 'width="18" height="18"',
				className: 'application-form__submit _arrow'
			}) }}
		</div>
	</form>
</div>
