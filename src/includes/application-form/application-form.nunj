{% from "../components/input/input.nunj" import input %}
{% from "../components/checkbox/checkbox-button.nunj" import checkboxButton %}
{% from "../components/button/button.nunj" import button %}
{% from "../components/input-file/input-file.nunj" import inputFile %}

{% set hobbyList = [
	'Альпинизм',
	'Скалолазание',
	'Трейлраннинг',
	'Горный туризм',
	'Скандинавская ходьба',
	'Треккинг',
	'Ледолазание',
	'Горные лыжи',
	'Боулдеринг',
	'Хели-ски',
	'Фрирайд',
	'Ски-тур',
	'Кайтсерфинг/Виндсерфинг',
	'Пеший туризм',
	'Бег',
	'Парашютный спорт',
	'Водные походы',
	'Ориентирование',
	'Парапланеризм',
	'Дайвинг',
	'Сноуборд',
	'Спелеология',
	'Каякинг',
	'Мультиспорт'
] %}


<div class="application-form">
	{% include "../community-auth/community-auth.nunj" %}

	<p class="application-form__title h5 ttu c-gray-dark">Заполните анкету</p>
	<div data-validate>
		<form class="application-form__form">
			<div class="application-form__fields">
				{{ input({
					type: 'text',
					id: 'application-form-name',
					className: 'application-form__input _gray',
					name: 'Имя',
					label: 'Имя*',
					inputAttr: 'required',
					attr: 'data-validate-type="text"'
				}) }}
				{{ input({
					type: 'text',
					id: 'application-form-surname',
					className: 'application-form__input _gray',
					name: 'Фамилия',
					label: 'Фамилия*',
					inputAttr: 'required',
					attr: 'data-validate-type="text"'
				}) }}
			</div>
			<div class="application-form__fields">
				{{ input({
					type: 'text',
					id: 'application-form-city',
					className: 'application-form__input _gray',
					name: 'Город',
					label: 'Город*',
					inputAttr: 'required',
					attr: 'data-validate-type="text"'
				}) }}
				{{ input({
					type: 'text',
					id: 'application-form-birthday',
					className: 'application-form__input _gray',
					name: 'Дата рождения',
					label: 'Дата рождения*',
					inputAttr: 'required readonly data-datepicker',
					attr: 'data-validate-type="text"'
				}) }}
			</div>
			<div class="application-form__fields">
				{{ input({
					type: 'text',
					id: 'application-form-tel',
					className: 'application-form__input _gray',
					name: 'Телефон',
					label: 'Телефон*',
					inputAttr: 'required inputmode="tel"',
					attr: 'data-validate-type="phone"'
				}) }}
				{{ input({
					type: 'email',
					id: 'application-form-email',
					className: 'application-form__input _gray',
					name: 'Почта',
					label: 'Почта*',
					inputAttr: 'required',
					attr: 'data-validate-type="email"'
				}) }}
			</div>
			<div class="application-form__fields">
				{{ input({
					type: 'text',
					id: 'application-form-about',
					className: 'application-form__input _gray',
					name: 'Расскажите о себе'
				}) }}
			</div>
			<div class="application-form__fields">
				{{ input({
					type: 'text',
					id: 'application-form-exp',
					className: 'application-form__input _comment',
					name: 'Уже проходили занятия?',
					label: 'Уже проходили занятия в нашем Горном клубе? Напишите об этом'
				}) }}
			</div>
			{{ inputFile({
				className: 'application-form__input _file',
				id: 'application-form-file',
				name:'Прикрепите фото',
				label:'Прикрепите фото*',
				accept: 'image/*',
				inputAttr: 'required',
				attr: 'data-validate-type="text"'
			}) }}
			<p class="application-form__title h5 ttu c-gray-dark" id="hobby-list-label">Выберите Ваши увлечения*</p>
			<p class="application-form__hobbies-error-msg p4">Выберите увлечения</p>
			<ul class="application-form__hobbies c-blue-dark" aria-labelledby="hobby-list-label" data-validate-type="toggle-group">
				{% for hobby in hobbyList %}
					<li class="application-form__hobbies-item">
						{{ checkboxButton({
							className: 'application-form__checkbox-btn',
							id: 'application-form-hobby-' + loop.index,
							label: hobby
						}) }}
					</li>
				{% endfor %}
			</ul>
			{{ button({
				className: 'application-form__show-more-btn _show-more',
				text: 'Показать еще',
				icon: 'plus-circle',
				iconData: 'width="24" height="24"'
			}) }}
			<p class="application-form__bottom-text p3 _mobile">Нажимая "Зарегистрироваться", вы&nbsp;соглашаетесь с&nbsp;<a href="#" data-popup-opener="offer">условиями оферты</a></p>
			<div class="application-form__bottom">
				<p class="application-form__bottom-text p3">Нажимая "Зарегистрироваться", вы&nbsp;соглашаетесь с&nbsp;<a href="#" data-popup-opener="offer">условиями оферты</a></p>
				{{ button({
					type: 'submit',
					text: 'Зарегистрироваться',
					icon: 'promo-arrow',
					iconData: 'width="18" height="18"',
					className: 'application-form__submit _arrow'
				}) }}
			</div>
		</form>
	</div>
</div>
