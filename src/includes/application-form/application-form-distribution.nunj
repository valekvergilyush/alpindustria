{% from "../components/input/input.nunj" import input %}
{% from "../components/checkbox/checkbox-button.nunj" import checkboxButton %}
{% from "../components/button/button.nunj" import button %}
{% from "../components/input-file/input-file.nunj" import inputFile %}
{% from "../components/checkbox/checkbox.nunj" import checkbox %}

{% set hobbyList = [
	'Альпинизм',
	'Скалолазание',
	'Трейлраннинг',
	'Горный туризм',
	'Скандинавская ходьба',
	'Треккинг',
	'Ледолазание',
	'Горные лыжи',
	'Боулдеринг',
	'Хели-ски',
	'Фрирайд',
	'Ски-тур',
	'Кайтсерфинг/Виндсерфинг',
	'Пеший туризм',
	'Бег',
	'Парашютный спорт',
	'Водные походы',
	'Ориентирование',
	'Парапланеризм',
	'Дайвинг',
	'Сноуборд',
	'Спелеология',
	'Каякинг',
	'Мультиспорт'
] %}


<div class="application-form _distribution" data-validate>
	<p class="application-form__title h5 ttu c-gray-dark">Заполните анкету</p>
	<form class="application-form__form">
		<p class="application-form__form-title h7 ttu c-gray-dark">Компания</p>
		<div class="application-form__fields">
			{{ input({
				type: 'text',
				id: 'application-form-company',
				className: 'application-form__input _gray',
				name: 'Компания',
				label: 'Компания*',
				inputAttr: 'required',
				attr: 'data-validate-type="text"'
			}) }}
			{{ input({
				type: 'text',
				id: 'application-form-city',
				className: 'application-form__input _gray',
				name: 'Город',
				label: 'Город*',
				inputAttr: 'required',
				attr: 'data-validate-type="text"'
			}) }}
		</div>
		<div class="application-form__fields">
			{{ input({
				type: 'text',
				id: 'application-form-activity',
				className: 'application-form__input _gray',
				name: 'Сфера деятельности',
				label: 'Сфера деятельности*',
				inputAttr: 'required',
				attr: 'data-validate-type="text"'
			}) }}
		</div>
		<div class="application-form__fields">
			{{ input({
				type: 'text',
				id: 'application-form-store-address',
				className: 'application-form__input _gray',
				name: 'Адрес магазина'
			}) }}
		</div>

		<p class="application-form__form-title h7 ttu c-gray-dark">Реквизиты</p>
		<div class="application-form__fields">
			{{ input({
				type: 'text',
				id: 'application-form-name',
				className: 'application-form__input _gray',
				name: 'Юридическое название компании'
			}) }}
		</div>
		<div class="application-form__fields">
			{{ input({
				type: 'text',
				id: 'application-form-address',
				className: 'application-form__input _gray',
				name: 'Юридический адрес'
			}) }}
		</div>
		<div class="application-form__fields">
			{{ input({
				type: 'text',
				id: 'application-form-inn',
				className: 'application-form__input _gray',
				name: 'ИНН',
				label: 'ИНН*',
				inputAttr: 'required',
				attr: 'data-validate-type="text"'
			}) }}
		</div>

		{{ inputFile({
			className: 'application-form__input _file _gray',
			id: 'application-form-file',
			name:'Загрузите карточку компании',
			label:'Загрузите карточку компании',
			accept: 'image/*'
		}) }}

		<p class="application-form__form-title h7 ttu c-gray-dark">Контактное лицо</p>
		<div class="application-form__fields">
			{{ input({
				type: 'text',
				id: 'application-form-fio',
				className: 'application-form__input _gray',
				name: 'ФИО',
				label: 'ФИО*',
				inputAttr: 'required',
				attr: 'data-validate-type="text"'
			}) }}
			{{ input({
				type: 'text',
				id: 'application-form-job-title',
				className: 'application-form__input _gray',
				name: 'Должность',
				label: 'Должность*',
				inputAttr: 'required',
				attr: 'data-validate-type="text"'
			}) }}
		</div>
		<div class="application-form__fields">
			{{ input({
				type: 'tel',
				id: 'application-form-tel',
				className: 'application-form__input _gray',
				name: 'Телефон',
				label: 'Телефон*',
				inputAttr: 'required',
				attr: 'data-validate-type="phone"'
			}) }}
			{{ input({
				type: 'email',
				id: 'application-form-email',
				className: 'application-form__input _gray',
				name: 'Почта',
				label: 'Почта*',
				inputAttr: 'required',
				attr: 'data-validate-type="email"'
			}) }}
		</div>

		<p class="application-form__title _brand h5 ttu c-gray-dark" id="hobby-list-label">Какие бренды вас интересуют*</p>
		<p class="application-form__hobbies-error-msg p4">Выберите бренды</p>
		<ul class="application-form__hobbies c-blue-dark" aria-labelledby="hobby-list-label" data-validate-type="toggle-group">
			{% for hobby in hobbyList %}
				<li class="application-form__hobbies-item">
					{{ checkboxButton({
						className: 'application-form__checkbox-btn',
						id: 'application-form-hobby-' + loop.index,
						label: hobby
					}) }}
				</li>
			{% endfor %}
		</ul>
		{{ button({
			className: 'application-form__show-more-btn _show-more',
			text: 'Показать еще',
			icon: 'plus-circle',
			iconData: 'width="24" height="24"'
		}) }}

		{{ checkbox({
			className: 'application-form__email-checkbox',
			id: 'application-form-email-info',
			name: 'Хочу получать информационную рассылку',
			text: 'Я хочу получать информационную рассылку оптового отдела',
			checked: true
		}) }}

		<p class="application-form__bottom-text p3 _mobile">Нажимая "подать заявку", вы&nbsp;соглашаетесь с&nbsp;<a href="#" data-popup-opener="offer">условиями оферты</a></p>

		<div class="application-form__bottom">
			<p class="application-form__bottom-text p3">Нажимая "подать заявку", вы&nbsp;соглашаетесь с&nbsp;<a href="#" data-popup-opener="offer">условиями оферты</a></p>
			{{ button({
				type: 'submit',
				text: 'Подать заявку',
				icon: 'promo-arrow',
				iconData: 'width="18" height="18"',
				className: 'application-form__submit _arrow'
			}) }}
		</div>
	</form>
</div>
