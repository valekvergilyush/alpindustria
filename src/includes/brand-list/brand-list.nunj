{% from "../components/icon/icon.nunj" import icon %}

{% set brandList = [
	{
		name: 'PackTowl',
		src: '/assets/images/brand-logos/pack-towl.svg'
	},
	{
		name: 'Snow Peak',
		src: '/assets/images/brand-logos/snow-peak.png',
		srcset: '/assets/images/brand-logos/snow-peak@2x.png 2x'
	},
	{
		name: 'Therm-A-Rrest',
		src: '/assets/images/brand-logos/thermarest.png',
		srcset: '/assets/images/brand-logos/thermarest@2x.png 2x'
	},
	{
		name: 'The North Face',
		className: '_wide',
		src: '/assets/images/brand-logos/the-north-face.svg'
	},
	{
		name: 'Salomon',
		className: '_wide',
		src: '/assets/images/brand-logos/salomon.svg'
	},
	{
		name: 'MSR',
		src: '/assets/images/brand-logos/msr.svg'
	},
	{
		name: 'Arcteryx',
		src: '/assets/images/brand-logos/arcteryx.png',
		srcset: '/assets/images/brand-logos/arcteryx@2x.png 2x'
	}
] %}

<section class="brand-list" id="brands">
	<h2 class="brand-list__title page__section-title h4 ttu">Бренды</h2>
	<ul class="brand-list__list">
		{% for item in brandList %}
			<li class="brand-list__item{% if item.className %} {{ item.className }}{% endif %}">
				<a class="brand-list__link" href="#">
					<img class="brand-list__link-img" src="{{ item.src }}"{% if item.srcset %} srcset="{{ item.srcset }}"{% endif %} width="200" alt="{{ item.name }}">
				</a>
			</li>
		{% endfor %}
		<li class="brand-list__item">
			<a class="brand-list__link _all h7 ttu" href="/brands.html">
				Все бренды
				{{ icon({
					iconName: 'promo-arrow-filled',
					className: 'brand-list__link-icon',
					attr: 'width="16" height="16"'
				}) }}
			</a>
		</li>
	</ul>
</section>
