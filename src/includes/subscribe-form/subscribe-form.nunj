{% from "../components/input/input.nunj" import input %}
{% from "../components/button/button.nunj" import button %}

<form class="footer__subscribe subscribe-form">
	{{ input({
		type: 'email',
		id: 'subscribe-form-email',
		className: 'subscribe-form__input _c-white',
		name: 'Почта',
		inputAttr: 'autocomplete="off"'
	}) }}
	{{ button({
		type: 'submit',
		text: 'Подписаться',
		icon: 'promo-arrow-filled',
		iconData: 'width="18" height="18"',
		className: 'subscribe-form__submit ttu'
	}) }}
</form>
