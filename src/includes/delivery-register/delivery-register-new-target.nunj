{% from "../components/input/input.nunj" import input %}
{% from "../components/checkbox/checkbox.nunj" import checkbox %}
{% from "../components/button/button.nunj" import button %}
{% from "../components/input-date/input-date.nunj" import inputDate %}
{% from "../components/input-time/input-time.nunj" import inputTime %}
{% from "../components/radio/radio-button.nunj" import radioButton %}

<form class="delivery-register _new-user">
	<div class="delivery-register__fields">
		{{ input({
			type: 'text',
			id: 'delivery-register-new-target-name',
			name: 'Имя',
			label: 'Имя*',
			inputAttr: 'required',
			attr: 'data-validate-type="text"',
			className: 'delivery-register__input _gray'
		}) }}
		{{ input({
			type: 'text',
			id: 'delivery-register-new-target-surname',
			name: 'Фамилия',
			label: 'Фамилия*',
			inputAttr: 'required',
			attr: 'data-validate-type="text"',
			className: 'delivery-register__input _gray'
		}) }}
	</div>
	<div class="delivery-register__fields">
		{{ input({
			type: 'text',
			id: 'delivery-register-new-target-tel',
			name: 'Телефон',
			label: 'Телефон*',
			className: 'delivery-register__input _gray',
			inputAttr: 'required inputmode="tel"',
			attr: 'data-validate-type="phone"'
		}) }}
		{{ input({
			type: 'email',
			id: 'delivery-register-new-target-email',
			name: 'Почта',
			label: 'Почта*',
			inputAttr: 'required',
			attr: 'data-validate-type="email"',
			className: 'delivery-register__input _gray'
		}) }}
	</div>
	{{ checkbox({
		className: 'delivery-register__checkbox _datetime',
		id: 'delivery-register-new-target-checkbox',
		name: 'has-datetime',
		text: 'Прислать карту в определенное время',
		inputAttr: 'data-datetime-checkbox'
	}) }}
	<div class="delivery-register__fields _datetime">
		{{ inputDate({
			name: 'Дата',
			label: 'Дата',
			id: 'delivery-date-input-target',
			className: 'delivery-register__input',
			inputAttr: 'data-min-date="today"'
		}) }}
		{{ inputTime({
			name: 'Время',
			label: 'Время',
			id: 'delivery-time-input-target',
			value: '19:00',
			className: 'delivery-register__input'
		}) }}
	</div>

	<div class="delivery-register__fields _radio">
		{{ radioButton({
			id: 'delivery-register-new-target-radio-1',
			className: 'delivery-register__radio',
			name: 'delivery-type',
			value: 'email',
			text: 'Отправить на почту',
			checked: true
		}) }}
		{{ radioButton({
			id: 'delivery-register-new-target-radio-2',
			className: 'delivery-register__radio',
			name: 'delivery-type',
			value: 'sms',
			text: 'Отправить по СМС'
		}) }}
	</div>
</form>
