{% from "../components/input/input.nunj" import input %}
{% from "../components/checkbox/checkbox.nunj" import checkbox %}
{% from "../components/button/button.nunj" import button %}

<form class="cart-delivery__register-form delivery-register _new-user">
	<p class="delivery-register__title h7 ttu">Новым покупателям:</p>
	<div class="delivery-register__fields">
		{{ input({
			type: text,
			id: 'delivery-register-name',
			name: 'Имя',
			className: 'delivery-register__input _gray'
		}) }}
		{{ input({
			type: text,
			id: 'delivery-register-surname',
			name: 'Фамилия',
			className: 'delivery-register__input _gray'
		}) }}
	</div>
	<div class="delivery-register__fields">
		{{ input({
			type: email,
			id: 'delivery-register-email',
			name: 'Почта',
			className: 'delivery-register__input _gray'
		}) }}
		{{ input({
			type: 'tel',
			id: 'delivery-register-tel',
			name: 'Телефон',
			className: 'delivery-register__input _gray',
			attr: 'data-validate-type="phone"'
		}) }}
	</div>
	{{ checkbox({
		className: 'delivery-register__checkbox',
		id: 'legal-entity-checkbox',
		name: 'legal-entity',
		text: 'Я являюсь юридическим лицом',
		inputAttr: 'data-legal-checkbox'
	}) }}
	<div class="delivery-register__legal hidden" data-legal-block>
		<p class="delivery-register__legal-text p4 c-gray-dark">Работаем без НДС</p>
		<div class="delivery-register__fields _legal">
			{{ input({
				type: text,
				id: 'delivery-register-organisation-name',
				name: 'Название организации',
				className: 'delivery-register__input _gray'
			}) }}
			{{ input({
				type: number,
				id: 'delivery-register-settlement-account',
				name: 'Р/С',
				className: 'delivery-register__input _gray'
			}) }}
		</div>
		<div class="delivery-register__fields _legal">
			{{ input({
				type: text,
				id: 'delivery-register-legal-address',
				name: 'Юридический адрес',
				className: 'delivery-register__input _gray'
			}) }}
			{{ input({
				type: number,
				id: 'delivery-register-correspondent-account',
				name: 'К/С',
				className: 'delivery-register__input _gray'
			}) }}
		</div>
		<div class="delivery-register__fields _legal">
			{{ input({
				type: number,
				id: 'delivery-register-inn',
				name: 'ИНН',
				className: 'delivery-register__input _gray'
			}) }}
			{{ input({
				type: number,
				id: 'delivery-register-kpp',
				name: 'КПП',
				className: 'delivery-register__input _gray'
			}) }}
		</div>
		<div class="delivery-register__fields _legal">
			{{ input({
				type: text,
				id: 'delivery-register-bank',
				name: 'Полное наименование банка',
				className: 'delivery-register__input _gray'
			}) }}
			{{ input({
				type: number,
				id: 'delivery-register-bik',
				name: 'БИК',
				className: 'delivery-register__input _gray'
			}) }}
		</div>
	</div>
</form>
