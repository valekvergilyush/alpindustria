{% from "../components/icon/icon.nunj" import icon %}
{% from "../components/add-to-cart/add-to-cart.nunj" import addToCart %}
{% from "../components/class-person/class-person.nunj" import classPerson %}
{% from "../components/checkbox/checkbox.nunj" import checkbox %}
{% from "../components/file-download/file-download.nunj" import fileDownload %}

{% set classCheckboxList = [
	{
		text: 'Каска (должна надеваться на шапку)',
		checked: true
	},
	{
		text: 'Система (должна регулироваться на штаны штормовые)',
		checked: true
	},
	{
		text: 'Страховочное устройство Реверсо',
		checked: true
	},
	{
		text: 'Карабины с муфтой, лучше грушевидные (тип HMS), как этот — 8 шт.',
		checked: false
	},
	{
		text: 'Самостраховка — 2 уса из динамической верёвки',
		checked: false
	},
	{
		text: 'Репшнур 7 мм (6 м) — 2 шт.',
		checked: false
	},
	{
		text: 'Репшнур 7 мм (1,5 м)',
		checked: false
	},
	{
		text: 'Кошки, подходящие под ботинки, с чехлом',
		checked: false
	},
	{
		text: 'Ледоруб прямой классический',
		checked: false
	},
	{
		text: 'Палки треккинговые',
		checked: false
	},
	{
		text: 'Очки солнцезащитные для альпинизма',
		checked: false
	},
	{
		text: 'Крем солнцезащитный с высоким фактором',
		checked: false
	},
	{
		text: 'Фонарь налобный с батарейками (2-3 комплекта)',
		checked: true
	},
	{
		text: 'Рюкзак основной 70-100 л',
		checked: false
	},
	{
		text: 'Аптечка с личными препаратами + бинты, пластырь и активированный уголь',
		checked: false
	}
] %}
{% set classCheckboxList2 = [
	{
		text: 'Толстый туристический коврик (пенка/каремат)',
		checked: true
	},
	{
		text: 'Спальник тёплый с температурой комфорта -10°C',
		checked: false
	},
	{
		text: 'Кружка, миска, ложка',
		checked: false
	}
] %}
{% set classCheckboxList3 = [
	{
		text: 'Альпинистские ботинки под кошки, высокие однослойные',
		checked: false
	},
	{
		text: 'Куртка штормовая, мембранная',
		checked: false
	},
	{
		text: 'Штаны штормовые, мембранные',
		checked: false
	},
	{
		text: 'Штаны тонкие полар',
		checked: false
	},
	{
		text: 'Шапка тёплая',
		checked: false
	},
	{
		text: 'Футболки',
		checked: false
	},
	{
		text: 'Пуховка лёгкая',
		checked: true
	},
	{
		text: 'Перчатки полар или виндблок — 2-3 пары',
		checked: false
	},
	{
		text: 'Перчатки для работы с верёвкой',
		checked: false
	},
	{
		text: 'Верхонки из водостойкой ткани (перчатки или рукавицы)',
		checked: false
	},
	{
		text: 'Носки тонкие треккинг высокие — 3 пары',
		checked: false
	},
	{
		text: 'Носки толстые треккинг высокие — 1-2 пары',
		checked: false
	},
	{
		text: 'Носки шерстяные — 1 пара',
		checked: true
	},
	{
		text: 'Пара кроссовок для бега (каждое утро мы начинаем с зарядки и пробежки) и лагеря',
		checked: false
	},
	{
		text: 'Сандалии или шлепанцы для лагеря',
		checked: false
	},
	{
		text: 'Лёгкие брюки для треккинга и лазания',
		checked: false
	},
	{
		text: 'Термобелье (на верх и на низ)',
		checked: false
	},
	{
		text: 'Гамаши',
		checked: false
	}
] %}
{% set classCheckboxList4 = [
	{
		text: 'Рюкзак штурмовой 30-50 л',
		checked: false
	},
	{
		text: 'Наручные водостойкие часы',
		checked: true
	},
	{
		text: 'Накидка на рюкзак от дождя',
		checked: false
	},
	{
		text: 'Блокнот с ручкой',
		checked: false
	},
	{
		text: 'Термос',
		checked: true
	},
	{
		text: 'Скальные туфли и мешочек с магнезией, если есть желание побольше полазить',
		checked: false
	},
	{
		text: 'Складной нож',
		checked: false
	},
	{
		text: 'Зажигалка (кремний) — 1-2 шт.',
		checked: false
	},
	{
		text: 'Дождевик',
		checked: false
	},
	{
		text: 'Бафф',
		checked: false
	},
	{
		text: 'Шапку под каску (подшлемник)',
		checked: false
	},
	{
		text: 'Перчатки или рукавицы из водостойкого материала',
		checked: false
	},
	{
		text: 'Запасная пара шерстяных носков',
		checked: true
	},
	{
		text: 'Пожалуйста, не забудьте взять с собой аптечку с медикаментами, которыми вы пользуетесь, подходящим вам обезболивающим и перевязочными средствами',
		checked: false
	}
] %}
{% set classAccordions = [
	{
		name: 'Паспорт и пропуск',
		opened: false
	},
	{
		name: 'Заверенная медицинская справка',
		opened: true
	},
	{
		name: 'Страховка на весь срок сборов',
		opened: false
	}
] %}
{% set classAccordions2 = [
	{
		name: 'Когда нужно оплатить?',
		opened: false
	},
	{
		name: 'Какой должен быть уровень подготовки?',
		opened: false
	},
	{
		name: 'Если я не участник горного клуба?',
		opened: false
	},
	{
		name: 'Будет ли скидка для компании?',
		opened: false
	}
] %}

<section class="class" data-class>
	<div class="class__main">
		<div class="class__main-wrap">
			{% include "../class-main/class-main.nunj" %}
		</div>
		{{ addToCart({
			className: 'class__price-block',
			list: [
				{
					text: 'Стоимость участия:',
					price: '145 000 ₽'
				}
			],
			link: {
				text: 'Записаться',
				url: '#appointment-form'
			}
		}) }}
	</div>
	<div class="class__slider">
		{% include "../class-slider/class-slider.nunj" %}
	</div>
	<div class="class__content">
		<div class="class__block">
			<p class="class__title h5 ttu">О выезде</p>
			<div class="class__text p2 c-gray-dark">
				<p>В&nbsp;России гор много, но&nbsp;для того, чтобы познакомиться с&nbsp;альпинизмом, нет места лучше, чем Безенги. Культовый район, куда раньше пускали только избранных, сейчас открыт для всех. Здесь всё по-настоящему: настоящие высокие горы, настоящие люди, настоящий альпинизм! И&nbsp;если вы&nbsp;хотите понять, что это такое, надо ехать в&nbsp;Безенги.</p>
				<p>Безенги&nbsp;&mdash; район для самых сложных альпинистских восхождений на&nbsp;территории России, но&nbsp;в&nbsp;то&nbsp;же время здесь есть всё, что нужно новичку. Благодаря дирекции и&nbsp;персоналу альплагеря в&nbsp;Безенги удалось не&nbsp;только сохранить дух и&nbsp;лучшие традиции советского альпинизма, но&nbsp;и&nbsp;создать все условия для комфортного размещения в&nbsp;течение смены. Ну&nbsp;а&nbsp;что касается опыта, который вы&nbsp;получите, здесь можно вспомнить фразу, которую любят повторять многие инструкторы: &laquo;Есть значок &bdquo;Альпинист России&ldquo;, а&nbsp;есть значок &bdquo;Альпинист России&ldquo;, полученный в&nbsp;Безенги&raquo;.</p>
			</div>
		</div>
		<div class="class__block">
			<p class="class__title h5 ttu">Для кого этот выезд</p>
			<div class="class__inner">
				<div class="class__text p2 c-gray-dark">
					<p>УТС в&nbsp;альплагере Безенги&nbsp;&mdash; это продолжение программы обучения в&nbsp;Горном клубе. УТС предназначены участникам, прошедшим начальную подготовку на&nbsp;базе клуба в&nbsp;городе (пройден минимум один из&nbsp;перечисленных ниже вариантов):</p>
				</div>
				<a href="#" class="class__link h7 ttu">
					Курс «Введение в альпинизм» в Москве
					{{ icon({
						iconName: 'promo-arrow',
						className: 'class__link-icon',
						attr: 'width="16" height="16" viewBox="0 0 72 72"'
					}) }}
				</a>
				<a href="#" class="class__link h7 ttu">
					Курс «Введение в альпинизм Плюс» в Москве
					{{ icon({
						iconName: 'promo-arrow',
						className: 'class__link-icon',
						attr: 'width="16" height="16" viewBox="0 0 72 72"'
					}) }}
				</a>
			</div>
		</div>
		<div class="class__block">
			<p class="class__title h5 ttu">Как записаться на выезд</p>
			<ol class="class__list h6">
				<li class="class__list-item">
					<p class="p2 c-gray-dark">Жмите на&nbsp;кнопку &laquo;записаться&raquo;, обязательно укажите, какие именно занятия и&nbsp;курсы были пройдены</p>
				</li>
				<li class="class__list-item">
					<p class="p2 c-gray-dark">Далее если вы&nbsp;уверены, что поедете с&nbsp;нами на&nbsp;выезд, то&nbsp;можете вносить предоплату</p>
				</li>
			</ol>
		</div>
		<div class="class__block">
			<p class="class__title h5 ttu">Стоимость</p>
			<div class="class__price c-gray-dark">
				<div class="class__price-item">
					<p class="p2">Наличными</p>
					<p class="h7">28 000 ₽</p>
				</div>
				<div class="class__price-item">
					<p class="p2">Предоплата на сайте</p>
					<p class="h7">2 000 ₽</p>
				</div>
				<div class="class__price-item _total">
					<p class="p2">Общая стоимость</p>
					<p class="h6 c-blue-dark">30 000 ₽</p>
				</div>
			</div>
		</div>
		<div class="class__block">
			<p class="class__title h5 ttu">Наши инструкторы</p>
			<div class="class__text p2 c-gray-dark">
				<p>Альпсборы в&nbsp;Безенги проходят под руководством инструкторов Федерации альпинизма России. Это значит, что инструкторы прошли аттестацию, обладают необходимым опытом в&nbsp;альпинизме и&nbsp;инструкторской работе и&nbsp;точно имеют право вас обучать. Ну&nbsp;а&nbsp;знания и&nbsp;навыки, которые они вам передают, современные и&nbsp;соответствуют российским и&nbsp;международным стандартам.</p>
				<p>Иван Аленцев не&nbsp;только аттестованный инструктор альпинизма, но&nbsp;и&nbsp;тренер Центральной школы инструкторов, а&nbsp;значит тот человек, который обучает будущих инструкторов. Кроме того Иван&nbsp;&mdash; старший методист Всероссийских специализированных учебно-тренировочных сборов по&nbsp;подготовке альпинистов-спасателей Жетон &laquo;Спасение в&nbsp;горах&raquo;.</p>
				<p>Андриян Спичка&nbsp;&mdash; инструктор UIAA (ENEQ), инструктор альпинизма&nbsp;II категории ФАР, преподаватель Центральной школы инструкторов альпинизма и&nbsp;УТС Жетон &laquo;Спасение в&nbsp;горах&raquo;, участник и&nbsp;руководитель ряда сложных восхождений и&nbsp;походов на&nbsp;Кавказе, Памире и&nbsp;Фанских горах.</p>
				<p>Наши инструкторы уже не&nbsp;в&nbsp;первый раз будут вместе руководить альпинистскими сборами, а&nbsp;значит участников ждёт сработанная команда наставников :)</p>
			</div>
			<div class="class__persons">
				{{ classPerson({
					className: 'class__person',
					img: '/assets/images/article/article-img-2',
					name: 'Иван Аленцев',
					text: 'Старший инструктор по&nbsp;альпинизму Горного&nbsp;клуба АльпИндустрия. Инструктор альпинизма ФАР II&nbsp;категории. Тренер Центральной школы инструкторов. Тренер УТС &laquo;Спасение в&nbsp;горах&raquo;. КМС по&nbsp;альпинизму.'
				}) }}
				{{ classPerson({
					className: 'class__person',
					img: '/assets/images/classes/class-person',
					name: 'Андриян Спичка',
					text: 'Инструктор альпинизма ФАР II&nbsp;категории. Тренер Центральной школы инструкторов. Тренер УТС &laquo;Спасение в&nbsp;горах&raquo;. КМС по&nbsp;альпинизму.'
				}) }}
			</div>
		</div>
		<div class="class__block">
			<p class="class__title-block">
				<span class="class__title h5 ttu">Приблизительный список необходимого снаряжения</span>
				<span class="p3">(будет обговариваться на собрании перед выездом)</span>
			</p>
			<p class="p3 c-gray-dark">Будет всё необходимое клубное общественное скальное снаряжение (верёвки, петли, оттяжки, камалоты и&nbsp;закладки и&nbsp;прочее).</p>
			<p class="class__title-2 h6 ttu">Ниже вы&nbsp;можете отметить имеющееся оборудование и&nbsp;скачать список</p>
			<div>
				<div class="class__checkboxes">
					<p class="class__checkboxes-title h7 ttu">Каждому участнику нужно иметь обязательное личное сертифицированное снаряжение:</p>
					<ul class="class__checkboxes-list">
						{% for item in classCheckboxList %}
							<li>
								{{ checkbox({
									text: item.text,
									id: 'class-check-1-' + loop.index,
									checked: item.checked
								}) }}
							</li>
						{% endfor %}
					</ul>
				</div>
				<div class="class__checkboxes">
					<p class="class__checkboxes-title h7 ttu">Бивачное снаряжение:</p>
					<ul class="class__checkboxes-list">
						{% for item in classCheckboxList2 %}
							<li>
								{{ checkbox({
									text: item.text,
									id: 'class-check-2-' + loop.index,
									checked: item.checked
								}) }}
							</li>
						{% endfor %}
					</ul>
				</div>
				<div class="class__checkboxes">
					<p class="class__checkboxes-title h7 ttu">Одежда:</p>
					<ul class="class__checkboxes-list">
						{% for item in classCheckboxList3 %}
							<li>
								{{ checkbox({
									text: item.text,
									id: 'class-check-3-' + loop.index,
									checked: item.checked
								}) }}
							</li>
						{% endfor %}
					</ul>
				</div>
				<div class="class__checkboxes">
					<p class="class__checkboxes-title h7 ttu">Дополнительно рекомендуем взять с собой:</p>
					<ul class="class__checkboxes-list">
						{% for item in classCheckboxList4 %}
							<li>
								{{ checkbox({
									text: item.text,
									id: 'class-check-4-' + loop.index,
									checked: item.checked
								}) }}
							</li>
						{% endfor %}
					</ul>
				</div>
			</div>
			<div class="class__file">
				<p class="p3 c-gray-dark">Скачать список оборудования</p>
				{{ fileDownload({
					url: 'https://alpindustria.ru/i/files/531_1593094301.jpg',
					name: 'file_namea_goes_here.pdf',
					size: '165.7 KB'
				}) }}
			</div>
		</div>
		<div class="class__block">
			<p class="class__title h5 ttu">Необходимые документы</p>
			<ul class="class-accordions _ordered">
				{% for item in classAccordions %}
					<li class="class-accordions__item" data-accordion-section>
						<button class="class-accordions__btn h6 {% if item.opened %} _opened{% endif %}" type="button" data-accordion-title>
							<span class="class-accordions__name p1 c-gray-dark" data-accordion-title-text>{{ item.name }}</span>
							{{ icon({
								iconName: 'accordion-arrow',
								className: 'class-accordions__btn-icon',
								attr: 'viewBox="0 0 16 16" width="16" height="16"'
							}) }}
						</button>
						<div class="class-accordions__content" data-accordion-content>
							<div class="class-accordions__inner">
								<p class="p3 c-gray-dark">Справка должна подтверждать, что вы&nbsp;не&nbsp;имеете противопоказаний для занятий альпинизмом, быть заверена врачом и&nbsp;печатью поликлиники или диспансера. В&nbsp;справке должно быть указано: &laquo;Допущен(-а) к&nbsp;занятиям альпинизмом. Противопоказаний к&nbsp;нахождению в&nbsp;условиях высокогорья (среднегорья) не&nbsp;выявлено&raquo;. Справка обязательна.</p>
							</div>
						</div>
					</li>
				{% endfor %}
			</ul>
			<div class="class__file">
				<p class="p3 c-gray-dark">Скачать список документов</p>
				{{ fileDownload({
					url: 'https://alpindustria.ru/i/files/531_1593094301.jpg',
					name: 'file_namea_goes_here.pdf',
					size: '165.7 KB'
				}) }}
			</div>
		</div>
		<div class="class__block">
			<p class="class__title h5 ttu">Организация сборов</p>
			<div class="class__text p3 c-gray-dark">
				<p>Проживание в&nbsp;альплагере Безенги<br>В&nbsp;альплагере предусмотрены разные варианты проживания, на&nbsp;любой уровень комфорта и&nbsp;бюджет (стоимость с&nbsp;человека в&nbsp;день):</p>
				<p>Подробно о&nbsp;проживании и&nbsp;питании смотрите на&nbsp;сайте альплагеря.</p>
			</div>
		</div>
		<div class="class__block">
			<p class="class__title h5 ttu">Частые вопросы</p>
			<ul class="class-accordions _uppercase">
				{% for item in classAccordions2 %}
					<li class="class-accordions__item c-gray-dark" data-accordion-section>
						<button class="class-accordions__btn {% if item.opened %} _opened{% endif %}" type="button" data-accordion-title>
							<span class="class-accordions__name p1" data-accordion-title-text>{{ item.name }}</span>
							{{ icon({
								iconName: 'accordion-arrow',
								className: 'class-accordions__btn-icon',
								attr: 'viewBox="0 0 16 16" width="16" height="16"'
							}) }}
						</button>
						<div class="class-accordions__content" data-accordion-content>
							<div class="class-accordions__inner">
								<p class="p3 c-gray-dark">Справка должна подтверждать, что вы&nbsp;не&nbsp;имеете противопоказаний для занятий альпинизмом, быть заверена врачом и&nbsp;печатью поликлиники или диспансера. В&nbsp;справке должно быть указано: &laquo;Допущен(-а) к&nbsp;занятиям альпинизмом. Противопоказаний к&nbsp;нахождению в&nbsp;условиях высокогорья (среднегорья) не&nbsp;выявлено&raquo;. Справка обязательна.</p>
							</div>
						</div>
					</li>
				{% endfor %}
			</ul>
			<a href="#" class="class__link _question h7 c-gray-dark ttu" data-popup-opener="question-form">
				Задать вопрос
				{{ icon({
					iconName: 'promo-arrow',
					className: 'class__link-icon',
					attr: 'width="16" height="16" viewBox="0 0 72 72"'
				}) }}
			</a>
		</div>
		<div data-validate>
			<form id="appointment-form" action="/">
				<div class="class__block">
