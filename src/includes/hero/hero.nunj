{% from "../components/picture/picture.nunj" import picture %}

<section class="page__hero hero" data-parallax>
	<div class="hero__bg-img-wrapper">
		{{ picture({
			className: 'hero__bg-img _hero',
			path: 'assets/images/hero-shop/hero-shop',
			ext: 'jpg',
			width: 1728,
			height: 720,
			attr: 'aria-hidden="true"'
		}) }}
		{{ picture({
			className: 'hero__bg-img _equipment',
			path: 'assets/images/hero-shop/equipment',
			ext: 'jpg',
			width: 1728,
			height: 720,
			attr: 'aria-hidden="true" loading="lazy"'
		}) }}
	</div>
	<div class="hero__container container">
		<h1 class="hero__title ttu tac">
			<span class="hero__title-root h7"><a class="hero__title-link" href="/">Магазин</a> <span class="hero__title-separator">/</span></span>
			<span class="hero__title-category h4">Магазин</span>
		</h1>
	{% include "../quick-filter/quick-filter.nunj" %}
	</div>
</section>
