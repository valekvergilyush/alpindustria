{% from "../components/primary-accordion/primary-accordion.nunj" import primaryAccordion %}
{% from "../components/rent-product-item/rent-product-item.nunj" import rentProductItem %}
{% from "../components/tooltip/tooltip.nunj" import tooltip %}

{% set categories = [
	{ label: 'Карематы', opened: true },
	{ label: 'Палатки' },
	{ label: 'Горелки' },
	{ label: 'Обувь' }
] %}

{% set productItems = [
	{ title: 'РЮКЗАК KOHLA ALPINIST GUIDE 28L ALL WEATHER JKT', image: '/assets/images/catalog/item-1.png', imageSrcset: '/assets/images/catalog/item-1@2x.png 2x' },
	{ title: 'РЮКЗАК KOHLA ALPINIST GUIDE 28L ALL WEATHER JKT', image: '/assets/images/catalog/item-2.png', imageSrcset: '/assets/images/catalog/item-2@2x.png 2x' }
] %}
<div class="rent-products-important">
	<div class="container _mt">
		<h1 class="h5 ttu rent-products-important__title">Важно</h1>
		<p class="p1 rent-products-important__text">
			Пожалуйста, перед поездкой в прокат позвоните в магазин и уточните наличие нужного снаряжения, а ещё лучше заранее забронируйте нужную экипировку на сроки своей поездки. А если в прокате, на ваш взгляд, чего-то не хватает, мы всегда открыты для пожеланий и предложений. Списки снаряжения и цены актуальны для сезона 2023-2024
		</p>
	</div>
</div>
<div class="rent-products-content">
	{% for category in categories %}
		{% call primaryAccordion({ headerText: category.label, opened: category.opened }) %}
			<div class="rent-products-content__table-header">
				<div class="rent-products-content__header-left"></div>
				<div class="rent-products-content__header-right">
					<div class="rent-products-content__header-col _period p3">
                Количество 
                <span>дней
						{{ tooltip({
							className: 'rent-products-content__header-tooltip',
							text: 'Указаны минимальные периоды аренды'
						}) }}
                </span>
                </div>
					<div class="rent-products-content__header-col _price p3">
                Стоимость
                {{ tooltip({
							className: 'rent-products-content__header-tooltip',
							text: 'Стоимость указана за выбранный период аренды'
						}) }}
                </div>
					<div class="rent-products-content__header-col _deposit p3">Залог**</div>
				</div>
			</div>
			<div class="rent-products-content__list">
				{% for product in productItems %}
					{{ rentProductItem(product) }}
				{% endfor %}
			</div>
		{% endcall %}
	{% endfor %}
</div>
