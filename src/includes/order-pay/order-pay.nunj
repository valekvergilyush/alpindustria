{% from "../components/radio/radio.nunj" import radio %}
{% from "../components/switch/switch.nunj" import switch %}

<div class="cart__block _hidden _last order-pay" id="cart-pay">
	<div class="cart__title-wrap">
		<p class="cart__block-title ttu h6">05. Оплата</p>
	</div>
	<div class="cart__inner">
		<ul class="order-pay__list">
			<li class="order-pay__item">
				{{ radio({
					id: 'cart-pay-card',
					name: 'cart-pay-radio',
					value: 'bank-card',
					label: 'Оплата картой',
					checked: true
				}) }}
				{{ icon({
					iconName: "credit-card",
					attr: 'width="32" height="32"'
				}) }}
			</li>
			<div class="order-pay__item">
				{{ radio({
					id: 'cart-pay-home',
					name: 'cart-pay-radio',
					value: 'home',
					label: 'Оплата при получении'
				}) }}
				{{ icon({
					iconName: "home",
					attr: 'width="32" height="32"'
				}) }}
			</div>
		</ul>

		<div class="order-pay__cert p3 c-gray-dark hidden">
			<span id="order-pay-cert">
				Подарочный сертификат:<br>
				<span class="order-pay__cert-value h6 c-blue-dark">5 000 ₽</span>
			</span>
			{{ switch({
				className: 'order-pay__toggle-switch _rounded _xs',
				name: 'pay-width-certificate',
				value: 'pay-width-certificate',
				attr: 'aria-labelledby="order-pay-cert"'
			}) }}
		</div>

		<button class="order-pay__cert-button p2" data-modal-opener="add-certificate">
			<span class="order-pay__cert-button-top"></span>
			<span class="order-pay__cert-button-bottom"></span>
			Добавить сертификат
			{{ icon({
				iconName: "plus-circle-blue",
				attr: 'width="24" height="24"'
			}) }}
		</button>

		<a class="order-pay__offer-link" href="#" data-popup-opener="offer">Нажимая "оплатить", вы соглашаетесь с условиями оферты</a>
	</div>

	{% include "../cart-bill/cart-bill-pay.nunj" %}

	<button class="cart__next-button _submit" type="button">
		<span class="h7">Оплатить картой</span>
		{{ icon({
			iconName: "credit-card",
			attr: 'width="32" height="32"'
		}) }}
	</button>
	<button class="cart__next-button _submit hidden" type="button">
		<span class="h7">Оплатить при получении</span>
		{{ icon({
			iconName: "home",
			attr: 'width="32" height="32"'
		}) }}
	</button>
	<button class="cart__next-button _submit hidden" type="button">
		<span class="h7">Оплатить</span>
	</button>
</div>
