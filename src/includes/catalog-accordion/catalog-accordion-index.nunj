{% set linkList = [
	{ text: 'Магазин', url: '/catalog/' },
	{ text: 'Сообщество', url: '/community/' },
	{ text: 'Адреса', url: '/addresses.html' },
	{ text: 'Услуги', url: '/services.html' },
	{ text: 'Новости', url: '/news.html' },
	{ text: 'О нас', url: '/about.html' }
] %}

<div class="catalog-accordion _index">
	{% for item in linkList %}
		<a class="catalog-accordion__section" href="{{ item.url }}"  data-accordion-section>
			<span class="catalog-accordion__title h3 ttu" data-accordion-title><span class="catalog-accordion__title-text" data-accordion-title-text>{{ item.text }}</span></span>
		</a>
	{% endfor %}
</div>
