<section class="hero-trails">
	<ul class="hero-trails__list" style="--total: 3;" data-vaccordion>
		<li class="hero-trails__item _active" style="--i:0; --color: var(--color-green)" data-vaccordion-item></li>
		<li class="hero-trails__item" style="--i:1; --color: var(--color-gold)" data-vaccordion-item></li>
		<li class="hero-trails__item" style="--i:2; --color: var(--color-purple)" data-vaccordion-item></li>
	</ul>
</section>
