{% set trails = [
	{
		title: 'Alpindustria Elbrus Race',
		dates: '05.08.2022 – 07.08.2022',
		img: '/assets/images/community/trails/hero-trails',
		className: '_active'
	},
	{
		title: 'Elbrus<br> Race',
		dates: '05.08.2022 – 07.08.2022',
		img: '/assets/images/community/trails/hero-trails'
	},
	{
		title: 'Elbrus<br> Race',
		dates: '05.08.2022 – 07.08.2022',
		img: '/assets/images/community/trails/hero-trails'
	}
] %}

<section class="hero-trails">
	<ul class="hero-trails__list" style="--total: {{ trails.length }};--closed: {{ trails.length - 1 }};" data-vaccordion>
		{% for trail in trails %}
			<li class="hero-trails__item{% if trail.className %} {{ trail.className }}{% endif %}" style="--i:{{ loop.index0 }}" data-vaccordion-item>
				<div class="hero-trails__info">
					<h2 class="hero-trails__title h3 ttu">{{ trail.title }}</h2>
					<p class="hero-trails__dates s2">{{ trail.dates }}</p>
				</div>
				{% if trail.img %}
					<img class="hero-trails__bg-img" src="{{ trail.img }}.jpg" srcset="{{ trail.img }}@2x.jpg 2x" width="1289" height="900" alt="">
				{% endif %}
			</li>
		{% endfor %}
	</ul>
</section>
