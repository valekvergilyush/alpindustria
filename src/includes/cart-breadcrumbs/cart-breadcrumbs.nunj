{% set linkList = [
	{
		name: 'Контактные данные',
		href: '#cart-contacts'
	},
	{
		name: 'Способ доставки',
		href: '#cart-delivery'
	},
	{
		name: 'Дисконтная карта',
		href: '#cart-discount'
	},
	{
		name: 'Информирование по заказу',
		href: '#cart-info'
	},
	{
		name: 'Оплата',
		href: '#cart-pay'
	}
] %}

<ol class="cart-breadcrumbs cart__breadcrumbs">
	{% for item in linkList %}
		<li class="cart-breadcrumbs__item">
			<a href="{{ item.href }}" class="cart-breadcrumbs__link" data-cart-breadcrumb>{{ item.name }}</a>
		</li>
	{% endfor %}
</ol>
