{% from "../components/wishlist-item/wishlist-item.nunj" import wishlistItem %}
{% from "../components/button/button.nunj" import button %}
{% from "../components/input/input.nunj" import input %}

{% set whishlistList = [
	{
		name: 'Новый вишлист',
		year: '2022',
		number: '16 товаров'
	},
	{
		name: 'Восхождение на&nbsp;эльбрус',
		year: '2022',
		number: '16 товаров',
		imgs: [
			'/assets/images/catalog/item-3'
		]
	},
	{
		name: 'Восхождение на&nbsp;эльбрус',
		year: '2022',
		number: '16 товаров',
		imgs: [
			'/assets/images/catalog/item-3',
			'/assets/images/catalog/item-1'
		]
	},
	{
		name: 'Восхождение на&nbsp;эльбрус',
		year: '2022',
		number: '16 товаров',
		imgs: [
			'/assets/images/catalog/item-3',
			'/assets/images/catalog/item-1',
			'/assets/images/catalog/item-2'
		]
	},
	{
		name: 'Восхождение на&nbsp;эльбрус',
		year: '2022',
		number: '16 товаров',
		imgs: [
			'/assets/images/catalog/item-3',
			'/assets/images/catalog/item-1',
			'/assets/images/catalog/item-2',
			'/assets/images/catalog/item-4'
		]
	}
] %}

<div class="whishlist-popup">
	<h2 class="whishlist-popup__title h5 ttu">Новый вишлист</h2>
	<div class="whishlist-popup__form" data-validate data-wishlist-form>
		<form>
			{{ input({
				type: 'text',
				id: 'wishlist-name',
				className: 'whishlist-popup__input',
				name: 'Название',
				inputAttr: 'data-wishlist-input maxlength="25"',
				attr: 'data-validate-type="text" ',
				wordCounter: 25
			}) }}
			<div class="whishlist-popup__form-btns">
				<button type="button" class="button h7 ttu whishlist-popup__cancel" data-wishlist-cancel data-popup-closer>Отмена</button>
				{{ button({
					className: 'h7 ttu _arrow-s whishlist-popup__submit',
					text: 'Создать',
					icon: 'promo-arrow',
					type: 'submit',
					iconData: 'width="16" height="16" viewBox="0 0 72 72"'
				}) }}
			</div>
		</form>
	</div>
	<div class="whishlist-popup__list">
		{% for item in whishlistList %}
			{{ wishlistItem({
				data: item,
				className: 'whishlist-popup__item'
			}) }}
		{% endfor %}
	</div>
</div>
