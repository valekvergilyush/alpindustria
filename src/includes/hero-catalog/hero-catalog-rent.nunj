{% from "../components/picture/picture.nunj" import picture %}

<section class="page__hero hero-catalog _rent _subcategory" data-parallax>
	<div class="hero-catalog__bg-img-wrapper">
		{{ picture({
			className: 'hero-catalog__bg-img _hero',
			path: '/assets/images/hero-services/hero-services',
			ext: 'jpg',
			width: 1728,
			height: 720,
			attr: 'aria-hidden="true"'
		}) }}
		<div class="hero-catalog__bg-img _services-equipment _inner">
			<img src="/assets/images/hero-services/equipment.jpg" srcset="/assets/images/hero-services/equipment@2x.jpg 2x" width="1728" height="720" alt="" aria-hidden="true">
		</div>
	</div>
	<div class="hero-catalog__container container">
		<h1 class="hero-catalog__title ttu tac">
			<span class="hero-catalog__title-root h7">
				<span>Cанкт-петербург</span>
			</span>
			<span class="hero-catalog__title-category h4">Прокат</span>
		</h1>
		{% include "../quick-filter/quick-filter-services.nunj" %}
	</div>
</section>
