{% from "../components/picture/picture.nunj" import picture %}

<section class="page__hero hero-catalog" data-parallax>
	<div class="hero-catalog__bg-img-wrapper">
		{{ picture({
			className: 'hero-catalog__bg-img _hero',
			path: '/assets/images/hero-shop/hero-shop',
			ext: 'jpg',
			width: 1728,
			height: 720,
			attr: 'aria-hidden="true"'
		}) }}
		{{ picture({
			className: 'hero-catalog__bg-img _equipment',
			path: '/assets/images/hero-shop/equipment',
			ext: 'jpg',
			width: 1728,
			height: 720,
			attr: 'aria-hidden="true" loading="lazy"'
		}) }}
		{{ picture({
			className: 'hero-catalog__bg-img _tents',
			path: '/assets/images/hero-shop/equipment',
			ext: 'jpg',
			width: 1728,
			height: 720,
			attr: 'aria-hidden="true" loading="lazy"'
		}) }}
	</div>
	<div class="hero-catalog__container container">
		<h1 class="hero-catalog__title ttu tac">
			<span class="hero-catalog__title-root h7">
				<a class="hero-catalog__title-link" href="/catalog/">Магазин</a>
				<span class="hero-catalog__title-separator">/</span>
				<a class="hero-catalog__title-link" data-subtitle></a>
			</span>
			<span class="hero-catalog__title-category h4">Магазин</span>
		</h1>
	{% include "../quick-filter/quick-filter.nunj" %}
	</div>
</section>
