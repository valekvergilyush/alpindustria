{% from "../components/picture/picture.nunj" import picture %}

<section class="page__hero hero-catalog _rent" data-parallax>
	<div class="hero-catalog__bg-img-wrapper">
		{{ picture({
			className: 'hero-catalog__bg-img _hero',
			path: '/assets/images/hero-services/hero-services',
			ext: 'jpg',
			width: 1728,
			height: 720,
			attr: 'aria-hidden="true"'
		}) }}
	</div>
	<div class="hero-catalog__container container">
		<h1 class="hero-catalog__title ttu tac">
			<span class="hero-catalog__title-category h4">Прокат</span>
		</h1>
		{% include "../quick-filter/quick-filter-rent.nunj" %}
	</div>
</section>
