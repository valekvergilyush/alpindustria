{% from "../components/icon/icon.nunj" import icon %}
{% from "../components/button/button.nunj" import button %}
{% from "../components/cart-item/cart-item.nunj" import cartItem %}

{% set cartList = [
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽',
		srcImg: '/assets/images/cart/item-1.png',
		srcsetImg: '/assets/images/cart/item-1@2x.png 2x',
		btns: true
	},
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽',
		srcImg: '/assets/images/cart/item-2.png',
		srcsetImg: '/assets/images/cart/item-2@2x.png 2x',
		btns: true,
		longDelivery: true
	},
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽',
		srcImg: '/assets/images/cart/item-3.png',
		srcsetImg: '/assets/images/cart/item-3@2x.png 2x',
		btns: true
	},
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽',
		srcImg: '/assets/images/cart/item-1.png',
		srcsetImg: '/assets/images/cart/item-1@2x.png 2x',
		btns: true
	},
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽',
		srcImg: '/assets/images/cart/item-2.png',
		srcsetImg: '/assets/images/cart/item-2@2x.png 2x',
		btns: true,
		longDelivery: true
	},
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽',
		srcImg: '/assets/images/cart/item-3.png',
		srcsetImg: '/assets/images/cart/item-3@2x.png 2x',
		btns: true
	}
] %}

<div class="wishlist-lists">
	<div class="container">
		<div class="wishlist-lists__wrap">
			<ul class="wishlist-lists__filter">
				<li>
					{{ button({
						className: '_quick-filter _active h7 ttu',
						text: 'Все товары'
					}) }}
				</li>
				<li>
					{{ button({
						className: '_quick-filter h7 ttu',
						text: 'Товары в наличии'
					}) }}
				</li>
				<li>
					{{ button({
						className: '_quick-filter h7 ttu',
						text: 'Купленные товары'
					}) }}
				</li>
			</ul>
			<div class="wishlist-lists__block">
				<div class="wishlist-lists__top">
					<div class="wishlist-lists__text">
						<p class="p3 wishlist-lists__small">Всего:</p>
						<p class="s2 wishlist-lists__number">6 товаров</p>
					</div>
				</div>
				<ul class="wishlist-lists__list">
					{% for item in cartList %}
						<li class="wishlist-lists__item">{{ cartItem(item) }}</li>
					{% endfor %}
				</ul>

				<div class="wishlist-lists__footer">
					<div class="wishlist-lists__footer-text p2">
						{{ icon({
							iconName: 'heart',
							className: 'wishlist-lists__footer-icon',
							attr: 'width="32" height="32"'
						}) }}
						<p>
							Вы&nbsp;можете добавить еще товары из&nbsp;каталога
						</p>
					</div>
					{{ button({
						className: 'h7 ttu _arrow-s wishlist-lists__footer-link',
						href: '/catalog',
						text: 'Перейти в&nbsp;каталог',
						icon: 'promo-arrow',
						iconData: 'width="16" height="16" viewBox="0 0 72 72"'
					}) }}
				</div>
			</div>
		</div>
	</div>
</div>
