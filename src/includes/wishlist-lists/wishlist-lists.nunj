{% from "../components/button/button.nunj" import button %}
{% from "../components/cart-item/cart-item.nunj" import cartItem %}

{% set cartList = [
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽',
		srcImg: 'assets/images/cart/item-1.jpg',
		srcsetImg: 'assets/images/cart/item-1@2x.jpg 2x'
	},
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽',
		srcImg: 'assets/images/cart/item-2.jpg',
		srcsetImg: 'assets/images/cart/item-2@2x.jpg 2x'
	},
	{
		title: 'Куртка The North Face M Dryzzle All Weather Jkt',
		price: '33 150 ₽',
		srcImg: 'assets/images/cart/item-3.jpg',
		srcsetImg: 'assets/images/cart/item-3@2x.jpg 2x'
	}
] %}

<div class="wishlist-lists">
	<div class="container">
		<div class="wishlist-lists__wrap">
			<div class="wishlist-lists__block">
				<div class="wishlist-lists__top">
					<div class="wishlist-lists__text">
						<p class="p3">Всего:</p>
						<p class="s2">16 товаров</p>
					</div>
					{{ button({
						className: 'wishlist-lists__add h7 ttu',
						icon: 'cart-2',
						text: 'добавить все<span class="desktop"> в корзину</span>',
						iconData: 'width="32" height="32" viewBox="0 0 32 32"'
					}) }}
				</div>
				<ul class="wishlist-lists__list">
					{% for item in cartList %}
						<li class="wishlist-lists__item">{{ cartItem(item) }}</li>
					{% endfor %}
				</ul>
			</div>
			<div class="wishlist-lists__block">
				<div class="wishlist-lists__top">
					<div class="wishlist-lists__text">
						<p class="p3">Купленные товары:</p>
					</div>
				</div>
				<ul class="wishlist-lists__list">
					{% for item in cartList %}
						<li class="wishlist-lists__item">{{ cartItem(item) }}</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>
