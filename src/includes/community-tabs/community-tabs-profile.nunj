{% from "../components/icon/icon.nunj" import icon %}

{% set tabsList = [
	{ id: 'data', text: 'Мои данные' },
	{ id: 'payments', text: 'Мои покупки' },
	{ id: 'discount', text: 'Дисконтная карта', active: true  },
	{ id: 'subscription', text: 'Рассылка' },
	{ id: 'messages', text: 'Сообщения'}
] %}

<section class="community-tabs _profile" data-community-tab>
	<ul class="community-tabs__tabs">
		{% for tab in tabsList %}
			<li class="community-tabs__tabs-item">
				<button class="community-tabs__tabs-btn{% if tab.className %} {{tab.className}}{% endif %} {% if tab.active %}_active{% endif %} h6 ttu" id="{{ tab.id }}" type="button" data-tab-btn>
					{{ tab.text }}
					{{ icon({
						iconName: 'double-arrow-right',
						attr: 'width="48" height="48"'
					}) }}
				</button>
			</li>
		{% endfor %}
		<li class="community-tabs__tabs-item">
			<a class="community-tabs__tabs-btn _logout h6 ttu" href="#">Выйти</a>
		</li>
	</ul>

	<div class="community-tabs__sections">
		<section class="community-tabs__section _profile" aria-labelledby="data" data-tab-section="data">
			{% include "../personal-data/personal-data.nunj" %}
		</section>
		<section class="community-tabs__section _profile" aria-labelledby="payments" data-tab-section="payments">
			{% include "../profile-purchases/profile-purchases.nunj" %}
		</section>
		<section class="community-tabs__section _profile" aria-labelledby="subscription" data-tab-section="subscription">
			{% include "../profile-subscribtion/profile-subscribtion.nunj" %}
		</section>
		<section class="community-tabs__section _profile" aria-labelledby="messages" data-tab-section="messages">
			{% include "../profile-messages/profile-messages.nunj" %}
		</section>
		<section class="community-tabs__section _profile _active" aria-labelledby="discount" data-tab-section="discount">
			{% include "../profile-discount/profile-discount.nunj" %}
		</section>
	</div>
</section>
