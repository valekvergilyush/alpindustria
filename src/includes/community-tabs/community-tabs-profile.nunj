{% from "../components/icon/icon.nunj" import icon %}

{% set tabsList = [
	{ id: 'data', text: 'Мои данные', active: true },
	{ id: 'payments', text: 'Мои покупки' },
	{ id: 'discount', text: 'Дисконтная карта' },
	{ id: 'subscription', text: 'Рассылка' },
	{ id: 'messages', text: 'Сообщения' },
	{ id: 'logout', text: 'Выйти' }
] %}

<section class="community-tabs" data-community-tab>
	<ul class="community-tabs__tabs">
		{% for tab in tabsList %}
			<li class="community-tabs__tabs-item">
				<button class="community-tabs__tabs-btn{% if tab.active %} _active{% endif %} h5 ttu" id="{{ tab.id }}" type="button" data-tab-btn>
					{{ tab.text }}
					{{ icon({
						iconName: 'double-arrow-right',
						attr: 'width="48" height="48"'
					}) }}
				</button>
			</li>
		{% endfor %}
	</ul>

	<div class="community-tabs__sections">
		<section class="community-tabs__section _profile _active" aria-labelledby="data" data-tab-section="data">
			{% include "../personal-data/personal-data.nunj" %}
		</section>
		<section class="community-tabs__section _profile" aria-labelledby="payments" data-tab-section="payments">
			{% include "../community-contacts/community-contacts.nunj" %}
		</section>
	</div>
</section>
