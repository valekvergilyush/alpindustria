{% set advantagesList = [
	{ text: '25 магазинов профессионального снаряжения по России', img: '#' },
	{ text: 'Экипировка и&nbsp;одежда мировых спортивных брендов', img: '#' },
	{ text: 'Обучение альпинизму с&nbsp;опытными инструкторами в&nbsp;Горном клубе', img: '#' },
	{ text: 'Скидки до&nbsp;30% для постоянных клиентов', img: '#' }
] %}

<section class="page__advantages advantages">
	<p class="advantages__title ttu">АльпИндустрия &mdash; это</p>
	{% if advantagesList %}
		<ul class="advantages__list">
			{% for advantage in advantagesList %}
				<li class="advantages__item ttu">
					{{ advantage.text }}
					<div class="advantages__img-wrapper"><img class="advantages__img" src="{{ advantage.img }}" alt=""></div>
				</li>
			{% endfor %}
		</ul>
	{% endif %}
</section>
