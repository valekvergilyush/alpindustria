{% from "../components/button/button.nunj" import button %}

<section class="cart _empty">
	<h2 class="cart__title h5 ttu">Корзина</h2>

	{% include '../cart-tabs/cart-tabs-empty.nunj' %}

	<div class="cart__cart-list" data-cart-list>
		<div class="cart__title-wrapper">
			{{ button({
				icon: 'double-arrow-left',
				iconData: 'width="32" height="32"',
				className: 'cart__back-btn',
				attr: 'aria-label="Назад" data-cart-back'
			}) }}
			<h2 class="cart__title _cart h5 ttu">Корзина</h2>
		</div>

		{% include '../cart-list/cart-list.nunj' %}
		{% include '../cart-list/cart-list-readonly.nunj' %}

		<p class="cart__price _secondary p3">
			Стоимость товаров:<br>
			<span class="cart__price-value">145 000 руб.</span>
		</p>
	</div>

	<div class="cart__delivery" data-flatpickr-scroll="close">
		<div class="cart__title-wrapper _delivery">
			{{ button({
				icon: 'double-arrow-left',
				iconData: 'width="32" height="32"',
				className: 'cart__back-btn',
				attr: 'aria-label="Назад" data-cart-back="delivery"'
			}) }}
			<h2 class="cart__title _delivery h5 ttu">Доставка</h2>
		</div>

		{% include '../cart-delivery/cart-delivery.nunj' %}
		{% include '../cart-delivery/cart-delivery-total.nunj' %}

		<div class="cart-bottom">
			<p class="cart__price _white p3">
				Итого с учетом доставки:<br>
				<span class="cart__price-value h5 ttu">145 000 ₽</span>
			</p>
			{{ button({
				type: 'submit',
				text: 'Оформить',
				icon: 'promo-arrow',
				iconData: 'width="18" height="18"',
				className: 'cart__submit _arrow',
				attr: 'data-cart-pay'
			}) }}
		</div>
	</div>

	<div class="cart__pay">
		<div class="cart__title-wrapper">
			{{ button({
				icon: 'double-arrow-left',
				iconData: 'width="32" height="32"',
				className: 'cart__back-btn',
				attr: 'aria-label="Назад" data-cart-back="delivery"'
			}) }}
			<h2 class="cart__title _pay h5 ttu">Оплата</h2>
		</div>

		{% include '../cart-pay/cart-pay.nunj' %}

		<div class="cart-bottom">
			<p class="cart__price _white p3">
				Итого с учетом доставки:<br>
				<span class="cart__price-value h5 ttu">145 000 ₽</span>
			</p>
			{{ button({
				type: 'submit',
				text: 'Оплатить',
				icon: 'promo-arrow',
				iconData: 'width="18" height="18"',
				className: 'cart__submit _arrow',
				attr: 'data-cart-pay'
			}) }}
		</div>
	</div>
</section>
