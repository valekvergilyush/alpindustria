{% from "../components/button/button.nunj" import button %}

{% set tabs = [
	{ id: 'shop', name: 'Магазин', isSelected: true, tabindex: '0' },
	{ id: 'rental', name: 'Прокат', tabindex: '-1' }
]
%}

<section class="cart">
	<h2 class="cart__title h5 ttu">Корзина</h2>
	<div class="cart__tabs tabs" data-tabs>
		<ul class="tabs__tab-list" role="tablist">
			{% for item in tabs %}
				<li class="tabs__tab-item">
					<button class="tabs__trigger{% if item.isSelected %} _selected{% endif %}" id="{{ item.id }}" role="tab" type="button" data-tab-trigger aria-selected="true" tabindex="{{ item.tabindex }}">
						{{ item.name }}
					</button>
				</li>
			{% endfor %}
		</ul>
		<section class="cart__section _shop tabs__panel" aria-labelledby="shop" role="tabpanel" data-tab-panel aria-hidden="false" tabindex="0">
			{% include '../cart-list/cart-list.nunj' %}
			<div class="cart__shop-bottom">
				<p class="cart__price p3">
					Итого без учета доставки:<br>
					<span class="cart__price-value h5 ttu">145 000 ₽</span>
				</p>
				{{ button({
					type: 'submit',
					text: 'Отправить',
					icon: 'promo-arrow',
					iconData: 'width="18" height="18"',
					className: 'cart__submit _arrow'
				}) }}
			</div>
		</section>
		<section class="tabs__panel" aria-labelledby="rental" role="tabpanel" data-tab-panel aria-hidden="false" tabindex="-1">
			Rental
		</section>
	</div>
</section>
