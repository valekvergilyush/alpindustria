{% from "../components/button/button.nunj" import button %}

{% set tabs = [
	{ id: 'shop', name: 'Магазин', isSelected: true, tabindex: '0' },
	{ id: 'rental', name: 'Прокат', tabindex: '-1' }
]
%}

<section class="cart">
	<div class="cart__title-wrapper _cart">
		{{ button({
			icon: 'double-arrow-left',
			iconData: 'width="32" height="32"',
			className: 'cart__back-btn',
			attr: 'aria-label="Назад" data-cart-back'
		}) }}
		<h2 class="cart__title h5 ttu">Корзина</h2>
	</div>

	{% include '../cart-tabs/cart-tabs.nunj' %}

	<div class="cart__cart-list" data-cart-list>
		{% include '../cart-list/cart-list.nunj' %}

		<p class="cart__price _secondary p3">
			Стоимость товаров:<br>
			<span class="cart__price-value">145 000 руб.</span>
		</p>
	</div>

	<div class="cart__delivery">
		<div class="cart__title-wrapper _delivery">
			<h2 class="cart__title h5 ttu">Доставка</h2>
		</div>

		{% include '../cart-delivery/cart-delivery.nunj' %}

		<div class="cart-bottom">
			<p class="cart__price _white p3">
				Итого с учетом доставки:<br>
				<span class="cart__price-value h5 ttu">145 000 ₽</span>
			</p>
			{{ button({
				type: 'submit',
				text: 'Оформить',
				icon: 'promo-arrow',
				iconData: 'width="18" height="18"',
				className: 'cart__submit _arrow',
				attr: 'data-cart-delivery-submit'
			}) }}
		</div>
	</div>

</section>
