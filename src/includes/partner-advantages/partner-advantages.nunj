{% set list = [
	'Вы&nbsp;готовы вести бизнес на&nbsp;месте',
	'Вы&nbsp;хорошо знаете регион и&nbsp;его особенности',
	'Вы&nbsp;влюблены в&nbsp;горы и&nbsp;хотите популяризировать активный отдых'
] %}

<section class="partner-advantages" data-partner-advantages>
	<div class="partner-advantages__container container">
		<div class="partner-advantages__title-wrapper">
			<h2 class="partner-advantages__title h4 ttu" data-animation="words">
				Мы&nbsp;точно сработаемся, если:
			</h2>
		</div>
		<div class="partner-advantages__wrapper">
			<ul class="partner-advantages__list s2">
				{% for item in list %}
					<li class="partner-advantages__item">
						<p class="partner-advantages__item-text" data-animation="fade-right">{{ item }}</p>
					</li>
				{% endfor %}
			</ul>
			<p class="partner-advantages__text p2" data-animation="fade-right">
				<span class="partner-advantages__asterisk h5 ttu">***</span><br>
				Остальное мы&nbsp;берем на&nbsp;себя!
			</p>
			<a class="partner-advantages__link ttu" href="#" data-animation="fade-right">
				Подать заявку
			</a>
		</div>
	</div>
</section>
