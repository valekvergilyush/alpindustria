{% from "../components/icon/icon.nunj" import icon %}
{% from "../components/button/button.nunj" import button %}

<div class="page__filters filters">
	<div class="filters__container container">
		<div class="filters__left">
			<button class="filters__button _filter ttu" type="button" aria-labelledby="filter-button-label" data-filters-toggle>
				<span id="filter-button-label">Фильтры</span>
				{{ icon({
					iconName: 'filter',
					className: 'filters__button-icon _filter',
					attr: 'width="32" height="32"'
				}) }}
				{{ icon({
					iconName: 'close-filter',
					className: 'filters__button-icon _close',
					attr: 'width="32" height="32"'
				}) }}
				<span class="filters__button-number p4">4</span>
			</button>
		</div>
		<p class="filters__items-number p2">242 товара</p>
		<div class="filters__layout">
			<p class="p2" id="layout-label">Сетка</p>
			<div class="filters__layout-buttons" aria-labelledby="layout-label">
				{{ button({
					className: 'filters__layout-button _layout _mobile',
					attr: 'data-cols="2" aria-label="2"',
					icon: 'grid'
				}) }}
				{{ button({
					className: 'filters__layout-button _layout _mobile',
					attr: 'data-cols="1" aria-label="1"',
					icon: 'rows'
				}) }}
				{{ button({
					text: '2',
					className: 'filters__layout-button _layout',
					attr: 'data-cols="2"'
				}) }}
				{{ button({
					text: '3',
					className: 'filters__layout-button _layout',
					attr: 'data-cols="3"'
				}) }}
				{{ button({
					text: '4',
					className: 'filters__layout-button _layout _active',
					attr: 'data-cols="4"'
				}) }}
			</div>
		</div>
	</div>
</div>
