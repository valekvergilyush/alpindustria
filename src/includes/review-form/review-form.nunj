{% from "../components/input/input.nunj" import input %}
{% from "../components/textarea/textarea.nunj" import textarea %}
{% from "../components/input-rating/input-rating.nunj" import inputRating %}
{% from "../components/button/button.nunj" import button %}
{% from "../components/checkbox/checkbox-button.nunj" import checkboxButton %}

{% set hobbies = [
	'Альпинизм',
	'Скалолазание',
	'Трейлраннинг',
	'Горный туризм',
	'Cкандинавская ходьба',
	'Мультиспорт',
	'Ориентирование',
	'Хели-ски',
	'фрирайд',
	'Ски-тур',
	'Кайтсерфинг/Виндсерфинг',
	'Бег',
	'Парашютный спорт',
	'Ледолазание',
	'Водные походы',
	'Дайвинг',
	'Сноуборд',
	'Спелеология',
	'Треккинг',
	'Каякинг',
	'Боулдеринг',
	'Пеший туризм',
	'Парапланеризм',
	'Горные лыжи'
] %}

<section class="review-form" data-validate>
	<h2 class="review-form__title h5 ttu">Добавить отзыв</h2>
	<form class="review-form__form" data-review-form>
		<div class="review-form__fields">
			{{ input({
				type: 'text',
				id: 'review-author-name',
				className: 'review-form__input',
				name: 'Имя',
				label: 'Имя*',
				inputAttr: 'required',
				attr: 'data-validate-type="text"'
			}) }}
			{{ input({
				type: 'text',
				id: 'review-author-surname',
				className: 'review-form__input',
				name: 'Фамилия',
				label: 'Фамилия*',
				inputAttr: 'required',
				attr: 'data-validate-type="text"'
			}) }}
		</div>
		{{ input({
			type: 'email',
			id: 'review-author-email',
			className: 'review-form__input',
			name: 'Почта',
			label: 'Почта*',
			inputAttr: 'required',
			attr: 'data-validate-type="email"'
		}) }}
		{{ input({
			type: 'tel',
			id: 'review-author-tel',
			className: 'review-form__input',
			name: 'Телефон',
			label: 'Телефон*',
			inputAttr: 'required',
			attr: 'data-validate-type="phone"'
		}) }}
		{{ textarea({
			id: 'review-author-message',
			className: 'review-form__input _message',
			name: 'Комментарий',
			wordCounter: 500,
			attr: 'data-validate-type="text"'
		}) }}
		<div class="review-form__input _hobbies _message">
			<p class="h6 ttu">Выберите ваши увлечения</p>
			<div class="review-form__btns">
				{% for item in hobbies %}
					{{ checkboxButton({
						className: '_button',
						label: item,
						id: 'hobbies-' + loop.index,
						inputAttr: 'value="hobbies-' + loop.index + '"',
						name: 'hobbies'
					}) }}
				{% endfor %}
			</div>
		</div>
		{{ inputRating({
			className: 'review-form__input _rating',
			labelClassName: 'h6',
			name: 'Ваша оценка',
			min: 1,
			max: 5,
			value: 4,
			attr: 'data-validate-type="toggle-group"'
		}) }}
		<div class="review-form__bottom">
			{{ button({
				type: 'submit',
				text: 'Отправить',
				icon: 'promo-arrow',
				iconData: 'width="18" height="18"',
				className: 'review-form__submit _arrow'
			}) }}
		</div>
	</form>
</section>
