{% from "../components/icon/icon.nunj" import icon %}

<div class="notification__content notification-compare notification-compare-delete-category">
	{{ icon({
		iconName: 'check-green',
		className: 'notification-compare__icon',
		attr: 'width="52" height="52"'
	}) }}
	<div class="notification-compare__content">
		<p class="notification-compare__text p3">Удаление категории «КУРТКИ»</p>
		<a href="/compare.html" class="notification-compare__link h7 ttu">
			Переход в категорию «Лыжи»
		</a>
	</div>
	<a class="notification__button button h7 ttu" href="/compare.html">
		<span class="button__text">Отменить</span>
	</a>
</div>
