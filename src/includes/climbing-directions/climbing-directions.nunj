{% from "../components/icon/icon.nunj" import icon %}

{% set directions = [
	{
		title: 'Скалолазание',
		text: '<p>Скалолазание&nbsp;&mdash; это сочетание спорта, азарта и&nbsp;движения. На&nbsp;скалодроме вы&nbsp;развиваете силу, координацию, выносливость и&nbsp;уверенность в&nbsp;себе, а&nbsp;каждая трасса становится новым вызовом и&nbsp;маленькой победой.</p><p>Наши занятия подходят как для новичков, так и&nbsp;для опытных спортсменов. Под руководством тренеров вы&nbsp;освоите технику лазания, научитесь правильно работать со&nbsp;снаряжением, страховать напарника и&nbsp;сможете постепенно повышать свой уровень.</p><h3><strong>Для кого подойдут занятия:</strong></h3><ul><li>Для детей и&nbsp;подростков</li><li>Для взрослых без подготовки</li><li>Для тех, кто хочет поддерживать форму интересно и&nbsp;активно</li><li>Для любителей экстремального спорта и&nbsp;новых впечатлений</li><li>Для любителей и&nbsp;спортсменов</li><li>Для тех, кто хочет интересно провести время и&nbsp;попробовать что-то новое для себя</li></ul><h3><strong>Что вас ждёт:</strong></h3><ul><li>Современный скалодром с&nbsp;трассами разной сложности</li><li>Профессиональные инструкторы</li><li>Индивидуальные и&nbsp;групповые тренировки</li><li>Безопасное оборудование и&nbsp;снаряжение</li><li>Дружелюбная атмосфера и&nbsp;поддержка сообщества</li></ul><h3><strong>Почему выбирают скалолазание</strong></h3><p>Скалолазание развивает не&nbsp;только тело, но&nbsp;и&nbsp;мышление. Здесь важны концентрация, стратегия и&nbsp;умение принимать решения. Это спорт, который помогает отвлечься от&nbsp;рутины, снять стресс и&nbsp;получить заряд энергии. Первое занятие не&nbsp;требует специальной подготовки&nbsp;&mdash; всё необходимое снаряжение можно взять у&nbsp;нас.</p><p>Попробуйте скалолазание и&nbsp;откройте для себя новый уровень движения!</p><p>На&nbsp;скалодроме регулярно проводятся различные <strong>практические курсы</strong>. Мастер-классы от&nbsp;известных альпинистов и&nbsp;скалолазов, курсы по&nbsp;узлам, страховке, мультипитчу и&nbsp;так далее. А&nbsp;в&nbsp;тёплое время года организовываются выезды на&nbsp;скалы. Но, чтобы туда поехать, нужно сперва подготовиться.</p><p>Следите за&nbsp;анонсами мероприятий в&nbsp;разделе&nbsp;<a href="/school/lessons/">«Лекции и&nbsp;практика»</a>, там вы&nbsp;найдёте много интересного.</p>'
	},
	{
		title: 'Альпинизм',
		text: 'Полноценные альпинистские тренировки в&nbsp;черте города: ледолазание, работа с&nbsp;кошками и&nbsp;ледорубом, прохождение скально-ледовых маршрутов. Идеально для подготовки к&nbsp;восхождениям.'
	},
	{
		title: 'Скалолазание<br>для&nbsp;детей',
		text: 'Группы для детей от&nbsp;6&nbsp;лет. Тренеры с&nbsp;опытом работы с&nbsp;детьми, специальное снаряжение, дружелюбная атмосфера. Запись через администратора.'
	},
	{
		title: 'Гипоксические<br>тренировки',
		text: 'Подготовка к&nbsp;высотным восхождениям с&nbsp;использованием гипоксических масок и&nbsp;палаток. Программа подбирается индивидуально под цели восхождения.'
	},
	{
		title: 'Прокат<br>снаряжения',
		text: 'Скальные туфли, страховочные системы, верёвки, оттяжки, ледовое снаряжение&nbsp;&mdash; всё необходимое можно взять напрокат прямо на&nbsp;скалодроме.'
	},
	{
		title: 'Курсы и&nbsp;мастер-классы',
		text: 'Регулярные курсы по&nbsp;работе с&nbsp;верёвкой, страховке, спасработам и&nbsp;технике прохождения маршрутов. Ведут опытные инструкторы и&nbsp;действующие альпинисты.'
	},
	{
		title: 'Праздники<br>на&nbsp;скалодроме',
		text: 'Дни рождения, корпоративы, тимбилдинги&nbsp;&mdash; организуем активный праздник с&nbsp;инструкторами, играми на&nbsp;стенде и&nbsp;зоной для отдыха.'
	},
	{
		title: 'Выездные тренировки<br>на&nbsp;скалах',
		text: 'Выезды на&nbsp;скальные районы Подмосковья, Крыма, Кавказа и&nbsp;других регионов. Подходящие маршруты для разных уровней подготовки.'
	}
] %}

<section class="climbing-directions page__climbing-directions">
	<h2 class="climbing-directions__title h4 ttu c-blue-light">
		<span class="word-wrapper"><span class="word">Направления</span></span>
	</h2>
	<div class="climbing-directions__body">
		<div class="climbing-directions__media" data-direction-media>
			<img class="climbing-directions__img _active" src="/assets/images/community/climbing/climbing-directions.webp" alt="" aria-hidden="true" data-direction-media-layer>
			<img class="climbing-directions__img" src="/assets/images/community/climbing/climbing-directions.webp" alt="" aria-hidden="true" data-direction-media-layer>
		</div>
		<ul class="climbing-directions__list" data-directions-list>
			{% for item in directions %}
				<li class="climbing-directions__item" data-direction data-direction-image="/assets/images/community/climbing/climbing-directions-{{ (loop.index0 % 4) + 1 }}.webp">
					<button class="climbing-directions__link" type="button" data-direction-open>
						<span class="climbing-directions__link-title h5 ttu c-blue-light">{{ item.title | safe }}</span>
						{{ icon({
							iconName: 'promo-arrow-blue',
							className: 'climbing-directions__link-icon',
							attr: 'width="40" height="40" aria-hidden="true"'
						}) }}
					</button>
					<div class="climbing-directions__panel" aria-hidden="true">
						<h3 class="climbing-directions__panel-title text-stroke _blue-light ttu">{{ item.title | safe }}</h3>
						<div class="climbing-directions__panel-text c-blue-light">{{ item.text | safe }}</div>
						<button class="climbing-directions__close" type="button" data-direction-close aria-label="Закрыть">
							{{ icon({
								iconName: 'close-popup',
								attr: 'width="32" height="32"'
							}) }}
						</button>
					</div>
				</li>
			{% endfor %}
		</ul>
	</div>
</section>
