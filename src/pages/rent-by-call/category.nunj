{% extends "../../templates/index-page.nunj" %}

{% from "../../includes/components/ticker/ticker.nunj" import ticker %}
{% from "../../includes/components/hero-catalog-section/hero-catalog-section.nunj" import heroCatalogSection %}

{% block title %}Прокат | {{ super() }}{% endblock title %}
{% set htmlClassMods = '_catalog' %}
{% set hasBackLink = true %}
{% set backLink = '/rent-by-call' %}
{% block mainContent %}
	<main id="catalog-main" class="page__main">
	{% call heroCatalogSection('Прокат / Москва. Пролетарская', '_rent-by-call _subcategory', '/assets/images/hero-services/hero-services', 'Туристическое снаряжение', '/rent-by-call/') %}
		{% include "../../includes/quick-filter/quick-filter-rent-category.nunj" %}
	{% endcall %}
	{% include "../../includes/rent-products-content/rent-products-content.nunj" %}
	{% set rentAddressNoMargin = true %}
	{% include "../../includes/rent-address/rent-address.nunj" %}
	{% set rentCategoriesLimit = 2 %}
	{% include "../../includes/rent-categories/rent-categories.nunj" %}
	{% include ".../../includes/rent-news/rent-news.nunj" %}
	</main>
{% endblock %}
