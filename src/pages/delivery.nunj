{% extends "../templates/inner-page.nunj" %}

{% from "../includes/components/breadcrumbs/breadcrumbs.nunj" import breadcrumbs %}

{% block title %}Доставка и оплата | {{ super() }}{% endblock title %}
{% set htmlClassMods = '_delivery' %}

{% set breadcrumbsData = {
	list:	[
		{ text: 'Главная', href: '/'},
		{ text: 'Доставка и оплата'}
	],
	link: {
		href: '/',
		text: 'Закрыть'
	}
} %}

{% block mainContent %}
	<main class="page__main _pt _white-bg">
		{{ breadcrumbs(breadcrumbsData) }}
		{% include "../includes/delivery-payment/delivery-payment.nunj" %}
	</main>
{% endblock %}
