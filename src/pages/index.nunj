{% extends "../templates/page.nunj" %}

{% from "../includes/components/ticker/ticker.nunj" import ticker %}

{% block title %}Магазин | {{ super() }}{% endblock title %}
{% set htmlClassMods = '_index' %}

{% block mainContent %}
	<main class="page__main">
		{% include "../includes/hero/hero.nunj" %}
		{% include "../includes/filters/filters.nunj" %}
		{% include "../includes/catalog/catalog.nunj" %}
		{% include "../includes/news-section/news-section.nunj" %}
		{% include "../includes/advantages/advantages.nunj" %}
		{{ ticker({
			className: 'page__ticker',
			text: 'Команда, влюбленная в горы'
		}) }}
		{% include "../includes/catalog-accordion/catalog-accordion.nunj" %}
	</main>
{% endblock %}
